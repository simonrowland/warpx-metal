# Explicit configuration used for the certified reference binaries.
#
# Source this file before running the build scripts:
#   source configs/certified-reference.env
#   ./scripts/00-install-deps.sh
#   ./scripts/01-build-adaptivecpp.sh
#   ./scripts/03-build-amrex.sh
#   ./scripts/05-build-warpx.sh
#   ./scripts/07-build-warpx-cpu.sh
#
# The scripts retain origin/main CPU defaults when this file is not sourced.

_CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export WARPX_BUILD_CONFIG="${_CONFIG_DIR}/certified-reference.env"

export WARPX_METAL_DIMS="1;2;RZ;3"
export WARPX_CPU_MPI="ON"
export WARPX_CPU_PRECISION="DOUBLE"
export WARPX_CPU_PARTICLE_PRECISION="DOUBLE"
export WARPX_CPU_DIMS="2;3"
export WARPX_CPU_CXX="${WARPX_CPU_CXX:-$(command -v mpicxx || true)}"
export WARPX_CPU_CC="${WARPX_CPU_CC:-$(command -v mpicc || true)}"

# Keep the certified builds within the owner CPU policy by default.
export NPROC="${NPROC:-6}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-6}"

unset _CONFIG_DIR

# Certified WarpX configuration with ADIOS2/BP openPMD output enabled.
# Source this file before running the build scripts.

_CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${_CONFIG_DIR}/certified-reference.env"

export WARPX_BUILD_CONFIG="${_CONFIG_DIR}/certified-openpmd-bp.env"
export WARPX_OPENPMD_BP=ON
export ADIOS2_DIR="${ADIOS2_DIR:-$(brew --prefix adios2)/lib/cmake/adios2}"

unset _CONFIG_DIR

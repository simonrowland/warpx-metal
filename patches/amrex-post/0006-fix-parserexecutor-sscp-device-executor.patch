+        __acpp_if_target_device(return static_cast<float>(parser_exe_eval(m_device_executor, l_var.data()));)
+        __acpp_if_target_host(return static_cast<float>(parser_exe_eval(m_host_executor, l_var.data()));)
+#else
         AMREX_IF_ON_DEVICE((return static_cast<float>(parser_exe_eval(m_device_executor, l_var.data()));))
         AMREX_IF_ON_HOST((return static_cast<float>(parser_exe_eval(m_host_executor, l_var.data()));))
+#endif
     }
 

+    source_repositories = {
+        "baseline": args.baseline_source,
+        "patched": args.patched_source,
+        "warpx": warpx_source,
+    }
+    for name, repository in source_repositories.items():
+        status = git_output(
+            repository,
+            "status",
+            "--porcelain=v1",
+            "--untracked-files=all",
+        )
+        if status:
+            raise AssertionError(f"{name} source tree is dirty")
+        commit = git_output(
+            repository, "rev-parse", "--verify", "HEAD"
+        ).decode().strip()
+        tree = git_output(
+            repository, "rev-parse", "--verify", "HEAD^{tree}"
+        ).decode().strip()
+        if source_attestation.get(f"{name}_commit") != commit:

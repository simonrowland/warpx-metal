+    void writeSnapshot (const std::string& filename) const
+    {
+        using Position = std::array<ParticleReal, AMREX_SPACEDIM>;
+        using Record = std::tuple<Long, int, int, int, int, int, Position>;
+        std::vector<Record> records;
+        records.reserve(static_cast<std::size_t>(
+            TotalNumberOfParticles(false, true)));
+
+        for (int lev = 0; lev <= finestLevel(); ++lev)
+        {
+            const auto& plev = GetParticles(lev);
+            for (MFIter mfi = MakeMFIter(lev); mfi.isValid(); ++mfi)
+            {
+                const int gid = mfi.index();
+                const int tid = mfi.LocalTileIndex();
+                const auto particle_tile = plev.find(std::make_pair(gid, tid));
+                if (particle_tile == plev.end()) {
+                    continue;
+                }
+                const auto& ptile = particle_tile->second;
+                const auto& ptd = ptile.getConstParticleTileData();
+                const auto np = ptile.numParticles();
+
+                for (int i = 0; i < np; ++i)
+                {
+                    ConstParticleType p(ptd, i);
+                    Position pos{};
+                    for (int d = 0; d < AMREX_SPACEDIM; ++d) {
+                        pos[d] = p.pos(d);
+                    }
+                    records.emplace_back(
+                        p.id(), p.cpu(), ParallelDescriptor::MyProc(),
+                        lev, gid, tid, pos);
+                }
+            }
+        }
+
+        std::sort(records.begin(), records.end(),
+            [] (const Record& lhs, const Record& rhs) {
+                return std::tie(std::get<0>(lhs), std::get<1>(lhs)) <
+                       std::tie(std::get<0>(rhs), std::get<1>(rhs));
+            });
+
+        std::ostringstream ranked_filename;
+        ranked_filename << filename << ".rank"
+                        << std::setfill('0') << std::setw(6)
+                        << ParallelDescriptor::MyProc();
+        std::ofstream snapshot(
+            ranked_filename.str(), std::ios::out | std::ios::trunc);
+        AMREX_ALWAYS_ASSERT(snapshot.good());
+        snapshot << "count " << records.size() << '\n';
+        snapshot << std::setprecision(std::numeric_limits<ParticleReal>::max_digits10);
+        for (const auto& [id, cpu, rank, lev, gid, tid, pos] : records)
+        {
+            snapshot << id << ' ' << cpu << ' ' << rank << ' '
+                     << lev << ' ' << gid << ' ' << tid;
+            for (int d = 0; d < AMREX_SPACEDIM; ++d) {
+                snapshot << ' ' << pos[d];
+            }
+            snapshot << '\n';
+        }
+        AMREX_ALWAYS_ASSERT(snapshot.good());
+    }
 };


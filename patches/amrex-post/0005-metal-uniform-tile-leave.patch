+bool ParticleContainerBase::RedistributeUniformTileLeave ()
+{
+    static bool enabled = false;
+    static bool first = true;
+
+    if (first)
+    {
+        first = false;
+        ParmParse pp("particles");
+        pp.query("redistribute_uniform_tile_leave", enabled);
+        if (enabled)
+        {
+            if (ParallelDescriptor::NProcs() != 1) {
+                amrex::Abort(
+                    "particles.redistribute_uniform_tile_leave requires exactly "
+                    "one MPI rank; multi-rank cost and correctness are not validated");
+            }
+#ifndef AMREX_USE_GPU
+            amrex::Warning(
+                "particles.redistribute_uniform_tile_leave on a non-GPU build "
+                "exercises host-side Redistribute semantics only");
+#elif !defined(AMREX_METAL_PORT)
+            amrex::Warning(
+                "particles.redistribute_uniform_tile_leave is executing the GPU "
+                "partition mechanism on an unvalidated backend; the validated "
+                "backend is SYCL/Metal");
+#endif
+            amrex::Print() << "AMReX particle Redistribute uniform-tile-leave: ON\n";
+        }
+    }
+
+    return enabled;
+}

+#!/usr/bin/env python3
+"""CPU regression harness for particles.redistribute_uniform_tile_leave.
+
+The matrix compares binaries built from clean baseline and feature checkouts in
+omitted, explicit-OFF, and ON modes. The external build manifest binds both
+commits, source trees, configured build directories, and binary hashes. The
+matrix covers local/global, single/multi-box, tiled, retained/removed invalid
+IDs, and two MPI ranks. Flag-ON runs only with one rank; a separate two-rank
+case proves the runtime guard rejects enablement. The WarpX check compares
+per-step field-content hashes for baseline, omitted, and OFF. CPU builds do not
+instantiate the GPU partition mechanism. Only Python's standard library is
+required.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+from typing import Any
+
+
+ACTIVATION_MARKER = "AMReX particle Redistribute uniform-tile-leave: ON"
+MPI_GUARD_MESSAGE = (
+    "particles.redistribute_uniform_tile_leave requires exactly one MPI rank"
+)
+CPU_WARNING_MESSAGE = (
+    "particles.redistribute_uniform_tile_leave on a non-GPU build "
+    "exercises host-side Redistribute semantics only"
+)
+Record = tuple[int, int, int, int, int, int, tuple[str, ...]]
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def git_output(repo: Path, *arguments: str) -> bytes:
+    return subprocess.check_output(
+        ["git", "-C", str(repo), *arguments],
+        stdin=subprocess.DEVNULL,
+    )
+
+
+def run_checked(
+    command: list[str],
+    cwd: Path,
+    *,
+    marker_expected: bool,
+    poison_default_init: bool,
+    timeout_seconds: int,
+    warning_expected: bool = False,
+) -> str:
+    env = dict(os.environ)
+    if poison_default_init:
+        env["AMREX_DEFAULT_INIT"] = (
+            "particles.redistribute_uniform_tile_leave=1"
+        )
+    env.pop("AMREX_DEFAULT_INIT", None)
+    env["OMP_NUM_THREADS"] = "1"
+    env["OMPI_MCA_rmaps_base_oversubscribe"] = "1"
+    stdout_path = cwd / "stdout.log"
+    stderr_path = cwd / "stderr.log"
+    try:
+        with stdout_path.open("wb") as stdout, stderr_path.open("wb") as stderr:
+            result = subprocess.run(
+                command,
+                cwd=cwd,
+                env=env,
+                stdin=subprocess.DEVNULL,
+                stdout=stdout,
+                stderr=stderr,
+                check=False,
+                timeout=timeout_seconds,
+            )
+    except subprocess.TimeoutExpired as exc:
+        raise RuntimeError(
+            f"command timed out after {timeout_seconds}s: {' '.join(command)}; "
+            f"see {stdout_path} and {stderr_path}"
+        ) from exc
+    if result.returncode != 0:
+        raise RuntimeError(
+            f"command failed with rc={result.returncode}: {' '.join(command)}; "
+            f"see {stdout_path} and {stderr_path}"
+        )
+
+    stdout_text = stdout_path.read_text(encoding="utf-8", errors="replace")
+    stderr_text = stderr_path.read_text(encoding="utf-8", errors="replace")
+    combined_output = stdout_text + stderr_text
+    marker_seen = ACTIVATION_MARKER in combined_output
+    if marker_seen != marker_expected:
+        raise AssertionError(
+            f"activation marker expected={marker_expected}, seen={marker_seen}: "
+            f"{stdout_path}"
+        )
+    warning_seen = CPU_WARNING_MESSAGE in combined_output
+    if warning_seen != warning_expected:
+        raise AssertionError(
+            f"host warning expected={warning_expected}, seen={warning_seen}: "
+            f"{stdout_path} and {stderr_path}"
+        )
+    return stdout_text
+
+
+def vector(value: int, dimension: int) -> str:
+    return " ".join([str(value)] * dimension)
+
+
+def intvect(value: int, dimension: int) -> str:
+    return "(" + ", ".join([str(value)] * dimension) + ")"
+
+
+def write_redistribute_input(
+    path: Path,
+    *,
+    dimension: int,
+    max_grid_size: int,
+    levels: int,
+    do_regrid: bool,
+    tiling: bool,
+    invalid_probe: int,
+    flag: bool | None,
+) -> None:
+    lines = [
+        f"redistribute.size = {intvect(16, dimension)}",
+        f"redistribute.max_grid_size = {max_grid_size}",
+        "redistribute.is_periodic = 1",
+        "redistribute.num_ppc = 1",
+        f"redistribute.move_dir = {intvect(1, dimension)}",
+        "redistribute.do_random = 0",
+        "redistribute.nsteps = 3",
+        f"redistribute.nlevs = {levels}",
+        f"redistribute.do_regrid = {1 if do_regrid else 0}",
+        "redistribute.num_runtime_real = 0",
+        "redistribute.num_runtime_int = 0",
+        "redistribute.sort = 0",
+        "redistribute.remove_negative = 1",
+        f"redistribute.invalid_probe = {invalid_probe}",
+        "redistribute.snapshot_prefix = particles",
+        f"particles.do_tiling = {1 if tiling else 0}",
+        f"particles.tile_size = {vector(2, dimension)}",
+        "amrex.use_gpu_aware_mpi = 0",
+    ]
+    if flag is not None:
+        lines.append(
+            "particles.redistribute_uniform_tile_leave = "
+            f"{1 if flag else 0}"
+        )
+    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+def parse_snapshot_group(
+    prefix: Path, dimension: int, expected_ranks: int
+) -> dict[str, Any]:
+    files = sorted(prefix.parent.glob(prefix.name + ".rank*"))
+    expected_files = [
+        prefix.parent / f"{prefix.name}.rank{rank:06d}"
+        for rank in range(expected_ranks)
+    ]
+    if files != expected_files:
+        raise RuntimeError(
+            f"ranked snapshot set mismatch for {prefix}: "
+            f"found={[path.name for path in files]}, "
+            f"expected={[path.name for path in expected_files]}"
+        )
+
+    records: list[Record] = []
+    declared_total = 0
+    for path in files:
+        writer_rank = int(path.name.rsplit(".rank", maxsplit=1)[1])
+        lines = path.read_text(encoding="utf-8").splitlines()
+        if not lines or not lines[0].startswith("count "):
+            raise RuntimeError(f"invalid snapshot header: {path}")
+        declared = int(lines[0].split()[1])
+        declared_total += declared
+        if declared != len(lines) - 1:
+            raise RuntimeError(
+                f"snapshot count mismatch in {path}: declared={declared}, "
+                f"records={len(lines)-1}"
+            )
+        for line in lines[1:]:
+            fields = line.split()
+            if len(fields) != 6 + dimension:
+                raise RuntimeError(
+                    f"snapshot dimensionality mismatch in {path}: {line}"
+                )
+            record: Record = (
+                int(fields[0]),
+                int(fields[1]),
+                int(fields[2]),
+                int(fields[3]),
+                int(fields[4]),
+                int(fields[5]),
+                tuple(fields[6:]),
+            )
+            if record[2] != writer_rank:
+                raise RuntimeError(
+                    f"record writer rank mismatch in {path}: {record}"
+                )
+            records.append(record)
+
+    records.sort(key=lambda record: (abs(record[0]), record[1]))
+    if declared_total != len(records):
+        raise RuntimeError(
+            f"gathered snapshot count mismatch for {prefix}: "
+            f"declared={declared_total}, records={len(records)}"
+        )
+    identities = [(abs(record[0]), record[1]) for record in records]
+    if len(set(identities)) != len(identities):
+        raise RuntimeError(f"duplicate absolute particle ID/CPU pair: {prefix}")
+
+    digest = hashlib.sha256()
+    for record in records:
+        digest.update(repr(record).encode("utf-8"))
+        digest.update(b"\n")
+    return {
+        "count": len(records),
+        "records": records,
+        "snapshot_sha256": digest.hexdigest(),
+        "rank_files": [path.name for path in files],
+    }
+
+
+def collect_snapshots(
+    case_dir: Path, dimension: int, expected_ranks: int
+) -> dict[str, dict[str, Any]]:
+    prefixes = {
+        re.sub(r"\.rank\d+$", "", path.name)
+        for path in case_dir.glob("particles.*.rank*")
+    }
+    return {
+        prefix.removeprefix("particles."): parse_snapshot_group(
+            case_dir / prefix, dimension, expected_ranks
+        )
+        for prefix in sorted(prefixes)
+    }
+
+
+def run_redistribute_case(
+    *,
+    executable: Path,
+    mpi_exec: Path,
+    case_dir: Path,
+    dimension: int,
+    max_grid_size: int,
+    levels: int,
+    do_regrid: bool,
+    tiling: bool,
+    invalid_probe: int,
+    ranks: int,
+    flag: bool | None,
+    marker_expected: bool,
+    warning_expected: bool,
+    poison_default_init: bool,
+    timeout_seconds: int,
+) -> dict[str, Any]:
+    case_dir.mkdir(parents=True, exist_ok=False)
+    input_path = case_dir / "inputs"
+    write_redistribute_input(
+        input_path,
+        dimension=dimension,
+        max_grid_size=max_grid_size,
+        levels=levels,
+        do_regrid=do_regrid,
+        tiling=tiling,
+        invalid_probe=invalid_probe,
+        flag=flag,
+    )
+    command = [str(executable), str(input_path)]
+    if ranks > 1:
+        command = [str(mpi_exec), "-n", str(ranks), *command]
+    run_checked(
+        command,
+        case_dir,
+        marker_expected=marker_expected,
+        poison_default_init=poison_default_init,
+        timeout_seconds=timeout_seconds,
+        warning_expected=warning_expected,
+    )
+    snapshots = collect_snapshots(case_dir, dimension, ranks)
+    expected_tags = {"initial", "step1", "step2", "step3"}
+    if do_regrid:
+        expected_tags.add("global")
+    if invalid_probe:
+        expected_tags.add("invalid")
+    if set(snapshots) != expected_tags:
+        raise AssertionError(
+            f"{case_dir.name}: snapshots={sorted(snapshots)}, "
+            f"expected={sorted(expected_tags)}"
+        )
+    if any(snapshot["count"] <= 0 for snapshot in snapshots.values()):
+        raise AssertionError(f"{case_dir.name}: empty particle snapshot")
+    return {
+        "snapshots": snapshots,
+        "command": command,
+    }
+
+
+def run_mpi_guard_case(
+    *,
+    executable: Path,
+    mpi_exec: Path,
+    case_dir: Path,
+    dimension: int,
+    timeout_seconds: int,
+) -> dict[str, Any]:
+    case_dir.mkdir(parents=True, exist_ok=False)
+    input_path = case_dir / "inputs"
+    write_redistribute_input(
+        input_path,
+        dimension=dimension,
+        max_grid_size=4,
+        levels=1,
+        do_regrid=False,
+        tiling=True,
+        invalid_probe=0,
+        flag=True,
+    )
+    command = [str(mpi_exec), "-n", "2", str(executable), str(input_path)]
+    env = dict(os.environ)
+    env.pop("AMREX_DEFAULT_INIT", None)
+    env["OMP_NUM_THREADS"] = "1"
+    env["OMPI_MCA_rmaps_base_oversubscribe"] = "1"
+    stdout_path = case_dir / "stdout.log"
+    stderr_path = case_dir / "stderr.log"
+    try:
+        with stdout_path.open("wb") as stdout, stderr_path.open("wb") as stderr:
+            result = subprocess.run(
+                command,
+                cwd=case_dir,
+                env=env,
+                stdin=subprocess.DEVNULL,
+                stdout=stdout,
+                stderr=stderr,
+                check=False,
+                timeout=timeout_seconds,
+            )
+    except subprocess.TimeoutExpired as exc:
+        raise RuntimeError(
+            f"MPI guard probe timed out after {timeout_seconds}s: "
+            f"{' '.join(command)}"
+        ) from exc
+
+    output = (
+        stdout_path.read_text(encoding="utf-8", errors="replace")
+        + stderr_path.read_text(encoding="utf-8", errors="replace")
+    )
+    if result.returncode == 0:
+        raise AssertionError("MPI guard probe unexpectedly succeeded")
+    if MPI_GUARD_MESSAGE not in output:
+        raise AssertionError(
+            f"MPI guard message missing; see {stdout_path} and {stderr_path}"
+        )
+    if ACTIVATION_MARKER in output:
+        raise AssertionError("activation marker printed before MPI guard abort")
+    return {
+        "command": command,
+        "returncode": result.returncode,
+        "message": MPI_GUARD_MESSAGE,
+    }
+
+
+def public_run_summary(run: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "command": run["command"],
+        "snapshots": {
+            name: {
+                "count": snapshot["count"],
+                "sha256": snapshot["snapshot_sha256"],
+                "rank_files": snapshot["rank_files"],
+            }
+            for name, snapshot in run["snapshots"].items()
+        },
+    }
+
+
+def compare_runs(name: str, runs: dict[str, dict[str, Any]]) -> None:
+    reference = runs["baseline"]["snapshots"]
+    for mode in ("patched_default", "patched_off", "patched_on"):
+        if mode not in runs:
+            continue
+        candidate = runs[mode]["snapshots"]
+        if set(candidate) != set(reference):
+            raise AssertionError(f"{name}/{mode}: snapshot tag mismatch")
+        for tag in reference:
+            if candidate[tag]["records"] != reference[tag]["records"]:
+                raise AssertionError(
+                    f"{name}/{mode}: particle state differs at {tag}"
+                )
+
+
+def destination_classes(run: dict[str, Any]) -> dict[str, int]:
+    initial = {
+        (abs(record[0]), record[1]): record
+        for record in run["snapshots"]["initial"]["records"]
+    }
+    step1 = {
+        (abs(record[0]), record[1]): record
+        for record in run["snapshots"]["step1"]["records"]
+    }
+    stays = 0
+    crosses = 0
+    for identity, before in initial.items():
+        after = step1[identity]
+        before_destination = before[2:6]
+        after_destination = after[2:6]
+        if before_destination == after_destination:
+            stays += 1
+        else:
+            crosses += 1
+    return {"natural_stayers": stays, "natural_crossers": crosses}
+
+
+def validate_invalid_pair(
+    label: str,
+    keep: dict[str, dict[str, Any]],
+    remove: dict[str, dict[str, Any]],
+) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for mode in ("baseline", "patched_default", "patched_off", "patched_on"):
+        if mode not in keep or mode not in remove:
+            continue
+        kept = keep[mode]["snapshots"]["invalid"]["records"]
+        removed = remove[mode]["snapshots"]["invalid"]["records"]
+        retained_positive = [record for record in kept if record[0] > 0]
+        negative_count = sum(record[0] < 0 for record in kept)
+        if retained_positive != removed:
+            raise AssertionError(
+                f"{label}/{mode}: remove=true did not remove exactly invalid IDs"
+            )
+        if negative_count <= 0:
+            raise AssertionError(f"{label}/{mode}: keep=false retained no invalid IDs")
+        result[mode] = {
+            "before_count": len(kept),
+            "retained_invalid_count": negative_count,
+            "after_remove_count": len(removed),
+            "exact_removed_id_set": True,
+        }
+    return result
+
+
+def set_input_parameter(text: str, key: str, value: str) -> str:
+    pattern = re.compile(rf"(?m)^\s*{re.escape(key)}\s*=.*$")
+    replacement = f"{key} = {value}"
+    if pattern.search(text):
+        return pattern.sub(replacement, text, count=1)
+    return text.rstrip() + "\n" + replacement + "\n"
+
+
+def remove_input_parameter(text: str, key: str) -> str:
+    pattern = re.compile(rf"(?m)^\s*{re.escape(key)}\s*=.*(?:\n|$)")
+    return pattern.sub("", text)
+
+
+def write_warpx_input(source: Path, destination: Path, *, flag: bool | None) -> None:
+    text = source.read_text(encoding="utf-8")
+    flag_key = "particles.redistribute_uniform_tile_leave"
+    text = remove_input_parameter(text, flag_key)
+    overrides = {
+        "max_step": "3",
+        "amr.n_cell": "32 32",
+        "amr.max_grid_size": "16",
+        "amr.blocking_factor": "8",
+        "electrons.num_particles_per_cell_each_dim": "1 1",
+        "diag1.intervals": "1",
+        "diag1.format": "plotfile",
+        "warpx.random_seed": "42",
+        "warpx.serialize_initial_conditions": "1",
+    }
+    for key, value in overrides.items():
+        text = set_input_parameter(text, key, value)
+    if flag is not None:
+        text = set_input_parameter(
+            text,
+            flag_key,
+            "1" if flag else "0",
+        )
+    destination.write_text(text, encoding="utf-8")
+
+
+def run_semantic_omission_probe(
+    *,
+    executable: Path,
+    input_path: Path,
+    case_dir: Path,
+    timeout_seconds: int,
+) -> None:
+    case_dir.mkdir(parents=True, exist_ok=False)
+    stdout = run_checked(
+        [
+            str(executable),
+            str(input_path),
+            "validation.only_assert_uniform_tile_leave_omitted=1",
+        ],
+        case_dir,
+        marker_expected=False,
+        poison_default_init=False,
+        timeout_seconds=timeout_seconds,
+    )
+    marker = "AMReX semantic uniform-tile-leave omission probe: PASS"
+    if marker not in stdout:
+        raise AssertionError(f"semantic omission marker missing: {case_dir}")
+
+
+def run_expected_semantic_probe_failure(
+    *,
+    executable: Path,
+    input_path: Path,
+    case_dir: Path,
+    timeout_seconds: int,
+) -> None:
+    env = dict(os.environ)
+    env.pop("AMREX_DEFAULT_INIT", None)
+    env["OMP_NUM_THREADS"] = "1"
+    case_dir.mkdir(parents=True, exist_ok=False)
+    with (case_dir / "stdout.log").open("wb") as stdout, (
+        case_dir / "stderr.log"
+    ).open("wb") as stderr:
+        try:
+            result = subprocess.run(
+                [
+                    str(executable),
+                    str(input_path),
+                    "validation.only_assert_uniform_tile_leave_omitted=1",
+                ],
+                cwd=case_dir,
+                env=env,
+                stdin=subprocess.DEVNULL,
+                stdout=stdout,
+                stderr=stderr,
+                check=False,
+                timeout=timeout_seconds,
+            )
+        except subprocess.TimeoutExpired as exc:
+            raise RuntimeError(
+                f"semantic negative probe timed out: {case_dir}"
+            ) from exc
+    if result.returncode == 0:
+        raise AssertionError(
+            f"semantic negative probe false-greened: {case_dir}"
+        )
+    combined_output = (
+        (case_dir / "stdout.log").read_text(encoding="utf-8", errors="replace")
+        + (case_dir / "stderr.log").read_text(
+            encoding="utf-8", errors="replace"
+        )
+    )
+    expected = "particles.redistribute_uniform_tile_leave is not omitted"
+    if expected not in combined_output:
+        raise AssertionError(
+            f"semantic negative probe failed for the wrong reason: {case_dir}"
+        )
+
+
+def run_semantic_omission_negative_probes(
+    *,
+    executable: Path,
+    root: Path,
+    timeout_seconds: int,
+) -> None:
+    root.mkdir(parents=True, exist_ok=False)
+    probes = {
+        "commented_table": (
+            "[particles] # trailing comment\n"
+            "redistribute_uniform_tile_leave = 0\n"
+        ),
+        "same_line_definition": (
+            "max_step = 3 "
+            "particles.redistribute_uniform_tile_leave = 0\n"
+        ),
+    }
+    for name, content in probes.items():
+        probe_dir = root / name
+        input_path = root / f"{name}.inputs"
+        input_path.write_text(content, encoding="utf-8")
+        run_expected_semantic_probe_failure(
+            executable=executable,
+            input_path=input_path,
+            case_dir=probe_dir,
+            timeout_seconds=timeout_seconds,
+        )
+
+    include_dir = root / "continued_include"
+    included_path = root / "included.inputs"
+    included_path.write_text(
+        "particles.redistribute_uniform_tile_leave = 0\n",
+        encoding="utf-8",
+    )
+    include_input = root / "continued_include.inputs"
+    include_input.write_text(
+        f'FILE \\\n= "{included_path}"\n',
+        encoding="utf-8",
+    )
+    run_expected_semantic_probe_failure(
+        executable=executable,
+        input_path=include_input,
+        case_dir=include_dir,
+        timeout_seconds=timeout_seconds,
+    )
+
+
+def find_plotfiles(run_dir: Path) -> dict[int, Path]:
+    result: dict[int, Path] = {}
+    for header in run_dir.rglob("Header"):
+        plotfile = header.parent
+        if not any(plotfile.glob("Level_*/Cell_H")):
+            continue
+        match = re.search(r"(\d{6})$", plotfile.name)
+        if match:
+            step = int(match.group(1))
+            if step in (1, 2, 3):
+                if step in result:
+                    raise RuntimeError(
+                        f"multiple plotfiles for step {step} in {run_dir}"
+                    )
+                result[step] = plotfile
+    if set(result) != {1, 2, 3}:
+        raise RuntimeError(
+            f"expected plotfiles for steps 1-3 in {run_dir}, found {result}"
+        )
+    return result
+
+
+def field_content_hash(plotfile: Path) -> tuple[str, list[str]]:
+    files = [plotfile / "Header"]
+    files.extend(
+        path for path in plotfile.glob("Level_*/Cell_*") if path.is_file()
+    )
+    files = sorted(files)
+    if len(files) < 3:
+        raise RuntimeError(f"incomplete plotfile field payload: {plotfile}")
+
+    digest = hashlib.sha256()
+    relative_files: list[str] = []
+    for path in files:
+        relative = path.relative_to(plotfile).as_posix()
+        relative_files.append(relative)
+        digest.update(relative.encode("utf-8"))
+        digest.update(b"\0")
+        with path.open("rb") as stream:
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(block)
+    return digest.hexdigest(), relative_files
+
+
+def run_warpx_case(
+    *,
+    executable: Path,
+    omission_probe_executable: Path,
+    source_input: Path,
+    case_dir: Path,
+    flag: bool | None,
+    timeout_seconds: int,
+) -> dict[str, Any]:
+    case_dir.mkdir(parents=True, exist_ok=False)
+    input_path = case_dir / "inputs"
+    write_warpx_input(source_input, input_path, flag=flag)
+    if flag is None:
+        run_semantic_omission_probe(
+            executable=omission_probe_executable,
+            input_path=input_path,
+            case_dir=case_dir / "semantic-omission-probe",
+            timeout_seconds=timeout_seconds,
+        )
+    run_checked(
+        [str(executable), str(input_path)],
+        case_dir,
+        marker_expected=False,
+        poison_default_init=False,
+        timeout_seconds=timeout_seconds,
+    )
+    plotfiles = find_plotfiles(case_dir)
+    return {
+        "semantic_omission_proven": flag is None,
+        "steps": {
+            str(step): {
+                "plotfile": str(plotfile),
+                "field_content_sha256": field_content_hash(plotfile)[0],
+                "hashed_files": field_content_hash(plotfile)[1],
+            }
+            for step, plotfile in sorted(plotfiles.items())
+        }
+    }
+
+
+def main() -> int:

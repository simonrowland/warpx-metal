+        raise FileExistsError(args.work_dir)
+
+    binary_hashes = {
+        "baseline_redistribute": sha256_file(args.baseline_redistribute),
+        "patched_redistribute": sha256_file(args.patched_redistribute),
+        "baseline_warpx": sha256_file(args.baseline_warpx),
+        "patched_warpx": sha256_file(args.patched_warpx),
+    }
+    for baseline_name, patched_name in (
+        ("baseline_redistribute", "patched_redistribute"),
+        ("baseline_warpx", "patched_warpx"),
+    ):
+        baseline_path = getattr(args, baseline_name).resolve()
+        patched_path = getattr(args, patched_name).resolve()
+        if baseline_path == patched_path:
+            raise AssertionError(
+                f"{baseline_name} and {patched_name} resolve to the same path"
+            )
+        if binary_hashes[baseline_name] == binary_hashes[patched_name]:
+            raise AssertionError(
+                f"{baseline_name} and {patched_name} have identical hashes"
+            )
+    baseline_commit = git_output(
+        args.baseline_source, "rev-parse", "--verify", "HEAD"
+    ).decode().strip()
+    patched_commit = git_output(
+        args.patched_source, "rev-parse", "--verify", "HEAD"
+    ).decode().strip()
+    if not re.fullmatch(r"[0-9a-f]{40}", baseline_commit):
+        raise AssertionError("derived baseline commit is not canonical")
+    if not re.fullmatch(r"[0-9a-f]{40}", patched_commit):
+        raise AssertionError("derived patched commit is not canonical")
+    if baseline_commit == patched_commit:
+        raise AssertionError("baseline and patched sources use the same commit")
+
+    manifest = json.loads(args.build_manifest.read_text(encoding="utf-8"))
+    if (
+        manifest.get("schema")
+        != "amrex.uniform-tile-leave.cpu-build-manifest.v4"
+    ):
+        raise AssertionError("unexpected build manifest schema")
+    if manifest.get("baseline_commit") != baseline_commit:
+        raise AssertionError("manifest baseline commit mismatch")
+    if manifest.get("patched_commit") != patched_commit:
+        raise AssertionError("manifest patched commit mismatch")
+
+    source_attestation = manifest.get("source_attestation", {})

+const live_toolchain_probe& get_live_toolchain_probe() {
+  static std::once_flag once;
+  static live_toolchain_probe probe;
+  std::call_once(once, []() {
+    std::string metal_path;
+    std::string metal_version;
+    std::string sdk_build;
+    std::string os_build;
+    const std::string xcrun = metal_xcrun_path();
+    if (!capture_command({xcrun, "--find", "metal"},
+                         metal_path) ||
+        !capture_command({xcrun, "-sdk", "macosx", "metal",
+                          "--version"}, metal_version) ||
+        !capture_command({xcrun, "-sdk", "macosx",
+                          "--show-sdk-build-version"}, sdk_build) ||
+        !capture_command({"/usr/bin/sw_vers", "-buildVersion"}, os_build)) {
+      probe.error = "required xcrun/SDK/OS fingerprint probe failed";
+      return;
+    }
+
+    static int adaptivecpp_module_anchor = 0;
+    Dl_info module_info = {};
+    if (::dladdr(&adaptivecpp_module_anchor, &module_info) == 0 ||
+        !module_info.dli_fname) {
+      probe.error = "could not resolve running AdaptiveCpp library";
+      return;
+    }
+    const std::string build_identity =
+        stable_file_digest(module_info.dli_fname);
+    if (build_identity.empty()) {
+      probe.error = "could not digest running AdaptiveCpp library";
+      return;
+    }
+
+    probe.fingerprint =
+        "schema=aot-v2|metal-path=" + metal_path +
+        "|metal-version=" + metal_version + "|sdk-build=" + sdk_build +
+        "|os-build=" + os_build + "|acpp-build=" + build_identity;
+    probe.available = true;
+  });
+  return probe;
+}
+
+std::uint64_t stable_string_digest(const std::string& value) {
+  common::stable_running_hash hash;
+  const std::uint64_t bytes = value.size();
+  hash(&bytes, sizeof(bytes));
+  hash(value.data(), value.size());
+  return hash.get_current_hash();
 }
 

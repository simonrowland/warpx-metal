+    device_family = device->name()->utf8String();
+    if (device->supportsFamily(MTL::GPUFamily(MTL::GPUFamilyApple8 + 1))) {
+      apple_gpu_family = 9;
+    } else if (device->supportsFamily(MTL::GPUFamilyApple8)) {
+      apple_gpu_family = 8;
+    } else if (device->supportsFamily(MTL::GPUFamilyApple7)) {
+      apple_gpu_family = 7;
+    }
+  }
+  fingerprint = probe.fingerprint + "|device-family=" + device_family +
+                "|apple-gpu-family=" + std::to_string(apple_gpu_family) +
+                "|msl=metal4.0|optimization=-Os";

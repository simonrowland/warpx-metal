+std::string trim_command_output(std::string value) {
+  while (!value.empty() &&
+         (value.back() == '\n' || value.back() == '\r' ||
+          value.back() == ' ' || value.back() == '\t')) {
+    value.pop_back();
+  }
+  for (char& c : value) {
+    if (c == '\n' || c == '\r' || c == '\t') {
+      c = ' ';
+    }
+  }
+  return value;
+}
+
+bool capture_command(const std::vector<std::string>& command,
+                     std::string& output) {
+  int pipe_fds[2] = {-1, -1};
+  if (::pipe(pipe_fds) != 0) {
+    return false;
+  }
+  ::fcntl(pipe_fds[0], F_SETFD, FD_CLOEXEC);
+  ::fcntl(pipe_fds[1], F_SETFD, FD_CLOEXEC);
+
+  metal_process::child_process child;
+  std::string spawn_error;
+  if (!metal_process::spawn_in_own_process_group(
+          command, child, spawn_error, pipe_fds[1], true)) {
+    ::close(pipe_fds[0]);
+    ::close(pipe_fds[1]);
+    return false;
+  }
+  ::close(pipe_fds[1]);
+  const int flags = ::fcntl(pipe_fds[0], F_GETFL, 0);
+  if (flags < 0 || ::fcntl(pipe_fds[0], F_SETFL, flags | O_NONBLOCK) != 0) {
+    int status = 0;
+    metal_process::terminate_and_reap(child, status);
+    ::close(pipe_fds[0]);
+    return false;
+  }
+
+  output.clear();
+  int child_status = 0;
+  bool child_reaped = false;
+  bool pipe_eof = false;
+  const auto deadline = std::chrono::steady_clock::now() +
+                        std::chrono::seconds{5};
+  char buffer[512];
+  while (!child_reaped || !pipe_eof) {
+    const ssize_t count = ::read(pipe_fds[0], buffer, sizeof(buffer));
+    if (count > 0) {
+      output.append(buffer, static_cast<std::size_t>(count));
+      if (output.size() > 1024 * 1024) {
+        metal_process::terminate_and_reap(child, child_status);
+        ::close(pipe_fds[0]);
+        return false;
+      }
+    } else if (count == 0) {
+      pipe_eof = true;
+    } else if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+      metal_process::terminate_and_reap(child, child_status);
+      ::close(pipe_fds[0]);
+      return false;
+    }
+
+    if (!child_reaped) {
+      const pid_t waited = ::waitpid(child.pid, &child_status, WNOHANG);
+      if (waited == child.pid || (waited < 0 && errno == ECHILD)) {
+        child.pid = -1;
+        child_reaped = true;
+      } else if (waited < 0 && errno != EINTR) {
+        metal_process::terminate_and_reap(child, child_status);
+        ::close(pipe_fds[0]);
+        return false;
+      }
+    }
+    if (std::chrono::steady_clock::now() >= deadline) {
+      metal_process::terminate_and_reap(child, child_status);
+      ::close(pipe_fds[0]);
+      return false;
+    }
+    if (!child_reaped || !pipe_eof) {
+      std::this_thread::sleep_for(std::chrono::milliseconds{5});
+    }
+  }
+  ::close(pipe_fds[0]);
+  output = trim_command_output(std::move(output));
+  return WIFEXITED(child_status) && WEXITSTATUS(child_status) == 0 &&
+         !output.empty();
+}

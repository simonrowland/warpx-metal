+std::string stable_file_digest(const std::string& path) {
+  std::ifstream input{path, std::ios::binary};
+  if (!input) {
+    return {};
+  }
+  common::stable_running_hash hash;
+  std::uint64_t total_bytes = 0;
+  char buffer[64 * 1024];
+  while (input) {
+    input.read(buffer, sizeof(buffer));
+    const std::streamsize count = input.gcount();
+    if (count > 0) {
+      hash(buffer, static_cast<std::size_t>(count));
+      total_bytes += static_cast<std::uint64_t>(count);
+    }
+  }
+  if (!input.eof()) {
+    return {};
+  }
+  // Derivation: build identity is ChibiHash64 over every dylib byte, followed
+  // by the exact byte count to distinguish a truncated prefix from its source.
+  hash(&total_bytes, sizeof(total_bytes));
+  std::ostringstream out;
+  out << std::hex << hash.get_current_hash() << ":" << std::dec
+      << total_bytes;
+  return out.str();
+}

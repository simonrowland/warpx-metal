+inline void record_launch(const std::string& label, std::uint64_t wait_v,
+                          std::uint64_t signal_v, std::uint64_t signalled) {
+  LaunchRec r;
+  r.seq = ++g_launch_seq();
+  r.label = label;
+  r.wait_value = wait_v;
+  r.signal_value = signal_v;
+  r.shared_signalled_at_submit = signalled;
+  r.t = std::chrono::steady_clock::now();
+  std::lock_guard<std::mutex> lock(g_mu());
+  g_launches().push_back(std::move(r));
+  while (g_launches().size() > 20) g_launches().pop_front();
+}

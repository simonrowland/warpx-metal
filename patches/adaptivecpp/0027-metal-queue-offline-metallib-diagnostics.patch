+struct CBRec {
+  std::uint64_t id = 0;
+  std::string label;
+  MTL::CommandBuffer* cb = nullptr;
+  MTL::SharedEvent* shared_event = nullptr;
+  std::uint64_t encode_wait_value = 0;
+  std::uint64_t encode_signal_value = 0;
+  std::uint64_t shared_signalled_at_submit = 0;
+  std::chrono::steady_clock::time_point created_at;
+  std::atomic<bool> completed{false};
+  std::atomic<bool> timeout_logged{false};
+};

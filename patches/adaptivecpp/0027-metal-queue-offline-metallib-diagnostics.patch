+extern "C" void stall_hunt_note_host_wait_c(void* evt, unsigned long long want, int spin_sec) {
+  stall_hunt::note_host_wait_spin(reinterpret_cast<MTL::SharedEvent*>(evt),
+                                  static_cast<std::uint64_t>(want), spin_sec);
+}

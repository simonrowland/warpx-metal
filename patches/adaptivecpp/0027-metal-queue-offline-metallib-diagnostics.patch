+bool get_cached_metal_aot_image_identity(
+    hcf_object_id hcf_id, const std::string& image_name,
+    const common::hcf_container* hcf,
+    const common::hcf_container::node* image_node,
+    metal_aot_image_identity& identity) {
+  static std::mutex identity_mutex;
+  static std::unordered_map<std::string, metal_aot_image_identity>
+      identity_cache;
+  const std::string key = std::to_string(hcf_id) + ":" + image_name;
+
+  std::lock_guard<std::mutex> lock{identity_mutex};
+  auto existing = identity_cache.find(key);
+  if (existing != identity_cache.end()) {
+    identity = existing->second;
+    return true;
+  }
+  if (!hcf || !image_node) {
+    return false;
+  }
+  std::string image_bytes;
+  if (!hcf->get_binary_attachment(image_node, image_bytes)) {
+    return false;
+  }
+  identity = make_metal_aot_image_identity(image_bytes);
+  identity_cache.emplace(key, identity);
+  return true;
+}

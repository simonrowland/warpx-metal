+inline void dump_table(const char* reason, MTL::SharedEvent* evt_hint = nullptr) {
+  bool first = !g_table_dumped().exchange(true);
+  auto now = std::chrono::steady_clock::now();
+  std::uint64_t signalled = 0;
+  MTL::SharedEvent* evt = evt_hint ? evt_hint : g_primary_shared().load();
+  if (evt) signalled = evt->signaledValue();
+
+  std::ostringstream out;
+  out << "\n======== STALL_HUNT_CB_TABLE reason=" << reason
+      << " first=" << (first ? 1 : 0) << " =========\n";
+  out << "shared_event_ptr=" << static_cast<const void*>(evt)
+      << " shared_signalled_value=" << signalled
+      << " last_signal_submitted=" << g_last_signal_submitted().load()
+      << " last_wait_submitted=" << g_last_wait_submitted().load()
+      << "\n";
+  out << "--- outstanding / recent CBs ---\n";
+  out << "id\tage_sec\tstatus\terror\tencode_wait\tencode_signal\t"
+         "signalled_at_submit\tcompleted\tlabel\n";
+
+  std::vector<std::shared_ptr<CBRec>> snap;
+  std::deque<LaunchRec> launches;
+  {
+    std::lock_guard<std::mutex> lock(g_mu());
+    snap = g_cbs();
+    launches = g_launches();
+  }
+
+  int outstanding = 0;
+  for (auto& rec : snap) {
+    if (!rec || !rec->cb) continue;
+    auto age = std::chrono::duration_cast<std::chrono::seconds>(
+        now - rec->created_at).count();
+    auto* cb = rec->cb;
+    auto st = cb->status();
+    std::string stn = status_name(st);
+    std::string er = err_str(cb->error());
+    bool done = rec->completed.load();
+    if (!done) outstanding++;
+    if (!done || age < 5) {
+      out << rec->id << "\t" << age << "\t" << stn << "\t\"" << er << "\"\t"
+          << rec->encode_wait_value << "\t" << rec->encode_signal_value << "\t"
+          << rec->shared_signalled_at_submit << "\t" << (done ? 1 : 0) << "\t\""
+          << rec->label << "\"\n";
+    }
+  }
+  out << "outstanding_count=" << outstanding << "\n";
+
+  out << "--- last ~20 launches (most recent last) ---\n";
+  out << "seq\twait\tsignal\tsignalled_at_submit\tlabel\n";
+  for (const auto& L : launches) {
+    out << L.seq << "\t" << L.wait_value << "\t" << L.signal_value << "\t"
+        << L.shared_signalled_at_submit << "\t\"" << L.label << "\"\n";
+  }
+
+  out << "--- classification_hints ---\n";
+  bool row1 = false, row2 = false, row3 = false;
+  for (auto& rec : snap) {
+    if (!rec || !rec->cb || rec->completed.load()) continue;
+    auto st = rec->cb->status();
+    std::uint64_t need = rec->encode_wait_value;
+    if (need > 0 && signalled < need &&
+        (st == MTL::CommandBufferStatusCommitted ||
+         st == MTL::CommandBufferStatusScheduled ||
+         st == MTL::CommandBufferStatusEnqueued)) {
+      row1 = true;
+      out << "HINT_ROW1 id=" << rec->id
+          << " CB waiting encodeWait=" << need
+          << " but signalled=" << signalled << "\n";
+    } else if (st == MTL::CommandBufferStatusCompleted) {
+      row2 = true;
+      out << "HINT_ROW2 id=" << rec->id
+          << " CB Completed but still tracked outstanding\n";
+    } else if ((st == MTL::CommandBufferStatusCommitted ||
+                st == MTL::CommandBufferStatusScheduled) &&
+               (need == 0 || signalled >= need)) {
+      row3 = true;
+      out << "HINT_ROW3 id=" << rec->id
+          << " CB " << status_name(st)
+          << " waits_satisfied (need=" << need
+          << " signalled=" << signalled
+          << ") but GPU has not retired\n";
+    } else {
+      out << "HINT_OTHER id=" << rec->id << " status=" << status_name(st)
+          << " wait=" << need << " signalled=" << signalled << "\n";
+    }
+  }
+  out << "summary_row1_unsatisfied_wait=" << (row1 ? 1 : 0)
+      << " row2_completed_host_blind=" << (row2 ? 1 : 0)
+      << " row3_driver_non_retire=" << (row3 ? 1 : 0) << "\n";
+  out << "======== END STALL_HUNT_CB_TABLE ========\n";
+
+  std::cerr << out.str() << std::flush;
+  if (const char* path = std::getenv("STALL_HUNT_CAPTURE_PATH")) {
+    if (path[0]) {
+      FILE* f = std::fopen(path, "a");
+      if (f) {
+        std::fputs(out.str().c_str(), f);
+        std::fclose(f);
+      }
+    }
+  }
+}
 
+inline void watchdog_loop() {
+  for (;;) {
+    std::this_thread::sleep_for(std::chrono::seconds(1));
+    const int timeout = watchdog_timeout_sec();
+    if (timeout <= 0) continue;
+    auto now = std::chrono::steady_clock::now();
+    std::vector<std::shared_ptr<CBRec>> pending;
+    bool fire = false;
+    {
+      std::lock_guard<std::mutex> lock(g_mu());
+      pending.reserve(g_cbs().size());
+      for (auto& rec : g_cbs()) {
+        if (!rec || !rec->cb) continue;
+        if (rec->completed.load()) {
+          if (rec->cb) {
+            rec->cb->release();
+            rec->cb = nullptr;
+          }
+          continue;
+        }
+        auto age = std::chrono::duration_cast<std::chrono::seconds>(
+            now - rec->created_at).count();
+        if (age >= timeout && !rec->timeout_logged.exchange(true)) {
+          fire = true;
+          auto* cb = rec->cb;
+          std::cerr << "B001_METAL_CMDBUF_TIMEOUT"
+                    << " id=" << rec->id
+                    << " age_sec=" << age
+                    << " timeout_sec=" << timeout
+                    << " status=" << status_name(cb->status())
+                    << " error=\"" << err_str(cb->error()) << "\""
+                    << " encode_wait=" << rec->encode_wait_value
+                    << " encode_signal=" << rec->encode_signal_value
+                    << " signalled_now="
+                    << (rec->shared_event ? rec->shared_event->signaledValue() : 0)
+                    << " label=\"" << rec->label << "\""
+                    << std::endl;
+        }
+        pending.push_back(rec);
+      }
+      g_cbs().swap(pending);
+    }
+    if (fire) {
+      dump_table("watchdog_timeout");
+    }
+  }
+}
+
+inline void watch_cb(MTL::CommandBuffer* cb, MTL::SharedEvent* shared,
+                     std::string label, std::uint64_t wait_v, std::uint64_t signal_v) {
+  if (!cb) return;
+  // Always track when env set; also when STALL_HUNT_ALWAYS_TRACK=1
+  if (!std::getenv("ACPP_METAL_CMDBUF_WATCHDOG_SEC") &&
+      !std::getenv("STALL_HUNT_ALWAYS_TRACK")) {
+    return;
+  }
+  if (shared) g_primary_shared().store(shared);
+  if (signal_v) g_last_signal_submitted().store(signal_v);
+  if (wait_v) g_last_wait_submitted().store(wait_v);
+
+  std::uint64_t signalled = shared ? shared->signaledValue() : 0;
+  record_launch(label, wait_v, signal_v, signalled);
+
+  auto rec = std::make_shared<CBRec>();
+  rec->id = ++g_next_id();
+  rec->label = std::move(label);
+  rec->cb = cb->retain();
+  rec->shared_event = shared;
+  rec->encode_wait_value = wait_v;
+  rec->encode_signal_value = signal_v;
+  rec->shared_signalled_at_submit = signalled;
+  rec->created_at = std::chrono::steady_clock::now();
+
+  cb->addCompletedHandler([rec](MTL::CommandBuffer* c) {
+    rec->completed.store(true);
+    if (c && c->status() == MTL::CommandBufferStatusError) {
+      std::cerr << "B001_METAL_CMDBUF_ERROR id=" << rec->id
+                << " error=\"" << err_str(c->error()) << "\""
+                << " label=\"" << rec->label << "\"" << std::endl;
+    }
+  });
+
+  {
+    std::lock_guard<std::mutex> lock(g_mu());
+    g_cbs().push_back(rec);
+  }
+  bool expected = false;
+  if (g_watchdog_started().compare_exchange_strong(expected, true)) {
+    std::thread{watchdog_loop}.detach();
+    std::cerr << "STALL_HUNT_WATCHDOG_STARTED timeout_sec="
+              << watchdog_timeout_sec() << std::endl;
+  }
+}
+
+inline void note_host_wait_spin(MTL::SharedEvent* evt, std::uint64_t want, int spin_sec) {
+  static std::atomic<int> last_dump_at{-1};
+  if (spin_sec < 5) return;
+  bool should = (spin_sec == 5 || spin_sec == 15 || spin_sec == 30 ||
+                 (spin_sec > 30 && spin_sec % 30 == 0));
+  if (!should) return;
+  int prev = last_dump_at.load();
+  if (prev == spin_sec) return;
+  last_dump_at.store(spin_sec);
+  std::uint64_t have = evt ? evt->signaledValue() : 0;
+  std::cerr << "STALL_HUNT_HOST_WAIT_SPIN sec=" << spin_sec
+            << " want=" << want << " have=" << have
+            << " delta=" << (want > have ? want - have : 0) << std::endl;
+  dump_table("host_wait_spin", evt);
+}

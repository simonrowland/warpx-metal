+#include "hipSYCL/runtime/metal/metal_wait_result.hpp"
+
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <string>
+
+namespace {
+
+using hipsycl::rt::capture_metal_command_buffer_wait_result;
+using hipsycl::rt::error_info;
+using hipsycl::rt::make_error;
+using hipsycl::rt::metal_async_error_state;
+using hipsycl::rt::read_metal_async_failure;
+using hipsycl::rt::result;
+using hipsycl::rt::source_location;
+
+enum class fake_command_buffer_status { completed, error };
+
+void require(bool condition, const char* message) {
+  if (!condition) {
+    std::cerr << "METAL_WAIT_RESULT_TESTS_FAIL: " << message << '\n';
+    std::exit(1);
+  }
+}
+
+result failure(const char* text) {
+  return make_error(source_location{"metal-wait-test", "metal-wait-test", 1},
+                    error_info{text});
+}
+
+result capture(const std::shared_ptr<metal_async_error_state>& state,
+               bool completed, fake_command_buffer_status status) {
+  return capture_metal_command_buffer_wait_result(
+      state, completed, status == fake_command_buffer_status::error,
+      [] { return failure("timeout failure"); },
+      [] { return failure("command-buffer error"); });
+}
+
+void test_timeout_latches_for_later_wait() {
+  auto state = std::make_shared<metal_async_error_state>();
+  auto completion =
+      capture(state, false, fake_command_buffer_status::completed);
+  require(!completion.is_success(), "timeout classification returned success");
+  const auto later_wait = read_metal_async_failure(state);
+  require(!later_wait.is_success(), "later wait forgot the timeout failure");
+  require(later_wait.what().find("timeout failure") != std::string::npos,
+          "later wait returned the wrong timeout failure");
+}
+
+void test_error_status_latches_for_later_wait() {
+  auto state = std::make_shared<metal_async_error_state>();
+  auto completion = capture(state, true, fake_command_buffer_status::error);
+  require(!completion.is_success(),
+          "command-buffer error status returned success");
+  const auto later_wait = read_metal_async_failure(state);
+  require(!later_wait.is_success(),
+          "later wait forgot the command-buffer error");
+  require(later_wait.what().find("command-buffer error") != std::string::npos,
+          "later wait returned the wrong command-buffer error");
+}
+
+void test_success_does_not_poison_later_wait() {
+  auto state = std::make_shared<metal_async_error_state>();
+  auto completion = capture(state, true, fake_command_buffer_status::completed);
+  require(completion.is_success(), "completed status returned failure");
+  require(read_metal_async_failure(state).is_success(),
+          "completed status poisoned a later wait");
+}
+
+void test_first_failure_remains_sticky() {
+  auto state = std::make_shared<metal_async_error_state>();
+  capture(state, false, fake_command_buffer_status::completed);
+  capture(state, true, fake_command_buffer_status::error);
+  const auto later_wait = read_metal_async_failure(state);
+  require(later_wait.what().find("timeout failure") != std::string::npos,
+          "a later failure replaced the first sticky failure");
+}
+
+} // namespace
+
+int main() {
+  test_timeout_latches_for_later_wait();
+  test_error_status_latches_for_later_wait();
+  test_success_does_not_poison_later_wait();
+  test_first_failure_remains_sticky();
+  std::cout << "METAL_WAIT_RESULT_TESTS_PASS\n";
+  return 0;
+}

@@ -0,0 +1,104 @@
+/*
+ * This file is part of AdaptiveCpp, an implementation of SYCL and C++ standard
+ * parallelism for CPUs and GPUs.
+ *
+ * Copyright The AdaptiveCpp Contributors
+ *
+ * AdaptiveCpp is released under the BSD 2-Clause "Simplified" License.
+ * See file LICENSE in the project root for full license details.
+ */
+// SPDX-License-Identifier: BSD-2-Clause
+#define NS_PRIVATE_IMPLEMENTATION
+#define CA_PRIVATE_IMPLEMENTATION
+#define MTL_PRIVATE_IMPLEMENTATION
+
+#include "hipSYCL/runtime/application.hpp"
+#include "hipSYCL/runtime/async_errors.hpp"
+#include "hipSYCL/runtime/metal/metal_command_buffer_status.hpp"
+#include "hipSYCL/runtime/metal/metal_event.hpp"
+
+#include <Metal/Metal.hpp>
+
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <string>
+
+extern "C" void stall_hunt_note_host_wait_c(
+    void*, unsigned long long, int) {}
+
+namespace {
+
+hipsycl::rt::result failure(const char* text) {
+  return hipsycl::rt::make_error(
+      hipsycl::rt::source_location{"metal-integration-test",
+                                   "metal-integration-test", 1},
+      hipsycl::rt::error_info{text});
+}
+
+} // namespace
+
+int main() {
+  hipsycl::rt::application::errors().pop_each_error(
+      [](const hipsycl::rt::result&) {});
+
+  auto* pool = NS::AutoreleasePool::alloc()->init();
+  auto* device = MTL::CreateSystemDefaultDevice();
+  if (!device) {
+    std::cerr << "METAL_EVENT_TIMEOUT_TEST_FAIL: no Metal device\n";
+    pool->release();
+    return 2;
+  }
+
+  auto* shared_event = device->newSharedEvent();
+  if (!shared_event) {
+    std::cerr << "METAL_EVENT_TIMEOUT_TEST_FAIL: no shared event\n";
+    device->release();
+    pool->release();
+    return 3;
+  }
+
+  {
+    hipsycl::rt::metal_node_event event{
+        hipsycl::rt::metal_event_handle{shared_event, 1}};
+    event.wait();
+  }
+
+  int error_count = 0;
+  std::string error_text;
+  hipsycl::rt::application::errors().pop_each_error(
+      [&](const hipsycl::rt::result& error) {
+        ++error_count;
+        error_text = error.what();
+      });
+
+  shared_event->release();
+  device->release();
+  pool->release();
+
+  if (error_count != 1 ||
+      error_text.find("timed out after 1 ms") == std::string::npos ||
+      error_text.find("shared-event value 1") == std::string::npos) {
+    std::cerr << "METAL_EVENT_TIMEOUT_TEST_FAIL: count=" << error_count
+              << " error=" << error_text << '\n';
+    return 1;
+  }
+
+  auto state = std::make_shared<hipsycl::rt::metal_async_error_state>();
+  auto completion = hipsycl::rt::capture_metal_command_buffer_wait_result(
+      state, true, MTL::CommandBufferStatusError,
+      [] { return failure("unexpected timeout"); },
+      [] { return failure("command-buffer error"); });
+  const auto later_wait = hipsycl::rt::read_metal_async_failure(state);
+  if (completion.is_success() || later_wait.is_success() ||
+      later_wait.what().find("command-buffer error") == std::string::npos ||
+      hipsycl::rt::metal_command_buffer_status_is_error(
+          MTL::CommandBufferStatusCompleted)) {
+    std::cerr << "METAL_EVENT_TIMEOUT_TEST_FAIL: error status was not "
+                 "sticky\n";
+    return 1;
+  }
+
+  std::cout << "METAL_EVENT_TIMEOUT_TEST_PASS\n";
+  return 0;
+}
diff --git a/tests/runtime/metal_timeout.cpp b/tests/runtime/metal_timeout.cpp
new file mode 100644
index 0000000..b6e6f6c
--- /dev/null
+++ b/tests/runtime/metal_timeout.cpp
@@ -0,0 +1,210 @@
+/*
+ * This file is part of AdaptiveCpp, an implementation of SYCL and C++ standard
+ * parallelism for CPUs and GPUs.
+ *
+ * Copyright The AdaptiveCpp Contributors
+ *
+ * AdaptiveCpp is released under the BSD 2-Clause "Simplified" License.
+ * See file LICENSE in the project root for full license details.
+ */
+// SPDX-License-Identifier: BSD-2-Clause
+#include "metal_timeout.hpp"
+
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace {
+
+using milliseconds = std::chrono::milliseconds;
+using hipsycl::rt::detail::metal_command_timeout_default_ms;
+using hipsycl::rt::detail::metal_command_timeout_policy_max_ms;
+using hipsycl::rt::detail::parse_metal_command_timeout;
+using hipsycl::rt::detail::wait_until_metal_event_deadline;
+
+struct fake_steady_clock {
+  using duration = std::chrono::microseconds;
+  using rep = duration::rep;
+  using period = duration::period;
+  using time_point = std::chrono::time_point<fake_steady_clock>;
+  static constexpr bool is_steady = true;
+
+  static time_point now() noexcept { return current; }
+  static time_point current;
+};
+
+fake_steady_clock::time_point fake_steady_clock::current{};
+
+void require(bool condition, const char* message) {
+  if (!condition) {
+    std::cerr << "METAL_TIMEOUT_TESTS_FAIL: " << message << '\n';
+    std::exit(1);
+  }
+}
+
+void expect_rejected(const char* value) {
+  const auto parsed = parse_metal_command_timeout(value);
+  require(!parsed.accepted, "invalid timeout was accepted");
+  require(parsed.timeout == milliseconds{metal_command_timeout_default_ms},
+          "invalid timeout did not select the default");
+}
+
+void test_parsing() {
+  const auto missing = parse_metal_command_timeout(nullptr);
+  require(missing.accepted, "missing timeout did not accept the default");
+  require(missing.timeout == milliseconds{metal_command_timeout_default_ms},
+          "missing timeout did not select the default");
+
+  expect_rejected("");
+  expect_rejected("   ");
+  expect_rejected(" 5");
+  expect_rejected("5 ");
+  expect_rejected("+5");
+  expect_rejected("-1");
+  expect_rejected("18446744073709551616");
+  expect_rejected("0");
+  expect_rejected("not-a-number");
+  expect_rejected("2501ms");
+
+  const auto exact_cap = parse_metal_command_timeout("86400000");
+  require(exact_cap.accepted, "exact 24-hour cap was rejected");
+  require(exact_cap.timeout == milliseconds{metal_command_timeout_policy_max_ms},
+          "exact 24-hour cap changed value");
+  expect_rejected("86400001");
+
+  errno = ERANGE;
+  const auto stale_errno = parse_metal_command_timeout("5");
+  require(stale_errno.accepted,
+          "valid timeout inherited a stale ERANGE value");
+  require(stale_errno.timeout == milliseconds{5},
+          "valid timeout with stale errno changed value");
+
+  const auto one = parse_metal_command_timeout("1");
+  require(one.accepted, "1 ms timeout was rejected");
+  require(one.timeout == milliseconds{1}, "1 ms timeout changed value");
+
+  const auto multi_slice = parse_metal_command_timeout("2501");
+  require(multi_slice.accepted, "multi-slice timeout was rejected");
+  require(multi_slice.timeout == milliseconds{2501},
+          "multi-slice timeout changed value");
+}
+
+void test_normal_multi_slice_wait() {
+  fake_steady_clock::current = {};
+  const auto timeout = parse_metal_command_timeout("2501").timeout;
+  const auto deadline = fake_steady_clock::now() + timeout;
+  std::vector<milliseconds::rep> slices;
+  const bool signaled = wait_until_metal_event_deadline<fake_steady_clock>(
+      deadline, [&slices](milliseconds slice) {
+        slices.push_back(slice.count());
+        fake_steady_clock::current += slice;
+        return false;
+      });
+  require(!signaled, "unsignaled multi-slice wait reported completion");
+  require((slices == std::vector<milliseconds::rep>{1000, 1000, 501}),
+          "multi-slice wait did not clamp to the absolute deadline");
+}
+
+void test_positive_fractional_remaining_rounds_to_one_ms() {
+  fake_steady_clock::current = {};
+  const auto deadline = fake_steady_clock::now() + milliseconds{1};
+  fake_steady_clock::current += std::chrono::microseconds{100};
+  std::vector<milliseconds::rep> slices;
+  const bool signaled = wait_until_metal_event_deadline<fake_steady_clock>(
+      deadline, [&slices](milliseconds slice) {
+        slices.push_back(slice.count());
+        fake_steady_clock::current += slice;
+        return false;
+      });
+  require(!signaled, "unsignaled 1 ms wait reported completion");
+  require((slices == std::vector<milliseconds::rep>{1}),
+          "positive sub-millisecond remainder skipped the Metal wait");
+}
+
+void test_invalid_timeout_unsignaled_wait_uses_default_deadline() {
+  const auto parsed = parse_metal_command_timeout("-1");
+  require(!parsed.accepted, "signed timeout was accepted");
+  require(parsed.timeout == milliseconds{metal_command_timeout_default_ms},
+          "signed timeout did not select the default");
+
+  fake_steady_clock::current = {};
+  const auto started_at = fake_steady_clock::now();
+  const auto deadline = started_at + parsed.timeout;
+  milliseconds::rep total_requested = 0;
+  int wait_calls = 0;
+  const bool signaled = wait_until_metal_event_deadline<fake_steady_clock>(
+      deadline, [&total_requested, &wait_calls](milliseconds slice) {
+        ++wait_calls;
+        total_requested += slice.count();
+        fake_steady_clock::current += slice;
+        return false;
+      });
+  require(!signaled, "invalid-timeout unsignaled wait reported completion");
+  require(fake_steady_clock::now() - started_at ==
+              milliseconds{metal_command_timeout_default_ms},
+          "invalid-timeout wait did not reach the default deadline");
+  require(total_requested == metal_command_timeout_default_ms,
+          "invalid-timeout wait requested the wrong total duration");
+  require(wait_calls == 120,
+          "invalid-timeout wait did not use bounded one-second slices");
+}
+
+void test_scheduler_overhead_reduces_later_slices() {
+  fake_steady_clock::current = {};
+  const auto deadline = fake_steady_clock::now() + milliseconds{2501};
+  std::vector<milliseconds::rep> slices;
+  const bool signaled = wait_until_metal_event_deadline<fake_steady_clock>(
+      deadline, [&slices](milliseconds slice) {
+        slices.push_back(slice.count());
+        fake_steady_clock::current += slice + milliseconds{17};
+        return false;
+      });
+  require(!signaled, "overhead simulation reported completion");
+  require((slices == std::vector<milliseconds::rep>{1000, 1000, 467}),
+          "scheduler overhead was not deducted from remaining time");
+}
+
+void set_environment(const char* key, const char* value) {
+#if defined(_WIN32)
+  require(_putenv_s(key, value) == 0, "failed to set test environment");
+#else
+  require(setenv(key, value, 1) == 0, "failed to set test environment");
+#endif
+}
+
+int check_cached_accessor(const char* first_value, const char* second_value,
+                          const char* expected_value) {
+  set_environment("ACPP_METAL_EVENT_WAIT_TIMEOUT_SEC", "7");
+  set_environment("ACPP_METAL_COMMAND_TIMEOUT_MS", first_value);
+  const auto first = hipsycl::rt::metal_command_timeout();
+
+  set_environment("ACPP_METAL_COMMAND_TIMEOUT_MS", second_value);
+  const auto second = hipsycl::rt::metal_command_timeout();
+  const auto expected = milliseconds{std::strtoll(expected_value, nullptr, 10)};
+
+  require(first == expected,
+          "cached accessor ignored the command-timeout environment key or fallback");
+  require(second == expected,
+          "cached accessor was not one-shot after the environment changed");
+  std::cout << "METAL_TIMEOUT_ACCESSOR_TEST_PASS\n";
+  return 0;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+  if (argc == 5 && std::string{argv[1]} == "--check-accessor") {
+    return check_cached_accessor(argv[2], argv[3], argv[4]);
+  }
+  require(argc == 1, "unknown test arguments");
+  test_parsing();
+  test_normal_multi_slice_wait();
+  test_positive_fractional_remaining_rounds_to_one_ms();
+  test_invalid_timeout_unsignaled_wait_uses_default_deadline();
+  test_scheduler_overhead_reduces_later_slices();
+  std::cout << "METAL_TIMEOUT_TESTS_PASS\n";
+  return 0;
+}

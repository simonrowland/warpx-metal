diff --git a/src/runtime/metal/metal_timeout.hpp b/src/runtime/metal/metal_timeout.hpp
new file mode 100644
index 0000000..9c9ce1d
--- /dev/null
+++ b/src/runtime/metal/metal_timeout.hpp
@@ -0,0 +1,107 @@
+/*
+ * This file is part of AdaptiveCpp, an implementation of SYCL and C++ standard
+ * parallelism for CPUs and GPUs.
+ *
+ * Copyright The AdaptiveCpp Contributors
+ *
+ * AdaptiveCpp is released under the BSD 2-Clause "Simplified" License.
+ * See file LICENSE in the project root for full license details.
+ */
+// SPDX-License-Identifier: BSD-2-Clause
+#ifndef HIPSYCL_METAL_TIMEOUT_HPP
+#define HIPSYCL_METAL_TIMEOUT_HPP
+
+#include "hipSYCL/common/debug.hpp"
+
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+
+namespace hipsycl {
+namespace rt {
+namespace detail {
+
+constexpr unsigned long long metal_command_timeout_default_ms = 120'000;
+constexpr unsigned long long metal_command_timeout_policy_max_ms =
+    24ULL * 60 * 60 * 1'000;
+constexpr std::chrono::milliseconds metal_event_max_wait_slice{1'000};
+
+struct metal_command_timeout_parse_result {
+  std::chrono::milliseconds timeout;
+  bool accepted;
+};
+
+inline metal_command_timeout_parse_result
+parse_metal_command_timeout(const char* value) {
+  const auto fallback = std::chrono::milliseconds{
+      static_cast<std::chrono::milliseconds::rep>(
+          metal_command_timeout_default_ms)};
+  if (!value || *value == '\0') {
+    return {fallback, value == nullptr};
+  }
+
+  for (const char* digit = value; *digit != '\0'; ++digit) {
+    if (*digit < '0' || *digit > '9') {
+      return {fallback, false};
+    }
+  }
+
+  errno = 0;
+  char* end = nullptr;
+  const auto requested = std::strtoull(value, &end, 10);
+  const auto duration_max = static_cast<unsigned long long>(
+      std::chrono::milliseconds::max().count());
+  if (errno == ERANGE || end == value || *end != '\0' || requested == 0 ||
+      requested > duration_max ||
+      requested > metal_command_timeout_policy_max_ms) {
+    return {fallback, false};
+  }
+
+  return {std::chrono::milliseconds{
+              static_cast<std::chrono::milliseconds::rep>(requested)},
+          true};
+}
+
+template <class Clock = std::chrono::steady_clock, class WaitForSlice>
+bool wait_until_metal_event_deadline(
+    typename Clock::time_point deadline, WaitForSlice&& wait_for_slice) {
+  while (true) {
+    const auto now = Clock::now();
+    if (now >= deadline) {
+      return false;
+    }
+    const auto remaining_duration = deadline - now;
+    auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+        remaining_duration);
+    if (remaining < remaining_duration) {
+      remaining += std::chrono::milliseconds{1};
+    }
+    const auto slice = remaining < metal_event_max_wait_slice
+                           ? remaining
+                           : metal_event_max_wait_slice;
+    if (wait_for_slice(slice)) {
+      return true;
+    }
+  }
+}
+
+} // namespace detail
+
+inline std::chrono::milliseconds metal_command_timeout() {
+  static const auto timeout = [] {
+    const auto parsed = detail::parse_metal_command_timeout(
+        std::getenv("ACPP_METAL_COMMAND_TIMEOUT_MS"));
+    if (!parsed.accepted) {
+      HIPSYCL_DEBUG_WARNING
+          << "Rejected invalid ACPP_METAL_COMMAND_TIMEOUT_MS value; using "
+          << detail::metal_command_timeout_default_ms << " ms default\n";
+    }
+    return parsed.timeout;
+  }();
+  return timeout;
+}
+
+} // namespace rt
+} // namespace hipsycl
+
+#endif // HIPSYCL_METAL_TIMEOUT_HPP

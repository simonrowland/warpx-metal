diff --git a/include/hipSYCL/runtime/metal/metal_wait_result.hpp b/include/hipSYCL/runtime/metal/metal_wait_result.hpp
new file mode 100644
index 0000000..0997512
--- /dev/null
+++ b/include/hipSYCL/runtime/metal/metal_wait_result.hpp
@@ -0,0 +1,83 @@
+/*
+ * This file is part of AdaptiveCpp, an implementation of SYCL and C++ standard
+ * parallelism for CPUs and GPUs.
+ *
+ * Copyright The AdaptiveCpp Contributors
+ *
+ * AdaptiveCpp is released under the BSD 2-Clause "Simplified" License.
+ * See file LICENSE in the project root for full license details.
+ */
+// SPDX-License-Identifier: BSD-2-Clause
+#ifndef HIPSYCL_METAL_WAIT_RESULT_HPP
+#define HIPSYCL_METAL_WAIT_RESULT_HPP
+
+#include "hipSYCL/runtime/error.hpp"
+
+#include <memory>
+#include <mutex>
+#include <utility>
+
+namespace hipsycl {
+namespace rt {
+
+// Command-buffer completion handlers run asynchronously and may outlive the
+// queue that submitted them, so the sink is held by shared_ptr and captured by
+// value. Keeping the sink and its wait-result policy independent of Metal makes
+// the fail-closed behavior directly testable.
+struct metal_async_error_state {
+  std::mutex mutex;
+  result error;
+};
+
+inline result read_metal_async_failure(
+    const std::shared_ptr<metal_async_error_state>& state) {
+  std::lock_guard<std::mutex> lock{state->mutex};
+  return state->error;
+}
+
+// Records the first asynchronous failure so that a later queue wait can fail
+// closed. Also forwards every failure to the global async error list.
+inline void record_metal_async_failure(
+    const std::shared_ptr<metal_async_error_state>& state, result failure) {
+  if (state) {
+    std::lock_guard<std::mutex> lock{state->mutex};
+    if (state->error.is_success()) {
+      state->error = failure;
+    }
+  }
+  register_error(failure);
+}
+
+template <class TimeoutFailureFactory, class ErrorFailureFactory>
+result classify_metal_command_buffer_wait_result(
+    bool completed, bool command_buffer_failed,
+    TimeoutFailureFactory&& timeout_failure,
+    ErrorFailureFactory&& error_failure) {
+  if (!completed) {
+    return std::forward<TimeoutFailureFactory>(timeout_failure)();
+  }
+  if (command_buffer_failed) {
+    return std::forward<ErrorFailureFactory>(error_failure)();
+  }
+  return make_success();
+}
+
+template <class TimeoutFailureFactory, class ErrorFailureFactory>
+result capture_metal_command_buffer_wait_result(
+    const std::shared_ptr<metal_async_error_state>& state, bool completed,
+    bool command_buffer_failed, TimeoutFailureFactory&& timeout_failure,
+    ErrorFailureFactory&& error_failure) {
+  auto completion = classify_metal_command_buffer_wait_result(
+      completed, command_buffer_failed,
+      std::forward<TimeoutFailureFactory>(timeout_failure),
+      std::forward<ErrorFailureFactory>(error_failure));
+  if (!completion.is_success()) {
+    record_metal_async_failure(state, completion);
+  }
+  return completion;
+}
+
+} // namespace rt
+} // namespace hipsycl
+
+#endif // HIPSYCL_METAL_WAIT_RESULT_HPP

+        case 1: return at<1>();
+        case 2: return at<2>();
+        case 3: return at<3>();
+        case 4: return at<4>();
+        case 5: return at<5>();
+        case 6: return at<6>();
+        default: return 0.0;
+        }
+    }
+
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    double old(const int slot) const
+    {
+        switch (slot) {
+        case 0: return Compute_esirkepov_shape_value<depos_order>{}.old_value(x_old, i_new, 0, reduced_old);
+        case 1: return Compute_esirkepov_shape_value<depos_order>{}.old_value(x_old, i_new, 1, reduced_old);
+        case 2: return Compute_esirkepov_shape_value<depos_order>{}.old_value(x_old, i_new, 2, reduced_old);
+        case 3: return Compute_esirkepov_shape_value<depos_order>{}.old_value(x_old, i_new, 3, reduced_old);
+        case 4: return Compute_esirkepov_shape_value<depos_order>{}.old_value(x_old, i_new, 4, reduced_old);
+        case 5: return Compute_esirkepov_shape_value<depos_order>{}.old_value(x_old, i_new, 5, reduced_old);
+        case 6: return Compute_esirkepov_shape_value<depos_order>{}.old_value(x_old, i_new, 6, reduced_old);
+        default: return 0.0;
+        }
+    }
+};

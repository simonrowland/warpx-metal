+{
+    template <typename T>
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    T new_value(const T x_new, const int i_new, const int slot, const bool reduced) const
+    {
+        return reduced
+            ? Compute_shifted_shape_factor_value<1>{}(x_new, i_new, slot)
+            : Compute_shape_factor_value<depos_order>{}(x_new, slot);
+    }
+
+    template <typename T>
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    T old_value(const T x_old, const int i_new, const int slot, const bool reduced) const
+    {
+        return reduced
+            ? Compute_shifted_shape_factor_value<1>{}(x_old, i_new, slot)
+            : Compute_shifted_shape_factor_value<depos_order>{}(x_old, i_new, slot);
+    }
+};
+
+/**
+ * Per-particle scalar view of the two Esirkepov shape arrays.  `operator[]`
+ * returns the value that upstream stores in the new-position array at the
+ * requested literal deposition slot; `old(slot)` returns the corresponding
+ * shifted old-position slot.  The object contains no local array, so a
+ * runtime loop index cannot address Metal local memory.  `i_new` and the two
+ * reduction flags are the same values used by the upstream array path.
+ */
+template <int depos_order, bool use_old = false>

new file mode 100644
index 000000000..e1060dfc0
--- /dev/null
+++ b/Source/Particles/ShapeFactorValues.H
@@ -0,0 +1,306 @@
+/* Scalar shape-factor accessors for the Metal-safe Esirkepov path. */
+#ifndef WARPX_SHAPEFACTORVALUES_H_
+#define WARPX_SHAPEFACTORVALUES_H_
+
+#include <cmath>
+
+/** Return the leftmost shape-factor index without writing a local array. */
+template <int depos_order>
+struct Compute_shape_factor_index
+{
+    template <typename T>
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    int operator()(const T xmid) const
+    {
+        if constexpr (depos_order == 0) {
+            return static_cast<int>(xmid + T(0.5));
+        } else if constexpr (depos_order == 1) {
+            return static_cast<int>(xmid);
+        } else if constexpr (depos_order == 2) {
+            return static_cast<int>(xmid + T(0.5)) - 1;
+        } else if constexpr (depos_order == 3) {
+            return static_cast<int>(xmid) - 1;
+        } else if constexpr (depos_order == 4) {
+            return static_cast<int>(xmid + T(0.5)) - 2;
+        } else {
+            WARPX_ABORT_WITH_MESSAGE("Unknown particle shape selected in Compute_shape_factor_index");
+            amrex::ignore_unused(xmid);
+        }
+        return 0;
+    }
+};
+
+/**
+ * Return the leftmost index returned by upstream Compute_shifted_shape_factor.
+ * The shifted array is based at the new position, but the current deposition
+ * bounds also use the old helper's returned base: i for orders 0/1, i-1 for
+ * orders 2/3, and i-2 for order 4.  Keeping this separate from the regular
+ * shape base preserves those upstream cell coordinates without an array.
+ */
+template <int depos_order>
+struct Compute_shifted_shape_factor_index
+{
+    template <typename T>
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    int operator()(const T x_old) const
+    {
+        if constexpr (depos_order == 0) {
+            return static_cast<int>(std::floor(x_old + T(0.5)));
+        } else if constexpr (depos_order == 1) {
+            return static_cast<int>(std::floor(x_old));
+        } else if constexpr (depos_order == 2 || depos_order == 3) {
+            const int i = (depos_order == 2)
+                ? static_cast<int>(x_old + T(0.5))
+                : static_cast<int>(x_old);
+            return i - 1;
+        } else if constexpr (depos_order == 4) {
+            return static_cast<int>(x_old + T(0.5)) - 2;
+        } else {
+            WARPX_ABORT_WITH_MESSAGE("Unknown particle shape selected in Compute_shifted_shape_factor_index");
+            amrex::ignore_unused(x_old);
+        }
+        return 0;
+    }
+};
+
+/**
+ * Return one new-position shape factor for an array slot, without an array.
+ * Upstream calls Compute_shape_factor(sx_new + 1, x_new), so its compact
+ * weights w[n] occupy slot 1+n; the +1 is part of the deposition index base,
+ * not a change to the shape values.  Thus the slot mapping is dimensionless
+ * weight w[n] -> slot 1+n, with the unused surrounding slots equal to zero.
+ */
+template <int depos_order>
+struct Compute_shape_factor_value
+{
+    template <typename T>
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    T operator()(const T xmid, const int slot) const
+    {
+        // Compute_shape_factor returns the leftmost deposition base, but its
+        // compact weights are evaluated around the integer center j.  For
+        // orders 2 and 4 the returned base is j-1/j-2, and for order 3 it is
+        // j-1; using the returned base here would shift xint by one or two
+        // cells.  Reproduce the upstream j expression used before returning
+        // the base, while the slot mapping below remains sx_new[1+n] = w[n].
+        int i = 0;
+        if constexpr (depos_order == 0 || depos_order == 2 || depos_order == 4) {
+            i = static_cast<int>(xmid + T(0.5));
+        } else {
+            i = static_cast<int>(xmid);
+        }
+        const T xint = xmid - T(i);
+        if constexpr (depos_order == 0) {
+            return (slot == 1) ? T(1.0) : T(0.0);
+        } else if constexpr (depos_order == 1) {
+            const T w0 = T(1.0) - xint;
+            const T w1 = xint;
+            return (slot == 1) ? w0 : ((slot == 2) ? w1 : T(0.0));
+        } else if constexpr (depos_order == 2) {
+            const T w0 = T(0.5)*(T(0.5) - xint)*(T(0.5) - xint);
+            const T w1 = T(0.75) - xint*xint;
+            const T w2 = T(0.5)*(T(0.5) + xint)*(T(0.5) + xint);
+            return (slot == 1) ? w0 : ((slot == 2) ? w1 : ((slot == 3) ? w2 : T(0.0)));
+        } else if constexpr (depos_order == 3) {
+            const T w0 = (T(1.0))/(T(6.0))*(T(1.0) - xint)*(T(1.0) - xint)*(T(1.0) - xint);
+            const T w1 = (T(2.0))/(T(3.0)) - xint*xint*(T(1.0) - xint/(T(2.0)));
+            const T w2 = (T(2.0))/(T(3.0)) - (T(1.0) - xint)*(T(1.0) - xint)*(T(1.0) - T(0.5)*(T(1.0) - xint));
+            const T w3 = (T(1.0))/(T(6.0))*xint*xint*xint;
+            return (slot == 1) ? w0 : ((slot == 2) ? w1 : ((slot == 3) ? w2 : ((slot == 4) ? w3 : T(0.0))));
+        } else if constexpr (depos_order == 4) {
+            const T w0 = (T(1.0))/(T(24.0))*(T(0.5) - xint)*(T(0.5) - xint)*(T(0.5) - xint)*(T(0.5) - xint);
+            const T w1 = (T(1.0))/(T(24.0))*(T(4.75) - T(11.0)*xint + T(4.0)*xint*xint*(T(1.5) + xint - xint*xint));
+            const T w2 = (T(1.0))/(T(24.0))*(T(14.375) + T(6.0)*xint*xint*(xint*xint - T(2.5)));
+            const T w3 = (T(1.0))/(T(24.0))*(T(4.75) + T(11.0)*xint + T(4.0)*xint*xint*(T(1.5) - xint - xint*xint));
+            const T w4 = (T(1.0))/(T(24.0))*(T(0.5) + xint)*(T(0.5) + xint)*(T(0.5) + xint)*(T(0.5)+xint);
+            return (slot == 1) ? w0 : ((slot == 2) ? w1 : ((slot == 3) ? w2 : ((slot == 4) ? w3 : ((slot == 5) ? w4 : T(0.0)))));
+        } else {
+            WARPX_ABORT_WITH_MESSAGE("Unknown particle shape selected in Compute_shape_factor_value");
+            amrex::ignore_unused(xmid, slot);
+        }
+        return T(0.0);
+    }
+};
+
+/**
+ * Return one shifted old-position shape factor for an array slot, without an
+ * array. This is the scalar expansion of the upstream rule
+ * `sx[1+i_shift+n] = w[n]`.  The caller's literal slot range determines which
+ * of those placements are visible; this is also used to express the reduced
+ * order-1 stencil after its shifted pointer is algebraically cancelled.
+ */
+template <int depos_order>
+struct Compute_shifted_shape_factor_value
+{
+    template <typename T>
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    T operator()(const T x_old, const int i_new, const int slot) const
+    {
+        if constexpr (depos_order == 0) {
+            const int i = static_cast<int>(std::floor(x_old + T(0.5)));
+            const int i_shift = i - i_new;
+            return (((slot == 0) && (i_shift == -1)) || ((slot == 1) && (i_shift == 0)) || ((slot == 2) && (i_shift == 1)))
+                ? T(1.0) : T(0.0);
+        } else if constexpr (depos_order == 1) {
+            const int i = static_cast<int>(std::floor(x_old));
+            const int i_shift = i - i_new;
+            const T xint = x_old - T(i);
+            const T w0 = T(1.0) - xint;
+            const T w1 = xint;
+            // Keep the upstream placement rule literal in the slot, rather
+            // than clamping i_shift to {-1,0,1}.  The reduced-shape branch
+            // passes the high-order base and absolute array slot: its shifted
+            // pointer cancels algebraically, but its order-1 stencil can then
+            // appear at absolute shifts 0..depos_order.  For the ordinary
+            // path this reduces exactly to the three contracted shifts.
+            return (slot == 1 + i_shift) ? w0
+                : ((slot == 2 + i_shift) ? w1 : T(0.0));
+        } else if constexpr (depos_order == 2) {
+            const int i = static_cast<int>(x_old + T(0.5));
+            const int i_shift = i - (i_new + 1);
+            const T xint = x_old - T(i);
+            const T w0 = T(0.5)*(T(0.5) - xint)*(T(0.5) - xint);
+            const T w1 = T(0.75) - xint*xint;
+            const T w2 = T(0.5)*(T(0.5) + xint)*(T(0.5) + xint);
+            return (slot == 0) ? ((i_shift == -1) ? w0 : T(0.0))
+                : (slot == 1) ? ((i_shift == -1) ? w1 : ((i_shift == 0) ? w0 : T(0.0)))
+                : (slot == 2) ? ((i_shift == -1) ? w2 : ((i_shift == 0) ? w1 : ((i_shift == 1) ? w0 : T(0.0))))
+                : (slot == 3) ? ((i_shift == 0) ? w2 : ((i_shift == 1) ? w1 : T(0.0)))
+                : (slot == 4) ? ((i_shift == 1) ? w2 : T(0.0)) : T(0.0);
+        } else if constexpr (depos_order == 3) {
+            const int i = static_cast<int>(x_old);
+            const int i_shift = i - (i_new + 1);
+            const T xint = x_old - T(i);
+            const T w0 = (T(1.0))/(T(6.0))*(T(1.0) - xint)*(T(1.0) - xint)*(T(1.0) - xint);
+            const T w1 = (T(2.0))/(T(3.0)) - xint*xint*(T(1.0) - xint/(T(2.0)));
+            const T w2 = (T(2.0))/(T(3.0)) - (T(1.0) - xint)*(T(1.0) - xint)*(T(1.0) - T(0.5)*(T(1.0) - xint));
+            const T w3 = (T(1.0))/(T(6.0))*xint*xint*xint;
+            return (slot == 0) ? ((i_shift == -1) ? w0 : T(0.0))
+                : (slot == 1) ? ((i_shift == -1) ? w1 : ((i_shift == 0) ? w0 : T(0.0)))
+                : (slot == 2) ? ((i_shift == -1) ? w2 : ((i_shift == 0) ? w1 : ((i_shift == 1) ? w0 : T(0.0))))
+                : (slot == 3) ? ((i_shift == -1) ? w3 : ((i_shift == 0) ? w2 : ((i_shift == 1) ? w1 : T(0.0))))
+                : (slot == 4) ? ((i_shift == 0) ? w3 : ((i_shift == 1) ? w2 : T(0.0)))
+                : (slot == 5) ? ((i_shift == 1) ? w3 : T(0.0)) : T(0.0);
+        } else if constexpr (depos_order == 4) {
+            const int i = static_cast<int>(x_old + T(0.5));
+            const int i_shift = i - (i_new + 2);
+            const T xint = x_old - T(i);
+            const T w0 = (T(1.0))/(T(24.0))*(T(0.5) - xint)*(T(0.5) - xint)*(T(0.5) - xint)*(T(0.5) - xint);
+            const T w1 = (T(1.0))/(T(24.0))*(T(4.75) - T(11.0)*xint + T(4.0)*xint*xint*(T(1.5) + xint - xint*xint));

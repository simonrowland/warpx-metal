+                const bool exhausts_parent = actual_removed > 0.0 &&
+                    consumed_weight[parent] + removal_tolerance >= actual_removed;
+                if (invalid_seen[parent] == 0 && exhausts_parent &&
+                    !amrex::ParticleIDWrapper{h_idcpu[parent]}.is_valid()) {

+        // The collision functor and copy transform operate on device data and
+        // may invalidate a parent or reduce its weight.  Copy the reaction
+        // evidence back after that transform, before deleteInvalidParticles,
+        // and accumulate in host double precision.  This avoids unsupported
+        // Metal FP64 atomics and records the actual consumed macro-weight,
+        // including partial-weight reactions.
+        auto record_destroyed = [this] (
+            WarpXParticleContainer const& species,
+            ParticleTileType const& ptile,
+            index_type const* mask,
+            index_type const* indices,
+            index_type n_pairs,
+            amrex::ParticleReal mass,
+            int reaction_mask,
+            amrex::Gpu::HostVector<amrex::ParticleReal> const& before_weight,
+            amrex::Gpu::HostVector<amrex::ParticleReal> const& before_ux,
+            amrex::Gpu::HostVector<amrex::ParticleReal> const& before_uy,
+            amrex::Gpu::HostVector<amrex::ParticleReal> const& before_uz,
+            amrex::Gpu::HostVector<amrex::ParticleReal> const& reaction_weight,
+            std::vector<double>& consumed_weight,
+            std::vector<unsigned char>& invalid_seen)
+        {
+            if (!ParticleCreationDiag::Active() ||
+                (m_creation_channel.empty() && m_creation_split_channel.empty()) ||
+                n_pairs <= 0) {
+                return;
+            }
+
+            amrex::Gpu::synchronize();
+            amrex::Gpu::HostVector<index_type> h_mask(n_pairs);
+            amrex::Gpu::HostVector<index_type> h_indices(n_pairs);
+            amrex::Gpu::copy(amrex::Gpu::deviceToHost, mask, mask + n_pairs, h_mask.begin());
+            amrex::Gpu::copy(amrex::Gpu::deviceToHost, indices, indices + n_pairs, h_indices.begin());
+
+            const auto& ptd = ptile.getConstParticleTileData();
+            const auto n_particles = static_cast<std::size_t>(ptile.numParticles());
+            amrex::Gpu::HostVector<amrex::ParticleReal> h_weight(n_particles);
+            amrex::Gpu::HostVector<uint64_t> h_idcpu(n_particles);
+            amrex::Gpu::copy(amrex::Gpu::deviceToHost, ptd.m_idcpu,
+                             ptd.m_idcpu + n_particles, h_idcpu.begin());
+            amrex::Gpu::copy(amrex::Gpu::deviceToHost, ptd.rdata(PIdx::w),
+                             ptd.rdata(PIdx::w) + n_particles, h_weight.begin());
+            amrex::Gpu::HostVector<amrex::ParticleReal> h_reaction_weight(n_pairs);
+            std::copy(reaction_weight.begin(), reaction_weight.end(), h_reaction_weight.begin());
+
+            ParticleCreationDiag::Amount reaction_amount;
+            ParticleCreationDiag::Amount split_amount;
+            const double mass_double = static_cast<double>(mass);
+            for (index_type ip = 0; ip < n_pairs; ++ip) {
+                if (h_mask[ip] == 0) { continue; }
+                const bool is_reaction = reaction_mask == 0
+                    ? !m_creation_channel.empty() : h_mask[ip] == reaction_mask;
+                const auto& channel = is_reaction ? m_creation_channel : m_creation_split_channel;
+                if (channel.empty()) { continue; }
+                auto& amount = is_reaction ? reaction_amount : split_amount;
+                const auto parent = static_cast<std::size_t>(h_indices[ip]);
+                if (parent >= n_particles) { continue; }
+                const double weight_before = static_cast<double>(before_weight[parent]);
+                const double weight_after = static_cast<double>(h_weight[parent]);
+                const double actual_removed = std::max(0.0, weight_before - weight_after);
+                const double requested = static_cast<double>(h_reaction_weight[ip]);
+                const double consumed_before = consumed_weight[parent];
+                const double available = std::max(0.0, actual_removed - consumed_before);
+                const double weight = std::min(requested, available);
+                consumed_weight[parent] = consumed_before + weight;
+                const double ux = static_cast<double>(before_ux[parent]);
+                const double uy = static_cast<double>(before_uy[parent]);
+                const double uz = static_cast<double>(before_uz[parent]);
+                const double u2 = ux*ux + uy*uy + uz*uz;
+                const double gamma = std::sqrt(1.0 + u2 * PhysConst::inv_c2_v<double>);

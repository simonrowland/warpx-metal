diff --git a/Source/Diagnostics/ReducedDiags/ParticleCreation.H b/Source/Diagnostics/ReducedDiags/ParticleCreation.H
new file mode 100644
index 000000000..e3f44c23d
--- /dev/null
+++ b/Source/Diagnostics/ReducedDiags/ParticleCreation.H
@@ -0,0 +1,121 @@
+/* Copyright 2026 The WarpX Community
+ *
+ * This file is part of WarpX.
+ *
+ * License: BSD-3-Clause-LBNL
+ */
+#ifndef WARPX_DIAGNOSTICS_REDUCEDDIAGS_PARTICLECREATION_H_
+#define WARPX_DIAGNOSTICS_REDUCEDDIAGS_PARTICLECREATION_H_
+
+#include "ReducedDiags.H"
+
+#include <AMReX_INT.H>
+
+#include <string>
+#include <vector>
+
+class WarpXParticleContainer;
+
+/** A host-side event queued by a creation path after it has assigned IDs. */
+struct ParticleCreationEvent
+{
+    WarpXParticleContainer* container = nullptr;
+    int species_id = -1;
+    std::string channel;
+    amrex::Long first_id = 0;
+    amrex::Long count = 0;
+    int creator_cpu = -1;
+};
+
+/**
+ * Reduced diagnostic for exact per-channel particle creation and destruction.
+ *
+ * Hooks call this class only after their device work has synchronized.  The
+ * particle scan is host-side so the Metal path never emits FP64 arithmetic or
+ * dynamic channel indexing in a device kernel.  MPI reduction is performed
+ * once, over the fixed output layout, in ComputeDiags.
+ */
+class ParticleCreationDiag final : public ReducedDiags
+{
+public:
+    struct Amount
+    {
+        amrex::Long count = 0;
+        double weight = 0.0;
+        double kinetic_energy = 0.0;
+    };
+
+    struct Snapshot
+    {
+        Amount amount;
+    };
+
+    explicit ParticleCreationDiag (const std::string& rd_name);
+    ~ParticleCreationDiag () override;
+
+    ParticleCreationDiag (ParticleCreationDiag const&) = delete;
+    ParticleCreationDiag& operator= (ParticleCreationDiag const&) = delete;
+
+    /** True when the pcreate reduced diagnostic is configured. */
+    static bool Active () noexcept;
+
+    /** Take a rank-local, double-precision snapshot of one species. */
+    static Snapshot Capture (WarpXParticleContainer const& pc,
+                             double mass_override = -1.0,
+                             bool is_photon_override = false);
+
+    /** Record accepted particles occupying a newly assigned ID range. */
+    static void RecordIDRange (WarpXParticleContainer const& pc, int species_id,
+                               const std::string& channel, amrex::Long first_id,
+                               amrex::Long count, int creator_cpu = -1);
+
+    /** Record an amount already measured at the creation/destruction hook. */
+    static void RecordAmount (int species_id, const std::string& channel,
+                              Amount const& amount, bool destroyed);
+
+    /** Consume pending amounts for the row selected by the reduced-diag interval. */
+    void ComputeDiags (int step) final;
+
+    /** The initial inventory is always emitted as the step-0 opening row. */
+    [[nodiscard]] bool DoDiags (int step) const final {
+        return step == -1 || ReducedDiags::DoDiags(step);
+    }
+
+    /** Write the exact integer/double row without passing through m_data<Real>. */
+    void WriteToFile (int step) const final;
+
+    void PrepareCheckpointData () final;
+    void WriteCheckpointData (std::string const& dir) final;
+    void ReadCheckpointData (std::string const& dir) final;
+
+    /** Register a channel while the input-derived layout is being built. */
+    void addChannel (int species_id, const std::string& channel, bool has_destroyed);
+
+private:
+    struct Channel
+    {
+        std::string name;
+        bool has_destroyed = false;
+        std::size_t column = 0; // index of the created Amount group
+    };
+
+    struct Species
+    {
+        std::string name;
+        std::vector<Channel> channels;
+    };
+
+    static ParticleCreationDiag* s_instance;
+
+    std::vector<Species> m_species;
+    std::vector<Amount> m_pending;
+    std::vector<Amount> m_checkpoint_pending;
+    std::vector<std::string> m_layout_names;
+    mutable std::vector<Amount> m_row;
+
+    void record (int species_id, const std::string& channel,
+                 Amount const& amount, bool destroyed);
+    void writeHeader () const;
+};
+
+#endif // WARPX_DIAGNOSTICS_REDUCEDDIAGS_PARTICLECREATION_H_
diff --git a/Source/Diagnostics/ReducedDiags/ParticleCreation.cpp b/Source/Diagnostics/ReducedDiags/ParticleCreation.cpp
new file mode 100644
index 000000000..5bd11c8e6
--- /dev/null
+++ b/Source/Diagnostics/ReducedDiags/ParticleCreation.cpp
@@ -0,0 +1,490 @@
+/* Copyright 2026 The WarpX Community
+ *
+ * This file is part of WarpX.
+ *
+ * License: BSD-3-Clause-LBNL
+ */
+#include "ParticleCreation.H"
+
+#include "Initialization/PlasmaInjector.H"
+#include "Particles/MultiParticleContainer.H"
+#include "Particles/WarpXParticleContainer.H"
+#include "Utils/TextMsg.H"
+#include "Utils/WarpXConst.H"
+#include "WarpX.H"
+
+#include <AMReX_GpuContainers.H>
+#include <AMReX_ParIter.H>
+#include <AMReX_ParallelDescriptor.H>
+#include <AMReX_ParmParse.H>
+#include <AMReX_Particle.H>
+
+#include <algorithm>
+#include <cmath>
+#include <fstream>
+#include <iomanip>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+using namespace amrex;
+
+ParticleCreationDiag* ParticleCreationDiag::s_instance = nullptr;
+
+namespace
+{
+    enum class ReductionMode { Valid, IDRange };
+
+    double kineticEnergyDouble (double ux, double uy, double uz,
+                                double mass, bool is_photon) noexcept
+    {
+        const double u2 = ux*ux + uy*uy + uz*uz;
+        if (is_photon) {
+            return static_cast<double>(PhysConst::m_e) * static_cast<double>(PhysConst::c)
+                * std::sqrt(u2);
+        }
+        const double gamma = std::sqrt(1.0 + u2 * PhysConst::inv_c2_v<double>);
+        return mass * u2 / (1.0 + gamma);
+    }
+
+    ParticleCreationDiag::Amount scanParticles (
+        WarpXParticleContainer const& pc, ReductionMode mode,
+        amrex::Long first_id = 0, amrex::Long id_count = 0,
+        int creator_cpu = -1, double mass_override = -1.0,
+        bool is_photon_override = false)
+    {
+        ParticleCreationDiag::Amount result;
+        if (mode == ReductionMode::IDRange && id_count <= 0) { return result; }
+
+        auto& mutable_pc = const_cast<WarpXParticleContainer&>(pc);
+        const bool is_photon = mass_override >= 0.0
+            ? is_photon_override : pc.AmIA<PhysicalSpecies::photon>();
+        const double mass = mass_override >= 0.0
+            ? mass_override : static_cast<double>(pc.getMass());
+
+        for (int lev = 0; lev <= pc.finestLevel(); ++lev) {
+            for (WarpXParIter pti(mutable_pc, lev); pti.isValid(); ++pti) {
+                const auto& ptd = pti.GetParticleTile().getConstParticleTileData();
+                const auto n = static_cast<std::size_t>(pti.numParticles());
+                if (n == 0) { continue; }
+
+                Gpu::HostVector<uint64_t> h_idcpu(n);
+                Gpu::HostVector<ParticleReal> h_w(n);
+                Gpu::HostVector<ParticleReal> h_ux(n);
+                Gpu::HostVector<ParticleReal> h_uy(n);
+                Gpu::HostVector<ParticleReal> h_uz(n);
+                Gpu::copy(Gpu::deviceToHost, ptd.m_idcpu, ptd.m_idcpu + n, h_idcpu.begin());
+                Gpu::copy(Gpu::deviceToHost, ptd.rdata(PIdx::w),
+                          ptd.rdata(PIdx::w) + n, h_w.begin());
+                Gpu::copy(Gpu::deviceToHost, ptd.rdata(PIdx::ux),
+                          ptd.rdata(PIdx::ux) + n, h_ux.begin());
+                Gpu::copy(Gpu::deviceToHost, ptd.rdata(PIdx::uy),
+                          ptd.rdata(PIdx::uy) + n, h_uy.begin());
+                Gpu::copy(Gpu::deviceToHost, ptd.rdata(PIdx::uz),
+                          ptd.rdata(PIdx::uz) + n, h_uz.begin());
+
+                for (std::size_t i = 0; i < n; ++i) {
+                    const ParticleIDWrapper id{h_idcpu[i]};
+                    if (!id.is_valid()) { continue; }
+                    const auto bare_id = static_cast<amrex::Long>(id);
+                    if (mode == ReductionMode::IDRange &&
+                        (bare_id < first_id || bare_id >= first_id + id_count)) {
+                        continue;
+                    }
+                    if (creator_cpu >= 0 &&
+                        static_cast<int>(ParticleCPUWrapper{h_idcpu[i]}) != creator_cpu) {
+                        continue;
+                    }
+
+                    const double weight = static_cast<double>(h_w[i]);
+                    result.count += 1;
+                    result.weight += weight;
+                    result.kinetic_energy += weight * kineticEnergyDouble(
+                        static_cast<double>(h_ux[i]), static_cast<double>(h_uy[i]),
+                        static_cast<double>(h_uz[i]), mass, is_photon);
+                }
+            }
+        }
+        return result;
+    }
+
+    void addIfSpeciesExists (ParticleCreationDiag& diag,
+                             std::vector<std::string> const& species_names,
+                             std::string const& species_name,
+                             std::string const& channel,
+                             bool has_destroyed)
+    {
+        auto const it = std::find(species_names.begin(), species_names.end(), species_name);
+        if (it != species_names.end()) {
+            diag.addChannel(static_cast<int>(std::distance(species_names.begin(), it)),
+                            channel, has_destroyed);
+        }
+    }
+
+    void addForNames (ParticleCreationDiag& diag,
+                      std::vector<std::string> const& species_names,
+                      std::vector<std::string> const& names,
+                      std::string const& channel,
+                      bool has_destroyed)
+    {
+        for (auto const& name : names) {
+            addIfSpeciesExists(diag, species_names, name, channel, has_destroyed);
+        }
+    }
+}
+
+ParticleCreationDiag::ParticleCreationDiag (const std::string& rd_name)
+    : ReducedDiags{rd_name}
+{
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        s_instance == nullptr,
+        "Only one ParticleCreation reduced diagnostic may be configured");
+
+    auto const& mypc = WarpX::GetInstance().GetPartContainer();
+    const auto species_names = mypc.GetSpeciesNames();
+    m_species.resize(species_names.size());
+
+    for (int i = 0; i < static_cast<int>(species_names.size()); ++i) {
+        m_species[i].name = species_names[i];
+        auto const& species = mypc.GetParticleContainer(i);
+        WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+            !species.DoQED() && !species.DoResampling() && !species.DoSplitting(),
+            "ParticleCreation does not support QED, particle resampling, or AMR "
+            "particle splitting paths; "
+            "enable it only for the named injection/reaction channels");
+        addChannel(i, "initial", false);
+        addChannel(i, "inject", false);
+
+        bool have_default_continuous = false;
+        bool have_default_flux = false;
+        for (int source_index = 0;; ++source_index) {
+            auto* injector = mypc.GetParticleContainer(i).GetPlasmaInjector(source_index);
+            if (injector == nullptr) { break; }
+            const auto& source_name = injector->getSourceName();
+            if (source_name.empty()) {
+                have_default_continuous = have_default_continuous || injector->doInjection();
+                have_default_flux = have_default_flux || injector->doFluxInjection();
+            } else {
+                WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+                    source_name != "initial" && source_name != "inject" &&
+                    source_name != "continuous" && source_name != "flux" &&
+                    source_name != "ionization" && source_name != "chargeexchange" &&
+                    source_name != "dsmc_split" &&
+                    source_name != "fusion",
+                    "ParticleCreation injection source name '" + source_name +
+                    "' is reserved by the diagnostic layout");
+                addChannel(i, source_name, false);
+            }
+        }
+        if (have_default_continuous) { addChannel(i, "continuous", false); }
+        if (have_default_flux) { addChannel(i, "flux", false); }
+
+        const ParmParse pp_species(species_names[i]);
+        int field_ionization = 0;
+        pp_species.query("do_field_ionization", field_ionization);
+        if (field_ionization) {
+            std::string product;
+            pp_species.query("ionization_product_species", product);
+            addIfSpeciesExists(*this, species_names, product, "ionization", false);
+        }
+    }
+
+    const ParmParse pp_collisions("collisions");
+    std::vector<std::string> collision_names;
+    pp_collisions.queryarr("collision_names", collision_names);
+    for (auto const& collision_name : collision_names) {
+        const ParmParse pp_collision(collision_name);
+        std::string type = "pairwisecoulomb";
+        pp_collision.query("type", type);
+
+        WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+            type != "bremsstrahlung" && type != "linear_breit_wheeler" &&
+            type != "linear_compton" && type != "pulsed_decay",
+            "ParticleCreation does not support QED or pulsed-decay collision "
+            "products; "
+            "disable ParticleCreation or use an injection/ionization/CX/fusion "
+            "configuration");
+
+        std::vector<std::string> involved;
+        pp_collision.queryarr("species", involved);
+        const auto collision_species = involved;
+        std::vector<std::string> products;
+        pp_collision.queryarr("product_species", products);
+        involved.insert(involved.end(), products.begin(), products.end());
+
+        std::string channel;
+        if (type == "nuclearfusion") {
+            channel = "fusion";
+        } else if (type == "dsmc") {
+            std::vector<std::string> processes;
+            pp_collision.queryarr("scattering_processes", processes);
+            bool has_split = false;
+            int product_process_count = 0;
+            for (auto const& process : processes) {
+                const bool is_ionization = process.find("ionization") != std::string::npos;
+                const bool is_charge_exchange =
+                    process.find("charge_exchange") != std::string::npos ||
+                    process.find("two_product_reaction") != std::string::npos;
+                product_process_count += (is_ionization || is_charge_exchange) ? 1 : 0;
+                if (!is_ionization && !is_charge_exchange) { has_split = true; }
+                if (is_ionization && channel.empty()) {
+                    channel = "ionization";
+                    std::string secondary;
+                    pp_collision.query("ionization_species", secondary);
+                    if (!secondary.empty()) { involved.push_back(secondary); }
+                }
+                if (is_charge_exchange && channel.empty()) {
+                    channel = "chargeexchange";
+                }
+            }
+            WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+                product_process_count <= 1,
+                "ParticleCreation does not support multiple DSMC product "
+                "processes in one collision configuration");
+            if (has_split) {
+                addForNames(*this, species_names, collision_species, "dsmc_split", true);
+            }
+        }
+
+        if (!channel.empty()) {
+            addForNames(*this, species_names, involved, channel, true);
+        }
+
+        if (type == "background_mcc") {
+            std::vector<std::string> processes;
+            pp_collision.queryarr("scattering_processes", processes);
+            const bool has_ionization = std::any_of(
+                processes.begin(), processes.end(), [](std::string const& process) {
+                    return process.find("ionization") != std::string::npos;
+                });
+            if (has_ionization) {
+                std::string secondary;
+                pp_collision.query("ionization_species", secondary);
+                auto ionization_species = collision_species;
+                ionization_species.push_back(secondary);
+                addForNames(*this, species_names, ionization_species, "ionization", true);
+            }
+        }
+    }
+
+    std::size_t n_groups = 0;
+    for (auto& species : m_species) {
+        for (auto& channel : species.channels) {
+            channel.column = n_groups++;
+            const auto prefix = species.name + "_" + channel.name;
+            m_layout_names.push_back(prefix + "_created");
+            if (channel.has_destroyed) {
+                ++n_groups;
+                m_layout_names.push_back(prefix + "_destroyed");
+            }
+        }
+    }
+    m_pending.resize(n_groups);
+    m_row.resize(n_groups);
+    m_checkpoint_pending.resize(n_groups);
+    writeHeader();
+    s_instance = this;
+}
+
+ParticleCreationDiag::~ParticleCreationDiag ()
+{
+    if (s_instance == this) { s_instance = nullptr; }
+}
+
+bool ParticleCreationDiag::Active () noexcept
+{
+    return s_instance != nullptr;
+}
+
+ParticleCreationDiag::Snapshot
+ParticleCreationDiag::Capture (WarpXParticleContainer const& pc,
+                               double mass_override,
+                               bool is_photon_override)
+{
+    return Snapshot{scanParticles(pc, ReductionMode::Valid, 0, 0, -1,
+                                  mass_override, is_photon_override)};
+}
+
+void ParticleCreationDiag::RecordIDRange (
+    WarpXParticleContainer const& pc, int species_id, const std::string& channel,
+    amrex::Long first_id, amrex::Long count, int creator_cpu)
+{
+    if (!s_instance || count <= 0) { return; }
+    s_instance->record(species_id, channel,
+                       scanParticles(pc, ReductionMode::IDRange, first_id, count,
+                                     creator_cpu), false);
+}
+
+void ParticleCreationDiag::RecordAmount (
+    int species_id, const std::string& channel, Amount const& amount, bool destroyed)
+{
+    if (!s_instance) { return; }
+    s_instance->record(species_id, channel, amount, destroyed);
+}
+
+void ParticleCreationDiag::addChannel (
+    int species_id, const std::string& channel, bool has_destroyed)
+{
+    auto& channels = m_species.at(static_cast<std::size_t>(species_id)).channels;
+    auto it = std::find_if(channels.begin(), channels.end(),
+                           [&](auto const& item){ return item.name == channel; });
+    if (it == channels.end()) {
+        channels.push_back(Channel{channel, has_destroyed, 0});
+    } else {
+        it->has_destroyed = it->has_destroyed || has_destroyed;
+    }
+}
+
+void ParticleCreationDiag::record (
+    int species_id, const std::string& channel, Amount const& amount, bool destroyed)
+{
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        species_id >= 0 && species_id < static_cast<int>(m_species.size()),
+        "ParticleCreation hook supplied an invalid species id");
+    auto& channels = m_species[species_id].channels;
+    auto it = std::find_if(channels.begin(), channels.end(),
+                           [&](auto const& item){ return item.name == channel; });
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        it != channels.end(),
+        "ParticleCreation hook supplied channel '" + channel +
+        "' that was absent from the diagnostic layout");
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        !destroyed || it->has_destroyed,
+        "ParticleCreation destruction hook supplied a creation-only channel");
+    const std::size_t offset = it->column + (destroyed ? 1 : 0);
+    m_pending[offset].count += amount.count;
+    m_pending[offset].weight += amount.weight;
+    m_pending[offset].kinetic_energy += amount.kinetic_energy;
+}
+
+void ParticleCreationDiag::ComputeDiags (int step)
+{
+    if (!DoDiags(step)) { return; }
+
+    const int n = static_cast<int>(m_pending.size());
+    std::vector<amrex::Long> counts(n);
+    std::vector<double> weights(n);
+    std::vector<double> kinetic_energies(n);
+    for (int i = 0; i < n; ++i) {
+        counts[i] = m_pending[i].count;
+        weights[i] = m_pending[i].weight;
+        kinetic_energies[i] = m_pending[i].kinetic_energy;
+    }
+    if (n > 0) {
+        ParallelDescriptor::ReduceLongSum(counts.data(), n);
+        ParallelDescriptor::ReduceRealSum(weights.data(), n);
+        ParallelDescriptor::ReduceRealSum(kinetic_energies.data(), n);
+    }
+    m_row.resize(static_cast<std::size_t>(n));
+    for (int i = 0; i < n; ++i) {
+        m_row[i] = Amount{counts[i], weights[i], kinetic_energies[i]};
+    }
+    std::fill(m_pending.begin(), m_pending.end(), Amount{});
+}
+
+void ParticleCreationDiag::PrepareCheckpointData ()
+{
+    const int n = static_cast<int>(m_pending.size());
+    m_checkpoint_pending.assign(m_pending.begin(), m_pending.end());
+    if (n == 0) { return; }
+
+    std::vector<amrex::Long> counts(n);
+    std::vector<double> weights(n);
+    std::vector<double> kinetic_energies(n);
+    for (int i = 0; i < n; ++i) {
+        counts[i] = m_pending[i].count;
+        weights[i] = m_pending[i].weight;
+        kinetic_energies[i] = m_pending[i].kinetic_energy;
+    }
+    ParallelDescriptor::ReduceLongSum(counts.data(), n);
+    ParallelDescriptor::ReduceRealSum(weights.data(), n);
+    ParallelDescriptor::ReduceRealSum(kinetic_energies.data(), n);
+    if (ParallelDescriptor::IOProcessor()) {
+        for (int i = 0; i < n; ++i) {
+            m_checkpoint_pending[i] = Amount{counts[i], weights[i], kinetic_energies[i]};
+        }
+    }
+}
+
+void ParticleCreationDiag::WriteCheckpointData (std::string const& dir)
+{
+    if (!ParallelDescriptor::IOProcessor()) { return; }
+    std::ofstream chkfile{dir + "/ParticleCreation_data.txt", std::ofstream::out};
+    if (!chkfile.good()) {
+        WARPX_ABORT_WITH_MESSAGE("ParticleCreationDiag::WriteCheckpointData: could not open checkpoint data");
+    }
+    chkfile << m_checkpoint_pending.size() << "\n";
+    chkfile << std::setprecision(17);
+    for (std::size_t i = 0; i < m_checkpoint_pending.size(); ++i) {
+        chkfile << m_layout_names.at(i) << "\n";
+        auto const& amount = m_checkpoint_pending[i];
+        chkfile << amount.count << " " << amount.weight << " "
+                << amount.kinetic_energy << "\n";
+    }
+}
+
+void ParticleCreationDiag::ReadCheckpointData (std::string const& dir)
+{
+    if (!ParallelDescriptor::IOProcessor()) { return; }
+    std::ifstream chkfile{dir + "/ParticleCreation_data.txt", std::ifstream::in};
+    if (!chkfile.good()) {
+        WARPX_ABORT_WITH_MESSAGE("ParticleCreationDiag::ReadCheckpointData: could not open checkpoint data");
+    }
+    std::size_t n = 0;
+    if (!(chkfile >> n) || n != m_pending.size()) {
+        WARPX_ABORT_WITH_MESSAGE("ParticleCreationDiag::ReadCheckpointData: checkpoint layout mismatch");
+    }
+    for (std::size_t i = 0; i < m_pending.size(); ++i) {
+        std::string layout_name;
+        if (!(chkfile >> layout_name) || layout_name != m_layout_names.at(i)) {
+            WARPX_ABORT_WITH_MESSAGE("ParticleCreationDiag::ReadCheckpointData: checkpoint layout mismatch");
+        }
+        auto& amount = m_pending[i];
+        if (!(chkfile >> amount.count >> amount.weight >> amount.kinetic_energy)) {
+            WARPX_ABORT_WITH_MESSAGE("ParticleCreationDiag::ReadCheckpointData: malformed checkpoint data");
+        }
+    }
+}
+
+void ParticleCreationDiag::writeHeader () const
+{
+    if (!ParallelDescriptor::IOProcessor() || !m_write_header) { return; }
+
+    std::ofstream ofs{m_path + m_rd_name + "." + m_extension, std::ofstream::out};
+    int column = 0;
+    ofs << "#";
+    ofs << "[" << column++ << "]step()" << m_sep;
+    ofs << "[" << column++ << "]time(s)";
+    for (auto const& species : m_species) {
+        for (auto const& channel : species.channels) {
+            auto const prefix = species.name + "_" + channel.name;
+            ofs << m_sep << "[" << column++ << "]" << prefix << "_created_count()";
+            ofs << m_sep << "[" << column++ << "]" << prefix << "_created_weight()";
+            ofs << m_sep << "[" << column++ << "]" << prefix << "_created_ke(J)";
+            if (channel.has_destroyed) {
+                ofs << m_sep << "[" << column++ << "]" << prefix << "_destroyed_count()";
+                ofs << m_sep << "[" << column++ << "]" << prefix << "_destroyed_weight()";
+                ofs << m_sep << "[" << column++ << "]" << prefix << "_destroyed_ke(J)";
+            }
+        }
+    }
+    ofs << "\n";
+}
+
+void ParticleCreationDiag::WriteToFile (int step) const
+{
+    if (!ParallelDescriptor::IOProcessor()) { return; }
+    std::ofstream ofs{m_path + m_rd_name + "." + m_extension,
+                      std::ofstream::out | std::ofstream::app};
+    ofs << step + 1 << m_sep;
+    ofs << std::fixed << std::setprecision(m_precision) << std::scientific
+        << WarpX::GetInstance().gett_new(0);
+    for (auto const& amount : m_row) {
+        ofs << m_sep << amount.count;
+        ofs << m_sep << std::fixed << std::setprecision(m_precision) << std::scientific
+            << amount.weight;
+        ofs << m_sep << std::fixed << std::setprecision(m_precision) << std::scientific
+            << amount.kinetic_energy;
+    }
+    ofs << "\n";
+}

+            ParticleCreationDiag::Capture(
+                tmp_pc_b, static_cast<double>(partner.getMass()),
+                partner.AmIA<PhysicalSpecies::photon>()).amount,
+            false);
+    }
+
     tmp_pc_a.Redistribute();
     tmp_pc_b.Redistribute();
     this->addParticles(tmp_pc_a, true);
     partner.addParticles(tmp_pc_b, true);
 }

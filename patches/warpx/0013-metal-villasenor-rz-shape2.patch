+/**
+ * Literal-slot view of a small shape-factor array materialized by an
+ * upstream helper.  Metal drops some runtime-indexed local-array reads;
+ * capture the values through literal reads, then expose only a switch-based
+ * access path to the deposition loops.
+ */
+template <int num_slots>
+struct LiteralShapeFactorArray
+{
+    double v0, v1, v2, v3, v4;
+
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    explicit LiteralShapeFactorArray (double const* values)
+        : v0(values[0]), v1(0.0), v2(0.0), v3(0.0), v4(0.0)
+    {
+        if constexpr (num_slots > 1) { v1 = values[1]; }
+        if constexpr (num_slots > 2) { v2 = values[2]; }
+        if constexpr (num_slots > 3) { v3 = values[3]; }
+        if constexpr (num_slots > 4) { v4 = values[4]; }
+    }
+
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    double operator[] (const int slot) const
+    {
+        switch (slot) {
+        case 0: return v0;
+        case 1: return v1;
+        case 2: return v2;
+        case 3: return v3;
+        case 4: return v4;
         default: return 0.0;
         }
     }
+
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    void set (const int slot, const double value)
+    {
+        switch (slot) {
+        case 0: v0 = value; break;
+        case 1: v1 = value; break;
+        case 2: v2 = value; break;
+        case 3: v3 = value; break;
+        case 4: v4 = value; break;
+        default: break;
+        }
+    }
 };
 
 #endif

     using ParticleType = WarpXParticleContainer::ParticleType;
 
+    /** Exclusive prefix sum over n elements, performed in bounded chunks on GPU builds.
+     *
+     * WHY. On the Metal/SYCL backend a single Scan::ExclusiveSum over a whole large box
+     * does not retire. Measured: 65,536 elements completes, 147,456 hangs, with the stack
+     *   AddPlasma -> Scan::ExclusiveSum -> streamSynchronize -> ... -> waitUntilCompleted.
+     * Stock hangs identically, so this is not introduced by the Metal port's own patches.
+     * MFIter tiling cannot shrink the scan: AddParticles gates tiling behind
+     * `do_tiling && amrex::Gpu::notInLaunchRegion()`, and the second term is false inside a
+     * GPU launch region, so `particles.tile_size` is silently ignored here (verified
+     * experimentally). Chunking bounds the scan length independently of box size, without
+     * touching the tiling guard, whose launch-region semantics are load-bearing elsewhere.
+     *
+     * DERIVATION. Required: out[i] = sum_{j<i} in[j], returning S = sum_{j<n} in[j].
+     * Split [0,n) into consecutive chunks [s, s+L). Within one chunk,
+     *     Scan::ExclusiveSum(L, in+s, out+s)  yields  out[s+k] = sum_{j<k} in[s+j]
+     * and returns that chunk total T = sum_{j<L} in[s+j]. Globally,
+     *     sum_{j<s+k} in[j] = (sum_{j<s} in[j]) + (sum_{j<k} in[s+j]) = base + out[s+k],
+     * so adding the constant `base` uniformly across the chunk restores global values.
+     * Advancing base by T after each chunk preserves the invariant base == sum_{j<s} in[j]
+     * at the top of every iteration, and the returned chunk totals telescope to S, so the
+     * function's return value is unchanged.
+     *
+     * UNITS / EXACTNESS. in, out, base, T and S are all amrex::Long particle counts. The
+     * arithmetic is exact integer addition with no rescaling and no floating point, so
+     * overflow behaviour is identical to the unchunked call.
+     *
+     * SANITY CHECKS. (a) chunk >= n gives one iteration with base == 0 and no add-kernel,
+     * i.e. bit-identical to the stock call. (b) n == 0 returns 0, matching
+     * ExclusiveSum(0,...). (c) for in[] uniformly equal to c, out[i] == i*c and the return
+     * is n*c, chunked or not.
+     *
+     * CONTROL. `particles.add_plasma_scan_chunk = 0` disables chunking and restores the
+     * stock single-scan call exactly, giving a clean A/B control arm. The default 65,536 is
+     * the largest per-box cell count measured to complete. CPU builds are left
+     * bit-identical -- the whole chunked path is compiled out -- because the CPU build is
+     * this port's correctness and performance reference.
+     */
+    amrex::Long
+    ChunkedExclusiveSum (amrex::Long n, amrex::Long const* in, amrex::Long* out)
+    {
+        if (n <= 0) { return 0; }
+#ifdef AMREX_USE_GPU
+        static const amrex::Long scan_chunk = [] () -> amrex::Long {
+            amrex::Long c = 65536;
+            amrex::ParmParse pp_particles("particles");
+            pp_particles.query("add_plasma_scan_chunk", c);
+            return c;
+        }();
+
+        if (scan_chunk > 0 && n > scan_chunk) {
+            amrex::Long total = 0;
+            for (amrex::Long start = 0; start < n; start += scan_chunk) {
+                const amrex::Long len = std::min(scan_chunk, n - start);
+                const amrex::Long base = total;
+                total += amrex::Scan::ExclusiveSum(len, in + start, out + start);
+                if (base != 0) {
+                    amrex::Long* AMREX_RESTRICT poffset = out + start;
+                    amrex::ParallelFor(len,
+                        [=] AMREX_GPU_DEVICE (amrex::Long ii) noexcept
+                        {
+                            poffset[ii] += base;
+                        });
+                }
+            }
+            return total;
+        }
+#endif
+        return amrex::Scan::ExclusiveSum(n, in, out);
+    }
+
+
     // Since the user provides the density distribution
     // at t_lab=0 and in the lab-frame coordinates,
     // we need to find the lab-frame position of this
@@ -899,7 +970,8 @@
 

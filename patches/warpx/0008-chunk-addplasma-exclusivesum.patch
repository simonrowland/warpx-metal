-        const amrex::Long max_new_particles = amrex::Scan::ExclusiveSum(counts.size(), counts.data(), offset.data());
+        const amrex::Long max_new_particles = ChunkedExclusiveSum(
+            static_cast<amrex::Long>(counts.size()), counts.data(), offset.data());
 
         // Update NextID to include particles created in this function
         amrex::Long pid;

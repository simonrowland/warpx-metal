+    // 128*epsilon times the global scale; summation follows
+    // gamma_n=n*epsilon/(1-n*epsilon). Algebra: nonzero modes normalize by
+    // 2/N, so tau_dft(N)=2*(gamma_(N+8)+128 epsilon); comparing independent
+    // deposition/reference DFTs adds both budgets plus 8 epsilon for
+    // store/load/subtraction. Dimensions: every tau is dimensionless.
+    // Sanity: tolerance grows with N and precision, while a sign flip has an
+    // O(1) residual and remains many orders larger in DP and SP.
+    constexpr amrex::Real epsilon =
+        std::numeric_limits<amrex::Real>::epsilon();
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        (ntheta + 8) * epsilon < 1._rt
+            && (audit_ntheta + 8) * epsilon < 1._rt,
+        "RZ J_ext DFT quadrature is too large for a finite roundoff bound");
+    const auto gamma_n = [=](int count) {
+        const amrex::Real n_eps =
+            static_cast<amrex::Real>(count) * epsilon;
+        return n_eps / (1._rt - n_eps);
+    };
+    const auto dft_tolerance = [=](int count) {
+        return 2._rt * (gamma_n(count + 8) + 128._rt * epsilon);
+    };

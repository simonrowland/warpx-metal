@@ -0,0 +1,78 @@
+# Shared deposited-artifact verdicts for green and broken-by-design suites.
+# Caller must set DEPOSIT_REL_TOL from the executable precision contract.
+check_deposited_contract() {
+  local log="$1" kind="$2" expected="$3" label="$4"
+  local line
+  line=$(grep "J_ext RZ deposited-gate:" "$log" | tail -1 || true)
+  if [ -z "$line" ]; then
+    echo "  [FAIL] $label missing deposited-current marker"
+    return 1
+  fi
+  local max_abs jr_re_min jr_re_max jr_min jr_max
+  local jt_min jt_max jt_im_min jt_im_max
+  local jz_re_min jz_re_max jz_im_min jz_im_max
+  local forbidden tracka_forbidden
+  max_abs=$(echo "$line" | sed -n 's/.*max_abs=\([0-9.eE+-]*\).*/\1/p')
+  jr_re_min=$(echo "$line" | sed -n 's/.*jr_m1_re_min=\([0-9.eE+-]*\).*/\1/p')
+  jr_re_max=$(echo "$line" | sed -n 's/.*jr_m1_re_max=\([0-9.eE+-]*\).*/\1/p')
+  jr_min=$(echo "$line" | sed -n 's/.*jr_m1_im_min=\([0-9.eE+-]*\).*/\1/p')
+  jr_max=$(echo "$line" | sed -n 's/.*jr_m1_im_max=\([0-9.eE+-]*\).*/\1/p')
+  jt_min=$(echo "$line" | sed -n 's/.*jt_m1_re_min=\([0-9.eE+-]*\).*/\1/p')
+  jt_max=$(echo "$line" | sed -n 's/.*jt_m1_re_max=\([0-9.eE+-]*\).*/\1/p')
+  jt_im_min=$(echo "$line" | sed -n 's/.*jt_m1_im_min=\([0-9.eE+-]*\).*/\1/p')
+  jt_im_max=$(echo "$line" | sed -n 's/.*jt_m1_im_max=\([0-9.eE+-]*\).*/\1/p')
+  jz_re_min=$(echo "$line" | sed -n 's/.*jz_m1_re_min=\([0-9.eE+-]*\).*/\1/p')
+  jz_re_max=$(echo "$line" | sed -n 's/.*jz_m1_re_max=\([0-9.eE+-]*\).*/\1/p')
+  jz_im_min=$(echo "$line" | sed -n 's/.*jz_m1_im_min=\([0-9.eE+-]*\).*/\1/p')
+  jz_im_max=$(echo "$line" | sed -n 's/.*jz_m1_im_max=\([0-9.eE+-]*\).*/\1/p')
+  forbidden=$(echo "$line" | sed -n 's/.*uniform_jy_forbidden_max=\([0-9.eE+-]*\).*/\1/p')
+  tracka_forbidden=$(echo "$line" | sed -n 's/.*tracka_forbidden_max=\([0-9.eE+-]*\).*/\1/p')
+  if [ "$kind" = "uniform_jy" ]; then
+    if ! python3 -c "
+import sys
+vals = [float('$jr_min'), float('$jr_max'), float('$jt_min'), float('$jt_max')]
+expected = float('$expected')
+tol = float('$DEPOSIT_REL_TOL') * max(1.0, abs(expected))
+ok = all(abs(v-expected) <= tol for v in vals)
+ok = ok and float('$forbidden') <= tol
+sys.exit(0 if ok else 1)
+"; then
+      echo "  [FAIL] $label deposited pure-Jy contract: expected=$expected rel_tol=$DEPOSIT_REL_TOL; $line"
+      return 1
+    fi
+    echo "    deposited pure-Jy: expected=$expected rel_tol=$DEPOSIT_REL_TOL; $line"
+  elif [ "$kind" = "tracka_m1" ]; then
+    if ! python3 -c "
+import math, sys
+actual = [
+ float('$jr_re_min'), float('$jr_re_max'),
+ float('$jr_min'), float('$jr_max'),
+ float('$jt_min'), float('$jt_max'),
+ float('$jt_im_min'), float('$jt_im_max'),
+ float('$jz_re_min'), float('$jz_re_max'),
+ float('$jz_im_min'), float('$jz_im_max')]
+golden = [
+ -1322.0311235647291, 1218.3475248347622,
+ -3141.1787591104153, 3408.498806436707,
+ -3139.7411706506186, 3406.938876574342,
+ -1217.7899372295856, 1321.4260842363508,
+ -2191.385050295506, 2191.385050295506,
+ -5649.892196361566, 5649.892196361566]
+rel = float('$DEPOSIT_REL_TOL')
+ok = all(math.isfinite(v) for v in actual)
+ok = ok and all(abs(v-g) <= rel*max(1.0,abs(g))
+                for v,g in zip(actual,golden))
+scale = max(abs(g) for g in golden)
+ok = ok and float('$max_abs') >= 1000.0
+ok = ok and float('$tracka_forbidden') <= rel*scale
+sys.exit(0 if ok else 1)
+"; then
+      echo "  [FAIL] $label deposited TrackA signed m=1 ledger: rel_tol=$DEPOSIT_REL_TOL; $line"
+      return 1
+    fi
+    echo "    deposited TrackA signed m=1 ledger: rel_tol=$DEPOSIT_REL_TOL; $line"
+  else
+    echo "  [FAIL] unknown deposited contract $kind"
+    return 1
+  fi
+}

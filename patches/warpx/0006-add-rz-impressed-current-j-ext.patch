@@ -9,6 +9,32 @@ INDIR="$(cd "$(dirname "$0")/inputs" && pwd)"
 PASS=0
 FAIL=0
 SKIP=0
+EXE_BASE="$(basename "$EXE")"
+
+# Roundoff contracts are executable-precision constants, never fits to observed
+# residuals.  The analytic oracle permits 8192 DP or 256 SP ulps for parser,
+# libm, rotation, DFT, sync and stagger arithmetic; the deposited ledger permits
+# 4096 DP or 256 SP ulps.  These dimensionless ulp budgets cover the named
+# operation chains; a sign/component mutation is O(1), far outside either.
+case ".$EXE_BASE." in
+  *.DP.*)
+    PRECISION=dp; EPS=2.220446049250313e-16
+    ROUND_R=1.8189894035458565e-12; DEPOSIT_REL_TOL=9.094947017729282e-13 ;;
+  *.SP.*)
+    PRECISION=sp; EPS=1.1920928955078125e-7
+    ROUND_R=3.0517578125e-5; DEPOSIT_REL_TOL=3.0517578125e-5 ;;
+  *) echo "Cannot infer DP/SP precision from executable basename $EXE_BASE"; exit 2 ;;
+esac
+
+# Geometry is an exact token in WarpX's basename. Parent directories are not
+# evidence: an RZ-labelled build root may contain Cartesian executables.
+case ".$EXE_BASE." in
+  *.rz.*) DIM=rz ;;
+  *.1d.*) DIM=1d ;;
+  *.2d.*) DIM=2d ;;
+  *.3d.*) DIM=3d ;;

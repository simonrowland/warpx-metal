+    const amrex::Real jr_m1_re_max = deposited_jr->max(1);
+    const amrex::Real jr_m1_im_min = deposited_jr->min(2);
+    const amrex::Real jr_m1_im_max = deposited_jr->max(2);
+    const amrex::Real jt_m1_re_min = deposited_jt->min(1);
+    const amrex::Real jt_m1_re_max = deposited_jt->max(1);
+    const amrex::Real jt_m1_im_min = deposited_jt->min(2);
+    const amrex::Real jt_m1_im_max = deposited_jt->max(2);
+    const amrex::Real jz_m1_re_min = deposited_jz->min(1);
+    const amrex::Real jz_m1_re_max = deposited_jz->max(1);
+    const amrex::Real jz_m1_im_min = deposited_jz->min(2);
+    const amrex::Real jz_m1_im_max = deposited_jz->max(2);

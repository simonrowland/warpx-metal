+                   << " audit_ntheta=" << audit_ntheta
+                   << " retained_max_abs_error=" << retained_max_abs_error
+                   << " retained_reference_max_abs=" << reference_max_abs
+                   << " retained_deposited_max_abs="
+                   << reference_deposited_max_abs
+                   << " retained_relative=" << retained_rel
+                   << " retained_rel_tol=" << retained_rel_tol
+                   << " max_axis_residual=" << max_axis_residual

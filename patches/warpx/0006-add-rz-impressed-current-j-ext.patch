+                2._rt * MathConst::pi * static_cast<amrex::Real>(itheta)
+                / static_cast<amrex::Real>(audit_ntheta);
+            const amrex::Real costheta = std::cos(theta);
+            const amrex::Real sintheta = std::sin(theta);
+            const amrex::Real x = r * costheta;
+            const amrex::Real y = r * sintheta;
+            const amrex::Real jx = jx_parser(x, y, z, time);
+            const amrex::Real jy = jy_parser(x, y, z, time);
+            const amrex::Real jz = jz_parser(x, y, z, time);
+            amrex::Real jcyl = jz;
+            if (cylindrical_component == 0) {
+                jcyl = jx * costheta + jy * sintheta;
+            } else if (cylindrical_component == 1) {
+                jcyl = -jx * sintheta + jy * costheta;
+            }
+            amrex::Real basis = 1._rt;
+            if (mode > 0) {
+                const amrex::Real mode_theta =
+                    static_cast<amrex::Real>(mode) * theta;
+                basis = 2._rt * (
+                    sine_component
+                        ? std::sin(mode_theta)
+                        : std::cos(mode_theta));
+            }
+            coefficient += basis * jcyl;
+        }
+        return coefficient / static_cast<amrex::Real>(audit_ntheta);
+    };
+
+    const int step = istep[0];
+    const int interval = m_p_ext_field_params->J_ext_div_check_interval;
+    const int stride = (step == 0) ? 1 : coarse_stride;
+    const int tick = (step == 0 || interval <= 0) ? 0 : (step / interval);
+    const int phase_r = tick % coarse_stride;
+    const int phase_z = (tick / coarse_stride) % coarse_stride;
+    const amrex::Box domain = Geom(0).Domain();
+    const auto lo = domain.smallEnd();
+    const auto hi = domain.bigEnd();
+    const amrex::IntVect hi_node = hi + amrex::IntVect::TheUnitVector();
+    const amrex::Real h_min = amrex::min(dx[0], dx[1]);
+    amrex::Real max_abs_div = 0._rt;
+    amrex::Real max_abs_J = 0._rt;
+    amrex::Real max_abs_discarded = 0._rt;
+    amrex::Real max_axis_residual = 0._rt;
+
+    // Authoritative deposited-current divergence.  Premise and algebra are
+    // the same cylindrical Yee operator derived above, but every operand now
+    // comes from the source-only MultiFab that was actually added to
+    // current_fp.  Units remain (A/m^2)/m=A/m^3.  Multiplying by h_min and
+    // dividing by max|J| is dimensionless.  The uniform Cartesian Jy limiting
+    // case cancels radial and azimuthal terms to roundoff; a write-path
+    // component/sign/index mutation leaves an O(J/r) residual.
+    amrex::Real deposited_max_abs_div = 0._rt;
+    amrex::Real deposited_max_abs_J = 0._rt;
+    amrex::Box deposited_domain = amrex::convert(domain, n_jt);
+    deposited_domain.setSmall(1, lo[1] + 1);
+    deposited_domain.setBig(0, hi[0]);
+    deposited_domain.setBig(1, hi[1]);
+    for (amrex::MFIter mfi(*deposited_jt, amrex::TilingIfNotGPU());
+         mfi.isValid(); ++mfi) {
+        amrex::Box check_box = mfi.tilebox(n_jt) & deposited_domain;
+        if (!check_box.ok()) { continue; }
+        auto const jr = deposited_jr->const_array(mfi);
+        auto const jt = deposited_jt->const_array(mfi);
+        auto const jz = deposited_jz->const_array(mfi);
+        amrex::ReduceOps<
+            amrex::ReduceOpMax, amrex::ReduceOpMax> reduce_op;
+        amrex::ReduceData<
+            amrex::Real, amrex::Real> reduce_data(reduce_op);
+        using ReduceTuple = typename decltype(reduce_data)::Type;
+        reduce_op.eval(
+            check_box, reduce_data,
+            [=] AMREX_GPU_DEVICE (
+                int i, int j, int k) -> ReduceTuple {
+                amrex::ignore_unused(k);
+                if (((i - lo[0] - phase_r) % stride) != 0
+                    || ((j - lo[1] - 1 - phase_z) % stride) != 0) {
+                    return {0._rt, 0._rt};
+                }
+                const amrex::Real r_node =
+                    real_box.lo(0) + static_cast<amrex::Real>(i) * dx[0];
+                amrex::Real local_div = 0._rt;
+                amrex::Real local_J = 0._rt;
+                for (int component = 0; component < ncomp; ++component) {
+                    const amrex::Real jr_right = jr(i, j, 0, component);
+                    const amrex::Real jt_here = jt(i, j, 0, component);
+                    const amrex::Real jz_right = jz(i, j, 0, component);
+                    const amrex::Real jz_left = jz(i, j - 1, 0, component);
+                    amrex::Real divh = 0._rt;
+                    if (r_node == 0._rt) {
+                        if (component == 0) {
+                            divh = 4._rt * jr_right / dx[0]
+                                + (jz_right - jz_left) / dx[1];
+                        }
+                    } else {
+                        const amrex::Real jr_left =
+                            jr(i - 1, j, 0, component);
+                        const amrex::Real r_right =
+                            r_node + 0.5_rt * dx[0];
+                        const amrex::Real r_left =
+                            r_node - 0.5_rt * dx[0];
+                        divh =
+                            (r_right * jr_right - r_left * jr_left)
+                                / (r_node * dx[0])
+                            + (jz_right - jz_left) / dx[1];
+                        local_J = amrex::max(
+                            local_J, amrex::Math::abs(jr_left));
+                        if (component > 0) {
+                            const int mode = (component + 1) / 2;
+                            if ((component % 2) == 1) {
+                                const amrex::Real jt_im =
+                                    jt(i, j, 0, component + 1);
+                                divh += static_cast<amrex::Real>(mode)
+                                    * jt_im / r_node;
+                                local_J = amrex::max(
+                                    local_J, amrex::Math::abs(jt_im));
+                            } else {
+                                const amrex::Real jt_re =
+                                    jt(i, j, 0, component - 1);
+                                divh -= static_cast<amrex::Real>(mode)
+                                    * jt_re / r_node;
+                                local_J = amrex::max(
+                                    local_J, amrex::Math::abs(jt_re));
+                            }
+                        }
+                    }
+                    local_div = amrex::max(
+                        local_div, amrex::Math::abs(divh));
+                    local_J = amrex::max(
+                        local_J, amrex::Math::abs(jr_right));
+                    local_J = amrex::max(
+                        local_J, amrex::Math::abs(jt_here));
+                    local_J = amrex::max(
+                        local_J, amrex::Math::abs(jz_right));
+                    local_J = amrex::max(
+                        local_J, amrex::Math::abs(jz_left));
+                }
+                return {local_div, local_J};
+            });
+        const auto values = reduce_data.value();
+        deposited_max_abs_div = amrex::max(
+            deposited_max_abs_div, amrex::get<0>(values));
+        deposited_max_abs_J = amrex::max(
+            deposited_max_abs_J, amrex::get<1>(values));
+    }
+
+    // Near-axis regularity from deposited coefficients, before the solver's
+    // exact-axis regularization hides invalid limits.  For a smooth scalar
+    // mode f_m, f_m(r)=C r^m+O(r^(m+2)); hence
+    // f_m(dr)-2^-m f_m(2dr)=O(dr^(m+2)).  Cylindrical transverse mode m has
+    // leading r^(m-1); m=0 is odd O(r), and m=1 is even.  Extrapolating the
+    // latter from r=dr/2,3dr/2 gives f(0)=(9 f_1/2-f_3/2)/8+O(dr^4).
+    // All residuals are A/m^2 and become dimensionless after /max|J|.
+    // Sanity: uniform Jy satisfies the m=1 pair exactly; bounded Jz=cos(theta)
+    // and a guarded 1/r swirl leave O(J) residuals.
+    amrex::Real deposited_axis_residual = 0._rt;
+    amrex::Box axis_box = amrex::convert(domain, n_jt);
+    axis_box.setSmall(0, lo[0]);
+    axis_box.setBig(0, lo[0]);
+    for (amrex::MFIter mfi(*deposited_jt, false);
+         mfi.isValid(); ++mfi) {
+        amrex::Box check_box = mfi.validbox() & axis_box;
+        if (!check_box.ok()) { continue; }
+        auto const jr = deposited_jr->const_array(mfi);
+        auto const jt = deposited_jt->const_array(mfi);
+        auto const jz = deposited_jz->const_array(mfi);
+        amrex::ReduceOps<amrex::ReduceOpMax> reduce_op;
+        amrex::ReduceData<amrex::Real> reduce_data(reduce_op);
+        using ReduceTuple = typename decltype(reduce_data)::Type;
+        reduce_op.eval(
+            check_box, reduce_data,
+            [=] AMREX_GPU_DEVICE (
+                int i, int j, int k) -> ReduceTuple {
+                amrex::ignore_unused(k);
+                amrex::Real residual = 0._rt;
+                residual = amrex::max(
+                    residual, amrex::Math::abs(
+                        jr(i, j, 0, 0) - jr(i + 1, j, 0, 0) / 3._rt));
+                residual = amrex::max(
+                    residual, amrex::Math::abs(jt(i, j, 0, 0)));
+                residual = amrex::max(
+                    residual, amrex::Math::abs(
+                        jt(i + 1, j, 0, 0)
+                        - jt(i + 2, j, 0, 0) / 2._rt));
+                if (ncomp >= 3) {
+                    const amrex::Real jr_re_axis =
+                        (9._rt * jr(i, j, 0, 1)
+                            - jr(i + 1, j, 0, 1)) / 8._rt;
+                    const amrex::Real jr_im_axis =
+                        (9._rt * jr(i, j, 0, 2)
+                            - jr(i + 1, j, 0, 2)) / 8._rt;
+                    residual = amrex::max(
+                        residual, amrex::Math::abs(
+                            jt(i, j, 0, 1) - jr_im_axis));
+                    residual = amrex::max(
+                        residual, amrex::Math::abs(
+                            jt(i, j, 0, 2) + jr_re_axis));
+                }
+                for (int mode = 1; mode < nmodes; ++mode) {
+                    amrex::Real z_factor = 1._rt;
+                    for (int p = 0; p < mode; ++p) { z_factor *= 0.5_rt; }
+                    amrex::Real transverse_jr_factor = 1._rt;
+                    amrex::Real transverse_jt_factor = 1._rt;
+                    for (int p = 1; p < mode; ++p) {
+                        transverse_jr_factor /= 3._rt;
+                        transverse_jt_factor *= 0.5_rt;
+                    }
+                    for (int component = 2 * mode - 1;
+                         component <= 2 * mode; ++component) {
+                        residual = amrex::max(
+                            residual,
+                            amrex::Math::abs(jz(i, j, 0, component)));
+                        residual = amrex::max(
+                            residual, amrex::Math::abs(
+                                jz(i + 1, j, 0, component)
+                                - z_factor * jz(i + 2, j, 0, component)));
+                        if (mode >= 2) {
+                            residual = amrex::max(
+                                residual,
+                                amrex::Math::abs(jt(i, j, 0, component)));
+                            residual = amrex::max(
+                                residual, amrex::Math::abs(
+                                    jr(i, j, 0, component)
+                                    - transverse_jr_factor
+                                        * jr(i + 1, j, 0, component)));
+                            residual = amrex::max(
+                                residual, amrex::Math::abs(
+                                    jt(i + 1, j, 0, component)
+                                    - transverse_jt_factor
+                                        * jt(i + 2, j, 0, component)));
+                        }
+                    }
+                }
+                return {residual};
+            });
+        deposited_axis_residual = amrex::max(
+            deposited_axis_residual,
+            amrex::get<0>(reduce_data.value()));
+    }
+
+    // Premise: the high-resolution DFT specifies retained source coefficients;
+    // source-only MultiFabs hold what was actually written. Comparing them
+    // makes this gate causal to normalization, sign, component and mode-index
+    // deposition faults. Algebra:
+    //   E=max|J_deposited-J_reference|,
+    //   rho_ret=E/max(|J_deposited|,|J_reference|,J_floor).
+    // Separately D=max_{m>=M}|J_reference,m| and
+    // rho_disc=D/max(|J_deposited|,|J_reference|,D,J_floor).
+    // Dimensions: all amplitudes are A/m^2; both ratios are dimensionless.
+    // Sanity: a correct band-limited deposit agrees to roundoff, a global
+    // retained sign flip gives rho_ret=2, and a pure discarded mode gives
+    // rho_disc=1.
+    amrex::Real reference_max_abs = 0._rt;
+    amrex::Real reference_deposited_max_abs = 0._rt;
+    amrex::Real retained_max_abs_error = 0._rt;
+    amrex::Real declared_discarded_max_abs = 0._rt;
+    for (int idim = 0; idim < 3; ++idim) {
+        amrex::MultiFab* source = (*deposited_jext)[idim];
+        const amrex::IntVect nodal = source->ixType().toIntVect();
+        const int cylindrical_component = idim;
+        for (amrex::MFIter mfi(*source, amrex::TilingIfNotGPU());
+             mfi.isValid(); ++mfi) {
+            const amrex::Box box = mfi.tilebox(nodal);
+            auto const deposited = source->const_array(mfi);
+            amrex::ReduceOps<
+                amrex::ReduceOpMax, amrex::ReduceOpMax,
+                amrex::ReduceOpMax, amrex::ReduceOpMax> reduce_op;
+            amrex::ReduceData<
+                amrex::Real, amrex::Real,
+                amrex::Real, amrex::Real> reduce_data(reduce_op);
+            using ReduceTuple = typename decltype(reduce_data)::Type;
+            reduce_op.eval(
+                box, reduce_data,
+                [=] AMREX_GPU_DEVICE (
+                    int i, int j, int k) -> ReduceTuple {
+                    amrex::ignore_unused(k);
+                    const amrex::Real r =
+                        static_cast<amrex::Real>(i) * dx[0] + real_box.lo(0)
+                        + (1._rt - nodal[0]) * dx[0] * 0.5_rt;
+                    const amrex::Real z =
+                        static_cast<amrex::Real>(j) * dx[1] + real_box.lo(1)
+                        + (1._rt - nodal[1]) * dx[1] * 0.5_rt;
+                    amrex::Real local_reference = 0._rt;
+                    amrex::Real local_deposited = 0._rt;
+                    amrex::Real local_error = 0._rt;
+                    amrex::Real local_discarded = 0._rt;
+                    for (int mode = 0; mode <= reference_max_mode; ++mode) {
+                        amrex::Real coefficient_re = 0._rt;
+                        amrex::Real coefficient_im = 0._rt;
+                        for (int itheta = 0; itheta < audit_ntheta; ++itheta) {
+                            const amrex::Real theta =
+                                2._rt * MathConst::pi
+                                * static_cast<amrex::Real>(itheta)
+                                / static_cast<amrex::Real>(audit_ntheta);
+                            const amrex::Real costheta = std::cos(theta);
+                            const amrex::Real sintheta = std::sin(theta);
+                            const amrex::Real x = r * costheta;
+                            const amrex::Real y = r * sintheta;
+                            const amrex::Real jx = jx_parser(x, y, z, time);
+                            const amrex::Real jy = jy_parser(x, y, z, time);
+                            const amrex::Real jz = jz_parser(x, y, z, time);
+                            amrex::Real jcyl = jz;
+                            if (cylindrical_component == 0) {
+                                jcyl = jx * costheta + jy * sintheta;
+                            } else if (cylindrical_component == 1) {
+                                jcyl = -jx * sintheta + jy * costheta;
+                            }
+                            if (mode == 0) {
+                                coefficient_re += jcyl;
+                            } else {
+                                const amrex::Real mode_theta =
+                                    static_cast<amrex::Real>(mode) * theta;
+                                coefficient_re +=
+                                    2._rt * jcyl * std::cos(mode_theta);
+                                coefficient_im +=
+                                    2._rt * jcyl * std::sin(mode_theta);
+                            }
+                        }
+                        coefficient_re /= static_cast<amrex::Real>(audit_ntheta);
+                        coefficient_im /= static_cast<amrex::Real>(audit_ntheta);
+                        local_reference = amrex::max(
+                            local_reference, amrex::Math::abs(coefficient_re));
+                        local_reference = amrex::max(
+                            local_reference, amrex::Math::abs(coefficient_im));
+                        if (mode < nmodes) {
+                            const int re_component =
+                                (mode == 0) ? 0 : 2 * mode - 1;
+                            const amrex::Real deposited_re =
+                                deposited(i, j, 0, re_component);
+                            local_deposited = amrex::max(
+                                local_deposited,
+                                amrex::Math::abs(deposited_re));
+                            local_error = amrex::max(
+                                local_error,
+                                amrex::Math::abs(
+                                    deposited_re - coefficient_re));
+                            if (mode > 0) {
+                                const int im_component = 2 * mode;
+                                const amrex::Real deposited_im =
+                                    deposited(i, j, 0, im_component);
+                                local_deposited = amrex::max(
+                                    local_deposited,
+                                    amrex::Math::abs(deposited_im));
+                                local_error = amrex::max(
+                                    local_error,
+                                    amrex::Math::abs(
+                                        deposited_im - coefficient_im));
+                            }
+                        } else if (mode <= max_source_mode) {
+                            local_discarded = amrex::max(
+                                local_discarded,
+                                amrex::Math::abs(coefficient_re));
+                            local_discarded = amrex::max(
+                                local_discarded,
+                                amrex::Math::abs(coefficient_im));
+                        }
+                    }
+                    return {
+                        local_reference, local_deposited,
+                        local_error, local_discarded};
+                });
+            const auto values = reduce_data.value();
+            reference_max_abs = amrex::max(
+                reference_max_abs, amrex::get<0>(values));
+            reference_deposited_max_abs = amrex::max(
+                reference_deposited_max_abs, amrex::get<1>(values));
+            retained_max_abs_error = amrex::max(
+                retained_max_abs_error, amrex::get<2>(values));
+            declared_discarded_max_abs = amrex::max(
+                declared_discarded_max_abs, amrex::get<3>(values));
+        }
+    }
+
+    // The source gate runs before the one physical-boundary operator. Check
+    // only nodal residuals whose Jr/Jz stencil operands are both valid source
+    // cells: axis..last radial cell and first..last interior z node. The
+    // antenna contract separately requires boundary/PML standoff.
+    for (int j = lo[1] + 1 + phase_z; j <= hi[1]; j += stride) {
+        for (int i = lo[0] + phase_r; i <= hi[0]; i += stride) {
+            const amrex::Real r_node = rz_position(n_jt, i, j)[0];
+            for (int component = 0; component < ncomp; ++component) {
+                const amrex::Real jr_right =
+                    source_mode_value(0, n_jr, i, j, component);
+                const amrex::Real jt_here =
+                    source_mode_value(1, n_jt, i, j, component);
+                const amrex::Real jz_right =
+                    source_mode_value(2, n_jz, i, j, component);
+                const amrex::Real jz_left =
+                    source_mode_value(2, n_jz, i, j - 1, component);
+                amrex::Real divh = 0._rt;
+
+                if (r_node == 0._rt) {
+                    if (component == 0) {
+                        divh = 4._rt * jr_right / dx[0]
+                            + (jz_right - jz_left) / dx[1];
+                    }
+                    // Match ComputeDivECylindrical: higher-mode div is
+                    // regularized to zero at the axis.
+                } else {
+                    const amrex::Real jr_left =
+                        source_mode_value(0, n_jr, i - 1, j, component);
+                    const amrex::Real r_right =
+                        rz_position(n_jr, i, j)[0];
+                    const amrex::Real r_left =
+                        rz_position(n_jr, i - 1, j)[0];
+                    divh =
+                        (r_right * jr_right - r_left * jr_left)
+                            / (r_node * dx[0])
+                        + (jz_right - jz_left) / dx[1];
+                    max_abs_J = amrex::max(max_abs_J, std::abs(jr_left));
+
+                    if (component > 0) {
+                        const int mode = (component + 1) / 2;
+                        if ((component % 2) == 1) {
+                            const amrex::Real jt_im =
+                                source_mode_value(1, n_jt, i, j, component + 1);
+                            divh += static_cast<amrex::Real>(mode)
+                                * jt_im / r_node;
+                            max_abs_J =
+                                amrex::max(max_abs_J, std::abs(jt_im));
+                        } else {
+                            const amrex::Real jt_re =
+                                source_mode_value(1, n_jt, i, j, component - 1);
+                            divh -= static_cast<amrex::Real>(mode)
+                                * jt_re / r_node;
+                            max_abs_J =
+                                amrex::max(max_abs_J, std::abs(jt_re));
+                        }
+                    }
+                }
+                max_abs_div = amrex::max(max_abs_div, std::abs(divh));
+                max_abs_J = amrex::max(max_abs_J, std::abs(jr_right));
+                max_abs_J = amrex::max(max_abs_J, std::abs(jt_here));
+                max_abs_J = amrex::max(max_abs_J, std::abs(jz_right));
+                max_abs_J = amrex::max(max_abs_J, std::abs(jz_left));
+            }
+
+            // Represented-bandwidth gate.  The injection retains
+            // modes 0..M-1; with N_theta>=4*M the same quadrature also exposes
+            // modes M..2*M-1.  A nonzero discarded coefficient means the
+            // selected solver basis would silently remove/change the drive.
+            for (int mode = nmodes; mode <= max_source_mode; ++mode) {
+                const int re_component = 2 * mode - 1;
+                const int im_component = 2 * mode;
+                for (int idim = 0; idim < 3; ++idim) {
+                    const amrex::IntVect& nodal =
+                        (idim == 0) ? n_jr : ((idim == 1) ? n_jt : n_jz);
+                    max_abs_discarded = amrex::max(
+                        max_abs_discarded,
+                        std::abs(source_mode_value(
+                            idim, nodal, i, j, re_component)));
+                    max_abs_discarded = amrex::max(
+                        max_abs_discarded,
+                        std::abs(source_mode_value(
+                            idim, nodal, i, j, im_component)));
+                }
+            }
+        }
+    }
+
+    // The divergence solver forces higher-mode div to zero on axis, so check
+    // vector regularity separately before that regularization can hide an
+    // invalid/singular parser.  A finite Cartesian vector at r=0 has only
+    // transverse m=1 content and obeys
+    // Jtheta_re=Jr_im, Jtheta_im=-Jr_re; Jz has mode 0 only.
+    {
+        const int i_axis = lo[0];
+        for (int j = lo[1]; j <= hi_node[1]; ++j) {
+            const amrex::Real jr_re =
+                source_mode_value(0, n_jt, i_axis, j, 1);
+            const amrex::Real jr_im =
+                source_mode_value(0, n_jt, i_axis, j, 2);
+            const amrex::Real jt_re =
+                source_mode_value(1, n_jt, i_axis, j, 1);
+            const amrex::Real jt_im =
+                source_mode_value(1, n_jt, i_axis, j, 2);
+            max_axis_residual = amrex::max(
+                max_axis_residual, std::abs(jt_re - jr_im));
+            max_axis_residual = amrex::max(
+                max_axis_residual, std::abs(jt_im + jr_re));
+            max_axis_residual = amrex::max(
+                max_axis_residual,
+                std::abs(source_mode_value(0, n_jt, i_axis, j, 0)));
+            max_axis_residual = amrex::max(
+                max_axis_residual,
+                std::abs(source_mode_value(1, n_jt, i_axis, j, 0)));
+            for (int component = 1; component < ncomp; ++component) {
+                if (component > 2) {
+                    max_axis_residual = amrex::max(
+                        max_axis_residual,
+                        std::abs(source_mode_value(

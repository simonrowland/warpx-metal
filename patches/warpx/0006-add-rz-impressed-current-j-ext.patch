+        dft_tolerance(ntheta) + dft_tolerance(audit_ntheta)
+        + 8._rt * epsilon;
+    const amrex::Real retained_scale = amrex::max(
+        amrex::max(reference_max_abs, reference_deposited_max_abs), J_floor);
+    const amrex::Real retained_rel =
+        retained_max_abs_error / retained_scale;
+
+    // Signed deposited-mode evidence for the flagship pure-Cartesian-Jy
+    // contract. WarpX's native DFT gives Jr[m=1,im]=Jy and
+    // Jtheta[m=1,re]=Jy [A/m^2]; every other retained coefficient is zero.
+    // Min/max preserve sign and amplitude, unlike quadratic FieldEnergy.
+    // Sanity: Jy=+1.25 reports (+1.25,+1.25,forbidden=0); either a global
+    // sign flip or a Jtheta-only flip changes a signed bound and goes red.

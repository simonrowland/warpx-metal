+#!/usr/bin/env bash
+# Broken-by-design RZ J_ext guard tests. CPU only.
+# Injection-only mutations live in red-patches/ and are exercised separately.
+set -euo pipefail
+EXE="${1:?RZ WarpX executable}"
+LOGDIR="${2:-$(dirname "$0")/logs-red}"
+INDIR="$(cd "$(dirname "$0")/inputs/red" && pwd)"
+mkdir -p "$LOGDIR"
+PASS=0
+FAIL=0
+EXE_BASE="$(basename "$EXE")"
+case ".$EXE_BASE." in
+  *.DP.*) DEPOSIT_REL_TOL=9.094947017729282e-13 ;;
+  *.SP.*) DEPOSIT_REL_TOL=3.0517578125e-5 ;;
+  *) echo "Cannot infer DP/SP precision from executable basename $EXE_BASE"; exit 2 ;;
+esac
+. "$(dirname "$0")/jext_contracts.sh"
+
+expect_abort() {
+  local name="$1" input="$2" reason="$3"
+  local log="$LOGDIR/${name}.log" rundir="$LOGDIR/run_${name}"
+  rm -rf "$rundir"; mkdir -p "$rundir"
+  echo "[RED] $name"
+  if (cd "$rundir" && OMP_NUM_THREADS=1 "$EXE" "$input") >"$log" 2>&1; then
+    echo "  [FAIL] broken deck completed"; FAIL=$((FAIL+1)); return
+  fi
+  if grep -Eiq "$reason" "$log"; then
+    echo "  [PASS] gate went red"; PASS=$((PASS+1))
+  else
+    echo "  [FAIL] wrong abort reason"; tail -n 8 "$log"
+    FAIL=$((FAIL+1))
+  fi
+}
+
+expect_marker_break() {
+  local name="$1" input="$2" kind="$3" expected="$4"
+  local log="$LOGDIR/${name}.log" rundir="$LOGDIR/run_${name}"
+  rm -rf "$rundir"; mkdir -p "$rundir"
+  echo "[RED] $name"
+  if ! (cd "$rundir" && OMP_NUM_THREADS=1 "$EXE" "$input") >"$log" 2>&1; then
+    echo "  [FAIL] deck aborted before deposited-contract check"
+    tail -n 8 "$log"; FAIL=$((FAIL+1)); return
+  fi
+  if check_deposited_contract "$log" "$kind" "$expected" "$name"; then
+    echo "  [FAIL] broken deposited contract remained green"
+    FAIL=$((FAIL+1))
+  else
+    echo "  [PASS] production deposited contract went red"; PASS=$((PASS+1))
+  fi
+}
+
+expect_abort mode_m4 "$INDIR/mode_m4_rz" "angular bandwidth"
+expect_abort mode_m7 "$INDIR/mode_m7_rz" "angular bandwidth"
+expect_abort mode_m8 "$INDIR/mode_m8_rz" "angular bandwidth"
+expect_abort interval_zero "$INDIR/interval_zero_rz" "must be positive"
+expect_abort interval_negative "$INDIR/interval_negative_rz" "must be positive"
+expect_abort parser_nan "$INDIR/parser_nan_rz" "NaN/Inf before deposition"
+expect_abort parser_inf "$INDIR/parser_inf_rz" "NaN/Inf before deposition"
+expect_abort axis_bounded_cos "$INDIR/axis_bounded_cos_rz" "axis-regularity"
+expect_abort axis_guarded_swirl "$INDIR/axis_guarded_swirl_rz" "axis-regularity"
+expect_marker_break solenoidal_zero "$INDIR/solenoidal_zero_rz" uniform_jy 1.25
+expect_marker_break tracka_zero "$INDIR/tracka_zero_rz" tracka_m1 0
+expect_marker_break energy_negative "$INDIR/negative_jy_rz" uniform_jy 1000
+
+echo "RED-RESULT: PASS=$PASS FAIL=$FAIL"
+if [ "$FAIL" -ne 0 ]; then exit 1; fi

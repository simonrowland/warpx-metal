+    max_abs_J = deposited_max_abs_J;
+    max_abs_discarded = declared_discarded_max_abs;
+    max_axis_residual = deposited_axis_residual;
+    amrex::ParallelDescriptor::ReduceRealMax(max_abs_div);
+    amrex::ParallelDescriptor::ReduceRealMax(max_abs_J);
+    amrex::ParallelDescriptor::ReduceRealMax(max_abs_discarded);
+    amrex::ParallelDescriptor::ReduceRealMax(max_axis_residual);
+    amrex::ParallelDescriptor::ReduceRealMax(reference_max_abs);
+    amrex::ParallelDescriptor::ReduceRealMax(reference_deposited_max_abs);
+    amrex::ParallelDescriptor::ReduceRealMax(retained_max_abs_error);

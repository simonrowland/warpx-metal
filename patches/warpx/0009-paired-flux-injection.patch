         allcontainers[i]->m_deposit_on_main_grid = m_laser_deposit_on_main_grid[i-nspecies];
     }
 
+    // Cache this read-only scan once. If no species declares flux_pair_with, the
+    // continuous-injection path below can return directly to the original loop;
+    // this scan does not draw random numbers or alter any particle state.
+    for (int i = 0; i < nspecies; ++i) {
+        auto const* pc = dynamic_cast<PhysicalParticleContainer const*>(allcontainers[i].get());
+        if (pc != nullptr && !pc->GetFluxPairWith().empty()) {
+            m_has_flux_pair = true;
+            break;
+        }
+    }
+
     // Setup particle collisions
     collisionhandler = std::make_unique<CollisionHandler>(this);
 
@@ -974,8 +985,93 @@ MultiParticleContainer::doContinuousInjection () const
 void
 MultiParticleContainer::ContinuousFluxInjection (amrex::Real t, amrex::Real dt) const
 {
-    for (const auto& pc : allcontainers){
-        pc->ContinuousFluxInjection(t, dt);
+    // Keep the original loop as the complete no-pair path. This is important for
+    // reproducibility of existing input decks. The cached flag avoids any new
+    // per-step parser or dynamic-cast work when pairing is not requested.
+    if (!m_has_flux_pair) {
+        for (const auto& pc : allcontainers){
+            pc->ContinuousFluxInjection(t, dt);
+        }
+        return;
+    }
+
+    const int nspecies = static_cast<int>(species_names.size());
+    std::vector<int> pair_target(nspecies, -1);
+    for (int i = 0; i < nspecies; ++i) {
+        auto const* pc = dynamic_cast<PhysicalParticleContainer*>(allcontainers[i].get());
+        if (!pc || pc->GetFluxPairWith().empty()) {
+            continue;
+        }
+
+        auto const it = std::find(species_names.begin(), species_names.end(),
+                                  pc->GetFluxPairWith());
+        WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+            it != species_names.end(),
+            "Species '" + species_names[i] + "' has flux_pair_with='"
+                + pc->GetFluxPairWith() + "', but that species does not exist.");
+        const int partner = static_cast<int>(std::distance(species_names.begin(), it));
+        WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+            partner != i,
+            "Species '" + species_names[i] + "' cannot pair flux injection with itself.");
+
+        auto const* partner_pc =
+            dynamic_cast<PhysicalParticleContainer*>(allcontainers[partner].get());
+        WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+            partner_pc != nullptr,
+            "Species '" + species_names[i]
+                + "' can only pair flux injection with a physical species.");
+        WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+            partner_pc->GetFluxPairWith().empty()
+                || partner_pc->GetFluxPairWith() == species_names[i],
+            "Flux-paired species must name each other; '" + species_names[partner]
+                + "' names '" + partner_pc->GetFluxPairWith() + "'.");
+
+        pair_target[i] = partner;
+    }
+
+    for (int i = 0; i < nspecies; ++i) {
+        if (pair_target[i] < 0) {
+            continue;
+        }
+        for (int j = i + 1; j < nspecies; ++j) {
+            WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+                pair_target[j] != pair_target[i],
+                "A species cannot be the flux_pair_with partner of more than one species: '"
+                    + species_names[pair_target[i]] + "'.");
+        }
+    }
+
+    std::vector<bool> handled(nspecies, false);
+    for (int i = 0; i < nspecies; ++i) {
+        if (pair_target[i] < 0 || handled[i]) {
+            continue;
+        }
+        const int partner = pair_target[i];
+        auto* pc = static_cast<PhysicalParticleContainer*>(allcontainers[i].get());
+        auto* partner_pc = static_cast<PhysicalParticleContainer*>(allcontainers[partner].get());
+        pc->AddPlasmaFluxPair(*partner_pc, t, dt);
+        handled[i] = true;
+        handled[partner] = true;
+    }
+
+    for (int i = 0; i < nspecies; ++i) {
+        auto* pc = dynamic_cast<PhysicalParticleContainer*>(allcontainers[i].get());
+        if (!pc) {
+            allcontainers[i]->ContinuousFluxInjection(t, dt);
+            continue;
+        }
+
+        if (!handled[i]) {
+            // Call through the base-class pointer: the override is protected in
+            // PhysicalParticleContainer but the virtual is public in WarpXParticleContainer.
+            allcontainers[i]->ContinuousFluxInjection(t, dt);
+        }
+    }
+
+    // Laser containers are after the physical species and retain their existing
+    // no-op/overridden behavior.
+    for (int i = nspecies; i < static_cast<int>(allcontainers.size()); ++i) {
+        allcontainers[i]->ContinuousFluxInjection(t, dt);
     }
 }
 
diff --git a/Source/Particles/ParticleCreation/AddParticles.cpp b/Source/Particles/ParticleCreation/AddParticles.cpp
index c0a1c4ef1..9eee391da 100644
--- a/Source/Particles/ParticleCreation/AddParticles.cpp
+++ b/Source/Particles/ParticleCreation/AddParticles.cpp
@@ -1764,3 +1764,520 @@ PhysicalParticleContainer::AddPlasmaFlux (PlasmaInjector const& plasma_injector,
     // Add the particles to the current container
     this->addParticles(tmp_pc, true);
 }
+
+void
+PhysicalParticleContainer::AddPlasmaFluxPair (PhysicalParticleContainer& partner,
+                                               amrex::Real t, amrex::Real dt)
+{
+    ABLASTR_PROFILE("PhysicalParticleContainer::AddPlasmaFluxPair()");
+
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        NumPlasmaInjectors() == 1 && partner.NumPlasmaInjectors() == 1,
+        "flux_pair_with requires each species to have exactly one NFluxPerCell injector.");
+    auto const* const injector_a = GetPlasmaInjector(0);
+    auto const* const injector_b = partner.GetPlasmaInjector(0);
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        injector_a != nullptr && injector_b != nullptr
+            && injector_a->doFluxInjection() && injector_b->doFluxInjection(),
+        "flux_pair_with requires both species to use injection_style = NFluxPerCell.");
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        !injector_a->fluxInjectionFromEB() && !injector_b->fluxInjectionFromEB(),
+        "flux_pair_with currently requires plane-based NFluxPerCell injection; "
+        "embedded-boundary injection cannot be paired.");
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        injector_a->flux_normal_axis == injector_b->flux_normal_axis
+            && injector_a->surface_flux_pos == injector_b->surface_flux_pos
+            && injector_a->flux_direction == injector_b->flux_direction
+            && injector_a->xmin == injector_b->xmin
+            && injector_a->xmax == injector_b->xmax
+            && injector_a->ymin == injector_b->ymin
+            && injector_a->ymax == injector_b->ymax
+            && injector_a->zmin == injector_b->zmin
+            && injector_a->zmax == injector_b->zmax,
+        "flux_pair_with requires identical flux plane geometry and bounds for '"
+            + species_name + "' and '" + partner.species_name + "'.");
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        injector_a->num_particles_per_cell_real == injector_b->num_particles_per_cell_real,
+        "flux_pair_with requires identical num_particles_per_cell for '"
+            + species_name + "' and '" + partner.species_name + "'.");
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        injector_a->hasSameFlux(*injector_b),
+        "flux_pair_with requires identical constant flux or identical flux_function for '"
+            + species_name + "' and '" + partner.species_name + "'.");
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        injector_a->flux_tmin == injector_b->flux_tmin
+            && injector_a->flux_tmax == injector_b->flux_tmax,
+        "flux_pair_with requires identical flux_tmin and flux_tmax for '"
+            + species_name + "' and '" + partner.species_name + "'.");
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        getCharge() != 0._prt && getCharge() == -partner.getCharge(),
+        "flux_pair_with requires equal and opposite nonzero species charges for '"
+            + species_name + "' and '" + partner.species_name + "'.");
+
+    // Pairing is only defined for species whose charge is fixed for every particle.
+    // Field ionization adds the per-particle ionizationLevel charge multiplier. Impact
+    // ionization is likewise incompatible with treating these two species as fixed-charge
+    // injection partners, so reject any configured ionization collision involving either.
+    auto has_impact_ionization = [](const std::string& species_name) {
+        const ParmParse pp_collisions("collisions");
+        amrex::Vector<std::string> collision_names;
+        pp_collisions.queryarr("collision_names", collision_names);
+        for (const auto& collision_name : collision_names) {
+            const ParmParse pp_collision(collision_name);
+            std::string collision_type;
+            pp_collision.query("type", collision_type);
+            if (collision_type != "background_mcc" && collision_type != "dsmc") {
+                continue;
+            }
+
+            amrex::Vector<std::string> scattering_processes;
+            pp_collision.queryarr("scattering_processes", scattering_processes);
+            if (std::find(scattering_processes.begin(), scattering_processes.end(), "ionization")
+                == scattering_processes.end()) {
+                continue;
+            }
+
+            amrex::Vector<std::string> affected_species;
+            pp_collision.queryarr("species", affected_species);
+            std::string ionization_species;
+            if (pp_collision.query("ionization_species", ionization_species)) {
+                affected_species.push_back(ionization_species);
+            }
+            amrex::Vector<std::string> product_species;
+            pp_collision.queryarr("product_species", product_species);
+            affected_species.insert(
+                affected_species.end(), product_species.begin(), product_species.end());
+
+            if (std::find(affected_species.begin(), affected_species.end(), species_name)
+                != affected_species.end()) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    auto has_charge_state_attribute = [](PhysicalParticleContainer& species) {
+        auto is_charge_state_name = [](const std::string& name) {
+            return name.find("charge") != std::string::npos
+                || name.find("Charge") != std::string::npos
+                || name.find("ionization") != std::string::npos
+                || name.find("Ionization") != std::string::npos;
+        };
+        const auto& int_names = species.GetIntSoANames();
+        const auto& real_names = species.GetRealSoANames();
+        return std::any_of(int_names.begin(), int_names.end(), is_charge_state_name)
+            || std::any_of(real_names.begin(), real_names.end(), is_charge_state_name);
+    };
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        !DoFieldIonization() && !partner.DoFieldIonization()
+            && !has_impact_ionization(species_name) && !has_impact_ionization(partner.species_name)
+            && !has_charge_state_attribute(*this) && !has_charge_state_attribute(partner),
+        "flux_pair_with requires fixed-charge species; field or impact ionization and "
+        "per-particle charge-state attributes are not supported for '"
+            + species_name + "' and '" + partner.species_name + "'.");
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        NumRuntimeRealComps() == 0 && partner.NumRuntimeRealComps() == 0
+            && NumRuntimeIntComps() == 0 && partner.NumRuntimeIntComps() == 0,
+        "flux_pair_with requires species without runtime particle attributes; "
+        "paired attribute initialization is not supported.");
+#if defined(WARPX_DIM_RZ) || defined(WARPX_DIM_RCYLINDER) || defined(WARPX_DIM_RSPHERE)
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        injector_a->radial_numpercell_power == injector_b->radial_numpercell_power,
+        "flux_pair_with requires identical radial_numpercell_power for '"
+            + species_name + "' and '" + partner.species_name + "'.");
+#endif
+#if defined(WARPX_DIM_RCYLINDER) || defined(WARPX_DIM_RSPHERE)
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        false,
+        "flux_pair_with is not supported in RCYLINDER or RSPHERE geometry.");
+#endif
+
+    const Geometry& geom = Geom(0);
+    const amrex::RealBox& part_realbox = geom.ProbDomain();
+    const amrex::Real num_ppc_real = injector_a->num_particles_per_cell_real;
+    const auto dx = geom.CellSizeArray();
+    const auto problo = geom.ProbLoArray();
+
+#if defined(WARPX_DIM_3D)
+    const int normal_dir = injector_a->flux_normal_axis;
+#elif defined(WARPX_DIM_XZ) || defined(WARPX_DIM_RZ)
+    const int normal_dir = injector_a->flux_normal_axis / 2;
+#else
+    const int normal_dir = 0;
+#endif
+    WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+        injector_a->surface_flux_pos >= part_realbox.lo(normal_dir) + dx[normal_dir]
+            && injector_a->surface_flux_pos <= part_realbox.hi(normal_dir) - dx[normal_dir],
+        "flux_pair_with requires the injection plane to be strictly inside the domain and "
+        "at least one cell away from either boundary along its normal direction.");
+
+    // The existing path samples and partially pushes each species independently. For
+    // design (a), paired particles instead share a plane sample and use t_fract=0.
+    // This quantises paired injection to step boundaries, but avoids an un-deposited
+    // partial push: equal weights at the same point give q_A*w_A+q_B*w_B=0 up to
+    // roundoff because the charge values are exactly opposite.
+    if (((injector_a->flux_tmin >= 0._rt) && (t < injector_a->flux_tmin))
+        || ((injector_a->flux_tmax >= 0._rt) && (t >= injector_a->flux_tmax))) {
+        return;
+    }
+
+#if defined(WARPX_DIM_RZ) || defined(WARPX_DIM_RCYLINDER) || defined(WARPX_DIM_RSPHERE)
+    const amrex::Real rmax = std::min(injector_a->xmax, part_realbox.hi(0));
+    const amrex::Real rmin = std::max(injector_a->xmin, part_realbox.lo(0));
+    const amrex::Real radial_numpercell_power = injector_a->radial_numpercell_power;
+#endif
+
+    amrex::Box fine_injection_box;
+    amrex::IntVect rrfac(AMREX_D_DECL(1,1,1));
+    const bool refine_injection = findRefinedInjectionBox(fine_injection_box, rrfac);
+
+    InjectorPosition* flux_pos = injector_a->getInjectorFluxPosition();
+    InjectorFlux* inj_flux = injector_a->getInjectorFlux();
+    InjectorMomentum* inj_mom_a = injector_a->getInjectorMomentumDevice();
+    InjectorMomentum* inj_mom_b = injector_b->getInjectorMomentumDevice();
+
+    amrex::Vector<ParticleReal> pair_x;
+    amrex::Vector<ParticleReal> pair_y;
+    amrex::Vector<ParticleReal> pair_z;
+    amrex::Vector<ParticleReal> pair_ux_a;
+    amrex::Vector<ParticleReal> pair_uy_a;
+    amrex::Vector<ParticleReal> pair_uz_a;
+    amrex::Vector<ParticleReal> pair_ux_b;
+    amrex::Vector<ParticleReal> pair_uy_b;
+    amrex::Vector<ParticleReal> pair_uz_b;
+    amrex::Vector<ParticleReal> pair_weight;
+
+    PhysicalParticleContainer tmp_pc_a(&WarpX::GetInstance());
+    tmp_pc_a.species_id = getSpeciesId();
+    tmp_pc_a.m_mass = m_mass;
+    tmp_pc_a.physical_species = physical_species;
+    for (int ic = 0; ic < NumRuntimeRealComps(); ++ic) {
+        tmp_pc_a.AddRealComp(GetRealSoANames()[ic + NArrayReal], false);
+    }
+    for (int ic = 0; ic < NumRuntimeIntComps(); ++ic) {
+        tmp_pc_a.AddIntComp(GetIntSoANames()[ic + NArrayInt], false);
+    }
+    tmp_pc_a.defineAllParticleTiles();
+
+    PhysicalParticleContainer tmp_pc_b(&WarpX::GetInstance());
+    tmp_pc_b.species_id = partner.getSpeciesId();
+    tmp_pc_b.m_mass = partner.m_mass;
+    tmp_pc_b.physical_species = partner.physical_species;
+    for (int ic = 0; ic < partner.NumRuntimeRealComps(); ++ic) {
+        tmp_pc_b.AddRealComp(partner.GetRealSoANames()[ic + NArrayReal], false);
+    }
+    for (int ic = 0; ic < partner.NumRuntimeIntComps(); ++ic) {
+        tmp_pc_b.AddIntComp(partner.GetIntSoANames()[ic + NArrayInt], false);
+    }
+    tmp_pc_b.defineAllParticleTiles();
+
+    MFItInfo info;
+    if (do_tiling && amrex::Gpu::notInLaunchRegion()) {
+        info.EnableTiling(tile_size);
+    }
+#ifdef AMREX_USE_OMP
+    info.SetDynamic(true);
+#pragma omp parallel if (amrex::Gpu::notInLaunchRegion())
+#endif
+    for (MFIter mfi = MakeMFIter(0, info); mfi.isValid(); ++mfi)
+    {
+        const amrex::Box& tile_box = mfi.tilebox();
+        const amrex::RealBox tile_realbox = WarpX::getRealBox(tile_box, 0);
+
+        amrex::RealBox overlap_realbox;
+        amrex::Box overlap_box;
+        amrex::IntVect shifted;
+        const bool no_overlap = find_overlap_flux(
+            tile_realbox, part_realbox, dx, problo, *injector_a,
+            overlap_realbox, overlap_box, shifted);
+        if (no_overlap) { continue; }
+
+        const amrex::GpuArray<Real,AMREX_SPACEDIM> overlap_corner
+            {AMREX_D_DECL(overlap_realbox.lo(0),
+                          overlap_realbox.lo(1),
+                          overlap_realbox.lo(2))};
+
+        amrex::Gpu::DeviceVector<int> counts(overlap_box.numPts(), 0);
+        amrex::Gpu::DeviceVector<int> offset(overlap_box.numPts());
+        auto* pcounts = counts.data();
+        const int flux_normal_axis = injector_a->flux_normal_axis;
+        amrex::Box fine_overlap_box;
+        if (refine_injection) {
+            fine_overlap_box = overlap_box & amrex::shift(fine_injection_box, -shifted);
+        }
+
+        amrex::ParallelForRNG(overlap_box,
+        [=] AMREX_GPU_DEVICE (int i, int j, int k,
+                              amrex::RandomEngine const& engine) noexcept
+        {
+            const amrex::IntVect iv(AMREX_D_DECL(i, j, k));
+            amrex::ignore_unused(j,k);
+            auto lo = getCellCoords(overlap_corner, dx, {0._rt, 0._rt, 0._rt}, iv);
+            auto hi = getCellCoords(overlap_corner, dx, {1._rt, 1._rt, 1._rt}, iv);
+            if (!flux_pos->overlapsWith(lo, hi)) { return; }
+
+            const auto index = overlap_box.index(iv);
+            int r = 1;
+            if (fine_overlap_box.ok() && fine_overlap_box.contains(iv)) {
+                r = compute_area_weights(rrfac, flux_normal_axis);
+            }
+            pcounts[index] = static_cast<int>(num_ppc_real*r + amrex::Random(engine));
+        });
+
+        const amrex::Long max_new_particles =
+            ChunkedExclusiveSum(counts.size(), counts.data(), offset.data());
+        if (max_new_particles == 0) { continue; }
+
+        amrex::Gpu::DeviceVector<ParticleReal> x_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> y_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> z_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> ux_a_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> uy_a_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> uz_a_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> ux_b_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> uy_b_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> uz_b_d(max_new_particles);
+        amrex::Gpu::DeviceVector<ParticleReal> weight_d(max_new_particles);
+        amrex::Gpu::DeviceVector<int> valid_d(max_new_particles, 0);
+
+        auto* const poffset = offset.data();
+        auto* const x_ptr = x_d.data();
+        auto* const y_ptr = y_d.data();
+        auto* const z_ptr = z_d.data();
+        auto* const ux_a_ptr = ux_a_d.data();
+        auto* const uy_a_ptr = uy_a_d.data();
+        auto* const uz_a_ptr = uz_a_d.data();
+        auto* const ux_b_ptr = ux_b_d.data();
+        auto* const uy_b_ptr = uy_b_d.data();
+        auto* const uz_b_ptr = uz_b_d.data();
+        auto* const weight_ptr = weight_d.data();
+        auto* const valid_ptr = valid_d.data();
+        const amrex::Real scale_fac_base =
+            compute_scale_fac_area_plane(dx, num_ppc_real, flux_normal_axis);
+        constexpr amrex::Real t_fract = 0._rt;
+
+        amrex::ParallelForRNG(overlap_box,
+        [=] AMREX_GPU_DEVICE (int i, int j, int k,
+                              amrex::RandomEngine const& engine) noexcept
+        {
+            const amrex::IntVect iv(AMREX_D_DECL(i, j, k));
+            amrex::ignore_unused(j,k);
+            const auto index = overlap_box.index(iv);
+            amrex::Real scale_fac = scale_fac_base;
+            if (fine_overlap_box.ok() && fine_overlap_box.contains(iv)) {
+                scale_fac /= compute_area_weights(rrfac, flux_normal_axis);
+            }
+
+            for (int i_part = 0; i_part < pcounts[index]; ++i_part) {
+                const long ip = poffset[index] + i_part;
+                auto r = (fine_overlap_box.ok() && fine_overlap_box.contains(iv)) ?
+                    flux_pos->getPositionUnitBox(i_part, rrfac, engine) :
+                    flux_pos->getPositionUnitBox(i_part, amrex::IntVect::TheUnitVector(), engine);
+                auto pos = getCellCoords(overlap_corner, dx, r, iv);
+                auto ppos = PDim3(pos);
+
+#if defined(WARPX_DIM_3D)
+                if (!ParticleUtils::containsInclusive(tile_realbox,
+                    XDim3{ppos.x, ppos.y, ppos.z})) { continue; }
+#elif defined(WARPX_DIM_XZ) || defined(WARPX_DIM_RZ)
+                amrex::ignore_unused(k);
+                if (!ParticleUtils::containsInclusive(tile_realbox,
+                    XDim3{ppos.x, ppos.z, 0.0_prt})) { continue; }
+#elif defined(WARPX_DIM_1D_Z)
+                amrex::ignore_unused(j,k);
+                if (!ParticleUtils::containsInclusive(tile_realbox,
+                    XDim3{ppos.z, 0.0_prt, 0.0_prt})) { continue; }
+#elif defined(WARPX_DIM_RCYLINDER) || defined(WARPX_DIM_RSPHERE)
+                amrex::ignore_unused(j,k);
+                if (!ParticleUtils::containsInclusive(tile_realbox,
+                    XDim3{ppos.x, 0.0_prt, 0.0_prt})) { continue; }
+#endif
+                if (!flux_pos->insideBoundsInclusive(ppos.x, ppos.y, ppos.z)) { continue; }
+
+                auto pu_a = PDim3(inj_mom_a->getMomentum(pos.x, pos.y, pos.z, engine));
+                auto pu_b = PDim3(inj_mom_b->getMomentum(pos.x, pos.y, pos.z, engine));
+                pu_a.x *= PhysConst::c;
+                pu_a.y *= PhysConst::c;
+                pu_a.z *= PhysConst::c;
+                pu_b.x *= PhysConst::c;
+                pu_b.y *= PhysConst::c;
+                pu_b.z *= PhysConst::c;
+
+#if defined(WARPX_DIM_RZ) || defined(WARPX_DIM_RCYLINDER)
+                const amrex::Real theta = MathConst::pi * (1._rt - 2._rt*r.y);
+                const amrex::Real radial_position =
+                    std::pow(((ppos.x - rmin)/(rmax - rmin)) *
+                             (std::pow(rmax, 1._rt + radial_numpercell_power)
+                              - std::pow(rmin, 1._rt + radial_numpercell_power))
+                             + std::pow(rmin, 1._rt + radial_numpercell_power),
+                             1._rt/(1._rt + radial_numpercell_power));
+                const amrex::Real cos_theta = std::cos(theta);
+                const amrex::Real sin_theta = std::sin(theta);
+                ppos.x = radial_position*cos_theta;
+                ppos.y = radial_position*sin_theta;
+                if (flux_normal_axis != 2) {
+                    const amrex::Real ur_a = pu_a.x;
+                    const amrex::Real ut_a = pu_a.y;
+                    pu_a.x = cos_theta*ur_a - sin_theta*ut_a;
+                    pu_a.y = sin_theta*ur_a + cos_theta*ut_a;
+                    const amrex::Real ur_b = pu_b.x;
+                    const amrex::Real ut_b = pu_b.y;
+                    pu_b.x = cos_theta*ur_b - sin_theta*ut_b;
+                    pu_b.y = sin_theta*ur_b + cos_theta*ut_b;
+                }
+#elif defined(WARPX_DIM_RSPHERE)
+                const amrex::Real theta = MathConst::pi * (1._rt - 2._rt*r.y);
+                const amrex::Real sin_phi = 1._rt - 2._rt*r.z;
+                const amrex::Real cos_phi = std::sqrt(1._rt - sin_phi*sin_phi);
+                const amrex::Real phi = std::atan2(sin_phi, cos_phi);
+                const amrex::Real radial_position =
+                    std::pow(((ppos.x - rmin)/(rmax - rmin)) *
+                             (std::pow(rmax, 1._rt + radial_numpercell_power)
+                              - std::pow(rmin, 1._rt + radial_numpercell_power))
+                             + std::pow(rmin, 1._rt + radial_numpercell_power),
+                             1._rt/(1._rt + radial_numpercell_power));
+                const amrex::Real cos_theta = std::cos(theta);
+                const amrex::Real sin_theta = std::sin(theta);
+                ppos.x = radial_position*cos_phi*cos_theta;
+                ppos.y = radial_position*cos_phi*sin_theta;
+                ppos.z = radial_position*sin_phi;
+                const amrex::Real ur_a = pu_a.x;
+                const amrex::Real ut_a = pu_a.y;
+                const amrex::Real up_a = pu_a.z;
+                pu_a.x = cos_phi*cos_theta*ur_a - sin_theta*ut_a - sin_phi*cos_theta*up_a;
+                pu_a.y = cos_phi*sin_theta*ur_a + cos_theta*ut_a - sin_phi*sin_theta*up_a;
+                pu_a.z = sin_phi*ur_a + cos_phi*up_a;
+                const amrex::Real ur_b = pu_b.x;
+                const amrex::Real ut_b = pu_b.y;
+                const amrex::Real up_b = pu_b.z;
+                pu_b.x = cos_phi*cos_theta*ur_b - sin_theta*ut_b - sin_phi*cos_theta*up_b;
+                pu_b.y = cos_phi*sin_theta*ur_b + cos_theta*ut_b - sin_phi*sin_theta*up_b;
+                pu_b.z = sin_phi*ur_b + cos_phi*up_b;
+#endif
+
+                // Evaluate the validated common flux once, so both species receive the
+                // same bitwise particle weight rather than two independently rounded values.
+                const amrex::Real flux = inj_flux->getFlux(ppos.x, ppos.y, ppos.z, t);
+                if (flux <= 0._rt) { continue; }
+
+                amrex::Real weight = flux * scale_fac * dt;
+#if defined(WARPX_DIM_RZ) || defined(WARPX_DIM_RCYLINDER)
+                if (flux_normal_axis != 1) {
+                    const amrex::Real coeff = 2._rt*MathConst::pi/(1._rt + radial_numpercell_power)
+                        *(rmax - std::pow(rmax, -radial_numpercell_power)
+                          *std::pow(rmin, 1._rt + radial_numpercell_power))
+                        *(rmax/(rmax - rmin));
+                    weight *= coeff*std::pow(radial_position/rmax,
+                                             1._rt - radial_numpercell_power);
+                }
+#elif defined(WARPX_DIM_RSPHERE)
+                const amrex::Real coeff = 4._rt*MathConst::pi/(1._rt + radial_numpercell_power)
+                    *(rmax*rmax - std::pow(rmax, 1._rt - radial_numpercell_power)
+                      *std::pow(rmin, 1._rt + radial_numpercell_power))
+                    *(rmax/(rmax - rmin));
+                weight *= coeff*std::pow(radial_position/rmax,
+                                         2._rt - radial_numpercell_power);
+#endif
+
+                // t_fract is deliberately the shared zero for design (a); no partial
+                // UpdatePosition is performed for either species.
+                amrex::ignore_unused(t_fract);
+                x_ptr[ip] = ppos.x;
+                y_ptr[ip] = ppos.y;
+                z_ptr[ip] = ppos.z;
+                ux_a_ptr[ip] = pu_a.x;
+                uy_a_ptr[ip] = pu_a.y;
+                uz_a_ptr[ip] = pu_a.z;
+                ux_b_ptr[ip] = pu_b.x;
+                uy_b_ptr[ip] = pu_b.y;
+                uz_b_ptr[ip] = pu_b.z;
+                weight_ptr[ip] = weight;
+                valid_ptr[ip] = 1;
+            }
+        });
+
+        amrex::Gpu::synchronize();
+        amrex::Gpu::HostVector<ParticleReal> x_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> y_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> z_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> ux_a_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> uy_a_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> uz_a_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> ux_b_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> uy_b_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> uz_b_h(max_new_particles);
+        amrex::Gpu::HostVector<ParticleReal> weight_h(max_new_particles);
+        amrex::Gpu::HostVector<int> valid_h(max_new_particles);
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost, x_d.begin(), x_d.end(), x_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost, y_d.begin(), y_d.end(), y_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost, z_d.begin(), z_d.end(), z_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost,
+                              ux_a_d.begin(), ux_a_d.end(), ux_a_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost,
+                              uy_a_d.begin(), uy_a_d.end(), uy_a_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost,
+                              uz_a_d.begin(), uz_a_d.end(), uz_a_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost,
+                              ux_b_d.begin(), ux_b_d.end(), ux_b_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost,
+                              uy_b_d.begin(), uy_b_d.end(), uy_b_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost,
+                              uz_b_d.begin(), uz_b_d.end(), uz_b_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost,
+                              weight_d.begin(), weight_d.end(), weight_h.begin());
+        amrex::Gpu::copyAsync(amrex::Gpu::deviceToHost,
+                              valid_d.begin(), valid_d.end(), valid_h.begin());
+        amrex::Gpu::synchronize();
+
+#ifdef AMREX_USE_OMP
+#pragma omp critical (add_plasma_flux_pair_samples)
+#endif
+        {
+            for (amrex::Long ip = 0; ip < max_new_particles; ++ip) {
+                if (!valid_h[ip]) { continue; }
+                pair_x.push_back(x_h[ip]);
+                pair_y.push_back(y_h[ip]);
+                pair_z.push_back(z_h[ip]);
+                pair_ux_a.push_back(ux_a_h[ip]);
+                pair_uy_a.push_back(uy_a_h[ip]);
+                pair_uz_a.push_back(uz_a_h[ip]);
+                pair_ux_b.push_back(ux_b_h[ip]);
+                pair_uy_b.push_back(uy_b_h[ip]);
+                pair_uz_b.push_back(uz_b_h[ip]);
+                pair_weight.push_back(weight_h[ip]);
+            }
+        }
+    }
+
+    // All shared samples from all local tiles are collected before either species
+    // is redistributed. The species receive independent IDs; array order is not
+    // used to establish a pairing after this point. The temporary containers keep
+    // boundary handling from inspecting or removing existing live particles.
+    amrex::Vector<amrex::Vector<ParticleReal>> attr_real_a{pair_weight};
+    amrex::Vector<amrex::Vector<ParticleReal>> attr_real_b{pair_weight};
+    const amrex::Vector<amrex::Vector<int>> attr_int;
+    const auto npair = static_cast<amrex::Long>(pair_x.size());
+    tmp_pc_a.AddNParticles(0, npair, pair_x, pair_y, pair_z,
+                           pair_ux_a, pair_uy_a, pair_uz_a,
+                           1, attr_real_a, 0, attr_int, 1);
+    tmp_pc_b.AddNParticles(0, npair, pair_x, pair_y, pair_z,
+                           pair_ux_b, pair_uy_b, pair_uz_b,
+                           1, attr_real_b, 0, attr_int, 1);
+
+#ifdef AMREX_USE_EB
+    if (EB::enabled())
+    {
+        using warpx::fields::FieldType;
+        auto& warpx = WarpX::GetInstance();
+        auto const& distance_to_eb =
+            warpx.m_fields.get_mr_levels(FieldType::distance_to_eb, warpx.finestLevel());
+        scrapeParticlesAtEB(tmp_pc_a, distance_to_eb, ParticleBoundaryProcess::Absorb());
+        scrapeParticlesAtEB(tmp_pc_b, distance_to_eb, ParticleBoundaryProcess::Absorb());
+    }
+#endif
+
+    tmp_pc_a.Redistribute();
+    tmp_pc_b.Redistribute();
+    this->addParticles(tmp_pc_a, true);
+    partner.addParticles(tmp_pc_b, true);
+}

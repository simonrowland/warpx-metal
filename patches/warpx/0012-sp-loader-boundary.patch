+    template <typename T>
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    T nextafter_backend (T x, T y)
+    {
+#ifdef AMREX_USE_SYCL
+        if constexpr (std::is_same_v<T, float>) {
+            if (x == y) { return y; }
+            using UInt = std::uint32_t;
+            UInt bits = sycl::bit_cast<UInt>(x);
+            if (x == 0.0f) {
+                bits = (y > 0.0f) ? UInt(1) : UInt(0x80000001u);
+            } else if ((x > 0.0f) == (y > x)) {
+                ++bits;
+            } else {
+                --bits;
+            }
+            return sycl::bit_cast<float>(bits);
+        } else {
+            return std::nextafter(x, y);
+        }
+#else
+        return std::nextafter(x, y);
+#endif
+    }

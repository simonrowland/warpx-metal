diff --git a/tests/jext/oracle_tables.py b/tests/jext/oracle_tables.py
new file mode 100644
index 000000000..4cc06baf7
--- /dev/null
+++ b/tests/jext/oracle_tables.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Independent Yee-stagger oracle tables for J_ext self-check.
+
+Half-offsets are literal constants transcribed from WarpX.cpp AllocLevelMFs
+(jx/jy/jz_nodal_flag tables), NOT a re-expression of the injection kernel.
+"""
+import math
+
+# Literal half-offset tables: 0.0 = NODE, 0.5 = CELL
+# Source: WarpX.cpp AllocLevelMFs ~L2435-2477
+HALF_OFF_1D = {
+    # axis = physical z
+    0: (0.0,),   # Jx NODE
+    1: (0.0,),   # Jy NODE
+    2: (0.5,),   # Jz CELL
+}
+HALF_OFF_XZ = {
+    # axes = (x, z)
+    0: (0.5, 0.0),  # Jx CELL,x NODE,z
+    1: (0.0, 0.0),  # Jy NODE,x NODE,z
+    2: (0.0, 0.5),  # Jz NODE,x CELL,z
+}
+HALF_OFF_3D = {
+    # axes = (x, y, z)
+    0: (0.5, 0.0, 0.0),  # Jx
+    1: (0.0, 0.5, 0.0),  # Jy
+    2: (0.0, 0.0, 0.5),  # Jz
+}
+
+# Baked analytic multifab amplitude
+K_ANALYTIC_JY = 1.25
+
+
+def pos_xz(comp, i, j, lo=(-1.0, -1.0), dx=(2.0 / 32, 2.0 / 32)):
+    hx, hz = HALF_OFF_XZ[comp]
+    x = lo[0] + (i + hx) * dx[0]
+    z = lo[1] + (j + hz) * dx[1]
+    return (x, 0.0, z)
+
+
+def main():
+    print("analytic_multifab Jy expected:", K_ANALYTIC_JY)
+    h = 2.0 / 32
+    PI = math.pi
+    for i, j in [(8, 8), (0, 0), (16, 16)]:
+        x_r, _, z_r = pos_xz(0, i, j, dx=(h, h))
+        x_l, _, z_l = pos_xz(0, i - 1, j, dx=(h, h))
+        Jx_r = math.cos(PI * x_r) * math.sin(PI * z_r)
+        Jx_l = math.cos(PI * x_l) * math.sin(PI * z_l)
+        x_zr, _, z_zr = pos_xz(2, i, j, dx=(h, h))
+        x_zl, _, z_zl = pos_xz(2, i, j - 1, dx=(h, h))
+        Jz_r = -math.sin(PI * x_zr) * math.cos(PI * z_zr)
+        Jz_l = -math.sin(PI * x_zl) * math.cos(PI * z_zl)
+        divh = (Jx_r - Jx_l) / h + (Jz_r - Jz_l) / h
+        print(f"node ({i},{j}): div_h={divh:.6e}")
+    # Table identity smoke
+    assert HALF_OFF_XZ[0] == (0.5, 0.0)
+    assert HALF_OFF_3D[2] == (0.0, 0.0, 0.5)
+    print("table identity OK")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/jext/run_jext_regression.sh b/tests/jext/run_jext_regression.sh
new file mode 100755
index 000000000..b696a8c0d
--- /dev/null
+++ b/tests/jext/run_jext_regression.sh
@@ -0,0 +1,246 @@
+#!/usr/bin/env bash
+# J_ext regression runner — CPU-only, minutes-scale.
+# Usage: run_jext_regression.sh <warpx_exe> [logdir]
+set -euo pipefail
+EXE="${1:?warpx executable}"
+LOGDIR="${2:-$(dirname "$0")/logs}"
+mkdir -p "$LOGDIR"
+INDIR="$(cd "$(dirname "$0")/inputs" && pwd)"
+PASS=0
+FAIL=0
+SKIP=0
+
+parse_final_energy() {
+  local f="$1"
+  if [ ! -f "$f" ]; then echo "MISSING"; return; fi
+  awk 'BEGIN{v="EMPTY"} !/^#/ && NF>=3 {v=$3} END{print v}' "$f"
+}
+
+# SHA256 of WarpX plotfile field payloads (Cell_D_*). Empty if none.
+plotfile_field_sha() {
+  local root="$1"
+  if [ ! -d "$root" ]; then echo "MISSING_DIR"; return; fi
+  # Sort paths for stable aggregate; hash file contents only.
+  local files
+  files=$(find "$root" -type f -name 'Cell_D_*' | LC_ALL=C sort)
+  if [ -z "$files" ]; then
+    # fallback: any Level_*/Cell* binary
+    files=$(find "$root" -type f \( -name 'Cell_D_*' -o -name 'Cell_H_*' \) | LC_ALL=C sort)
+  fi
+  if [ -z "$files" ]; then echo "MISSING_CELLS"; return; fi
+  # Aggregate content-only digests (NOT paths — absolute paths would
+  # falsify identity between two run directories with identical field data).
+  echo "$files" | while IFS= read -r f; do
+    shasum -a 256 "$f" | awk '{print $1}'
+  done | shasum -a 256 | awk '{print $1}'
+}
+
+run_ok() {
+  local name="$1" input="$2"
+  local require_self="${3:-0}"
+  local require_div="${4:-0}"
+  local max_r="${5:-}"
+  local require_seam="${6:-0}"
+  local log="$LOGDIR/${name}.log"
+  local rundir="$LOGDIR/run_${name}"
+  rm -rf "$rundir"
+  mkdir -p "$rundir"
+  echo "[RUN] $name"
+  if (cd "$rundir" && "$EXE" "$input") >"$log" 2>&1; then
+    local ok=1
+    if [ "$require_self" = "1" ]; then
+      if ! grep -q "J_ext analytic self-check: max_abs_err=" "$log"; then
+        echo "  [FAIL] $name missing analytic self-check marker"; ok=0
+      else
+        err=$(grep "J_ext analytic self-check: max_abs_err=" "$log" | tail -1)
+        echo "    self-check: $err"
+        if ! grep -q "oracle=JextStaggerOracle" "$log"; then
+          echo "  [FAIL] $name self-check did not use JextStaggerOracle"; ok=0
+        fi
+      fi
+    fi
+    if [ "$require_div" = "1" ]; then
+      if ! grep -q "J_ext div-gate:" "$log"; then
+        echo "  [FAIL] $name missing div-gate marker"; ok=0
+      else
+        dg=$(grep "J_ext div-gate:" "$log" | tail -1)
+        echo "    div-gate: $dg"
+        if [ -n "$max_r" ]; then
+          r=$(echo "$dg" | sed -n 's/.*r=|div|\*h\/|J|=\([0-9.eE+-]*\).*/\1/p')
+          if ! python3 -c "import sys; r=float('$r'); m=float('$max_r'); sys.exit(0 if r<=m else 1)"; then
+            echo "  [FAIL] $name div-gate r=$r exceeds max_r=$max_r"; ok=0
+          fi
+        fi
+      fi
+    fi
+    if [ "$require_seam" = "1" ]; then
+      if ! grep -q "J_ext periodic-seam: comp=" "$log"; then
+        echo "  [FAIL] $name missing periodic-seam marker"; ok=0
+      else
+        seam=$(grep "J_ext periodic-seam: comp=" "$log" | tail -1)
+        echo "    seam: $seam"
+      fi
+    fi
+    # Feature-off must produce zero J_ext-attributable stdout.
+    if [ "$name" = "pec_plasma_noop_2d" ]; then
+      if grep -E "J_ext |J_ext_" "$log" >/dev/null; then
+        echo "  [FAIL] $name feature-off log contains J_ext-attributable output"; ok=0
+        grep -E "J_ext |J_ext_" "$log" | head -5 | sed 's/^/    /'
+      else
+        echo "    feature-off: zero J_ext-attributable stdout"
+      fi
+    fi
+    if [ "$ok" = "1" ]; then
+      echo "  [PASS] $name"; PASS=$((PASS+1))
+    else
+      tail -20 "$log" | sed 's/^/    /'; FAIL=$((FAIL+1))
+    fi
+  else
+    echo "  [FAIL] $name (see $log)"
+    tail -20 "$log" | sed 's/^/    /'
+    FAIL=$((FAIL+1))
+  fi
+}
+
+run_assert() {
+  local name="$1" input="$2" needle="$3"
+  local log="$LOGDIR/${name}.log"
+  local rundir="$LOGDIR/run_${name}"
+  rm -rf "$rundir"; mkdir -p "$rundir"
+  echo "[ASSERT] $name"
+  set +e
+  (cd "$rundir" && "$EXE" "$input") >"$log" 2>&1
+  rc=$?
+  set -e
+  # Flatten whitespace so needles can span AMReX line-wrapped abort text.
+  # Bound the wildcard so two substrings must appear within ~300 chars
+  # (not anywhere in the whole log in any order).
+  local flat
+  flat=$(tr '\n#' '  ' <"$log" | tr -s ' ')
+  if [ $rc -ne 0 ] && echo "$flat" | grep -qiE "$needle"; then
+    echo "  [PASS] $name (aborted with expected message)"
+    grep -E "J_ext|div\(J_ext\)|warpx\.J_ext|do_current_centering" "$log" | tail -5 | sed "s/^/    /" || true
+    PASS=$((PASS+1))
+  elif [ $rc -ne 0 ]; then
+    echo "  [FAIL] $name aborted but message missing (needle=$needle)"
+    tail -30 "$log" | sed 's/^/    /'; FAIL=$((FAIL+1))
+  else
+    echo "  [FAIL] $name was expected to abort"; FAIL=$((FAIL+1))
+  fi
+}
+
+run_energy_pair() {
+  local dim="$1"
+  local driven="energy_driven_${dim}"
+  local undriven="energy_undriven_${dim}"
+  local log_d="$LOGDIR/${driven}.log"
+  local log_u="$LOGDIR/${undriven}.log"
+  local rd="$LOGDIR/run_${driven}"
+  local ru="$LOGDIR/run_${undriven}"
+  rm -rf "$rd" "$ru"; mkdir -p "$rd" "$ru"
+  echo "[ENERGY] driven+undriven ${dim}"
+  local ok=1
+  if ! (cd "$rd" && "$EXE" "$INDIR/${driven}") >"$log_d" 2>&1; then
+    echo "  [FAIL] ${driven} non-zero exit"; tail -20 "$log_d" | sed 's/^/    /'; ok=0
+  fi
+  if ! (cd "$ru" && "$EXE" "$INDIR/${undriven}") >"$log_u" 2>&1; then
+    echo "  [FAIL] ${undriven} non-zero exit"; tail -20 "$log_u" | sed 's/^/    /'; ok=0
+  fi
+  local fe_d="$rd/diags/reducedfiles/fieldenergy.txt"
+  local fe_u="$ru/diags/reducedfiles/fieldenergy.txt"
+  local Wd Wu
+  Wd=$(parse_final_energy "$fe_d")
+  Wu=$(parse_final_energy "$fe_u")
+  echo "    driven final W=$Wd  undriven final W=$Wu"
+  if [ "$Wd" = "MISSING" ] || [ "$Wd" = "EMPTY" ]; then echo "  [FAIL] missing driven fieldenergy"; ok=0; fi
+  if [ "$Wu" = "MISSING" ] || [ "$Wu" = "EMPTY" ]; then echo "  [FAIL] missing undriven fieldenergy"; ok=0; fi
+  # Two-sided energy band around analytic 0.127062 J (±20%).
+  # Derivation (checked in energy_driven_* deck comments + here):
+  #   unit domain, no particles, Jy=1e4*min(1,t/1e-10), dt=5e-12, 40 steps
+  #   tf=2e-10; ∫J dt = 1e4*(1e-10/2)+1e4*1e-10 = 1.5e-6
+  #   E_y = 1.5e-6/ε0 ≈ 1.69414e5 V/m
+  #   W = ½ ε0 E² · V = 0.127062 J  (V=1 every dim)
+  #   ±20% band: [0.10165, 0.15247] — a 4× over-injection (W→0.508) FAILS;
+  #   undriven |W| < 1e-12 (exact 0 with J≡0, no particles).
+  if [ "$ok" = "1" ]; then
+    if ! python3 -c "
+import sys
+Wd=float('$Wd'); Wu=float('$Wu')
+W_expect=0.127062
+rel_band=0.20
+ok = (abs(Wd/W_expect - 1.0) <= rel_band) and (abs(Wu) < 1e-12)
+sys.exit(0 if ok else 1)
+"; then
+      echo "  [FAIL] energy assert: need |Wd/0.127062-1|<=0.20 and |Wu|<1e-12; got Wd=$Wd Wu=$Wu"; ok=0
+    fi
+  fi
+  if [ "$ok" = "1" ]; then
+    echo "  [PASS] energy_pair_${dim} (driven W=$Wd within ±20% of 0.127062; |undriven|=$Wu < 1e-12)"; PASS=$((PASS+1))
+  else
+    FAIL=$((FAIL+1))
+  fi
+}
+
+case "$EXE" in
+  *1d*|*1D*) DIM=1d ;;
+  *2d*|*2D*) DIM=2d ;;
+  *3d*|*3D*) DIM=3d ;;
+  *) echo "Cannot infer dim from exe name $EXE"; exit 2 ;;
+esac
+
+run_ok "analytic_multifab_${DIM}" "$INDIR/analytic_multifab_${DIM}" 1 1 "1e-6"
+run_ok "filter_identity_${DIM}" "$INDIR/filter_identity_${DIM}" 1 1 "1e-6"
+# Discriminating decks: observed r ~ 6e-8; use 1e-6 (not vacuous 1e-4 == in-code tol).
+if [ "$DIM" = "1d" ]; then
+  run_ok "solenoidal_antenna_${DIM}" "$INDIR/solenoidal_antenna_${DIM}" 1 1 "1e-6"
+else
+  run_ok "solenoidal_antenna_${DIM}" "$INDIR/solenoidal_antenna_${DIM}" 1 1 "1e-6"
+fi
+run_energy_pair "$DIM"
+run_assert "monopole_abort_${DIM}" "$INDIR/monopole_abort_${DIM}" \
+  "warpx\\.J_ext_grid_init_style.{0,200}discrete div|warpx\\.J_ext_grid_init_style discrete div"
+
+if [ "$DIM" = "2d" ]; then
+  run_ok "pec_plasma_noop_2d" "$INDIR/pec_plasma_noop_2d" 0 0
+  run_ok "pec_jext_zero_2d" "$INDIR/pec_jext_zero_2d" 0 0
+  # Feature-off bit-identity: SHA256 of plotfile field data (same binary,
+  # with vs without J_ext keys; ≥3 steps; PEC). Dropped FieldEnergy ±2.2%
+  # floored comparison and the tautological count=1 gauge.
+  echo "[BIT-ID] plotfile field SHA256 noop vs jext_zero"
+  sha_a=$(plotfile_field_sha "$LOGDIR/run_pec_plasma_noop_2d")
+  sha_b=$(plotfile_field_sha "$LOGDIR/run_pec_jext_zero_2d")
+  echo "    noop sha=$sha_a"
+  echo "    zero sha=$sha_b"
+  if [ "$sha_a" = "MISSING_DIR" ] || [ "$sha_a" = "MISSING_CELLS" ] || \
+     [ "$sha_b" = "MISSING_DIR" ] || [ "$sha_b" = "MISSING_CELLS" ]; then
+    echo "  [FAIL] pec_feature_off_bitid missing plotfile Cell_D data"
+    FAIL=$((FAIL+1))
+  elif [ "$sha_a" = "$sha_b" ]; then
+    echo "  [PASS] pec_feature_off_bitid (plotfile field SHA256 identical)"; PASS=$((PASS+1))
+  else
+    echo "  [FAIL] pec_feature_off_bitid SHA mismatch"; FAIL=$((FAIL+1))
+  fi
+fi
+
+if [ "$DIM" = "3d" ]; then
+  run_ok "periodic_seam_3d" "$INDIR/periodic_seam_3d" 1 1 "1e-6" 1
+  # y-z curl pair: exercises Jz collocation (n_jz=(1,1,0))
+  run_ok "solenoidal_antenna_yz_3d" "$INDIR/solenoidal_antenna_yz_3d" 1 1 "1e-6"
+  # Bound wildcards to ~200 chars between anchor tokens.
+  run_assert "assert_amr" "$INDIR/assert_amr" "warpx\\.J_ext_grid_init_style.{0,200}(level 0 only|AMR)"
+  run_assert "assert_collocated" "$INDIR/assert_collocated" "warpx\\.J_ext_grid_init_style.{0,200}(staggered|collocated)"
+  run_assert "assert_hybrid" "$INDIR/assert_hybrid" "warpx\\.J_ext_grid_init_style.{0,200}(hybrid|staggered)"
+  # do_current_centering: base WarpX aborts first (hybrid required); accept that
+  # fail-closed message. The J_ext clause is defence-in-depth / currently unreachable.
+  run_assert "assert_current_centering" "$INDIR/assert_current_centering" "warpx\\.do_current_centering=1 can be used only with|warpx\\.J_ext_grid_init_style.{0,200}current_centering"
+  run_assert "assert_vay" "$INDIR/assert_vay" "warpx\\.J_ext_grid_init_style.{0,200}vay"
+  run_assert "assert_moving_window" "$INDIR/assert_moving_window" "warpx\\.J_ext_grid_init_style.{0,200}moving window"
+  run_assert "assert_pml_in_domain" "$INDIR/assert_pml_in_domain" "warpx\\.J_ext_grid_init_style.{0,200}do_pml_in_domain"
+  run_assert "assert_implicit" "$INDIR/assert_implicit" "warpx\\.J_ext_grid_init_style.{0,200}(implicit|ordinary explicit)"
+  run_assert "assert_eb" "$INDIR/assert_eb" "warpx\\.J_ext_grid_init_style.{0,200}embedded boundaries"
+fi

diff --git a/tests/jext/inputs/energy_driven_1d b/tests/jext/inputs/energy_driven_1d
new file mode 100644
index 000000000..6823d2f58
--- /dev/null
+++ b/tests/jext/inputs/energy_driven_1d
@@ -0,0 +1,30 @@
+# Analytic expectation (unit domain, no particles, B stays 0):
+#   Jy = 1e4 * min(1, t/1e-10), dt=5e-12, max_step=40 => t_f=2e-10
+#   ∫_0^{tf} J dt = 1e4*(1e-10/2) + 1e4*(1e-10) = 1.5e-6 A·s/m²
+#   E_y = 1.5e-6 / ε0 = 1.69414e5 V/m
+#   W = ½ ε0 E² · V = 0.127062 J  (V=1 in every dim)
+# Runner asserts driven W within ±20% of 0.127062 J (catches 4× over-injection)
+# and undriven |W| < 1e-12 J.
+max_step = 40
+amr.n_cell = 64
+amr.max_level = 0
+amr.max_grid_size = 32
+geometry.dims = 1
+geometry.prob_lo = 0.0
+geometry.prob_hi = 1.0
+boundary.field_lo = periodic
+boundary.field_hi = periodic
+warpx.const_dt = 5.0e-12
+warpx.verbose = 1
+algo.maxwell_solver = yee
+algo.current_deposition = direct
+warpx.use_filter = 0
+warpx.grid_type = staggered
+warpx.J_ext_grid_init_style = parse_J_ext_grid_function
+warpx.Jx_external_grid_function(x,y,z,t) = "0.0"
+warpx.Jy_external_grid_function(x,y,z,t) = "1.0e4 * min(1.0, t/1.0e-10)"
+warpx.Jz_external_grid_function(x,y,z,t) = "0.0"
+warpx.J_ext_div_check_interval = 0
+warpx.reduced_diags_names = fieldenergy
+fieldenergy.type = FieldEnergy
+fieldenergy.intervals = 1

index 000000000..782d5135f
--- /dev/null
+++ b/Source/Evolve/JextStaggerOracle.H
@@ -0,0 +1,184 @@
+/**
+ * Independent Yee-stagger position oracle for J_ext analytic self-check.
+ *
+ * This is NOT an algebraic re-expression of the injection kernel in
+ * WarpXEvolve.cpp. Half-cell offsets are literal constants transcribed from
+ * WarpX::AllocLevelMFs nodal-flag tables (WarpX.cpp, ~L2435-2477) and the
+ * AMReX Yee IndexType convention used there:
+ *
+ *   // WarpX.cpp AllocLevelMFs — staggered current_fp nodal flags
+ *   #if WARPX_DIM_1D_Z
+ *     jx_nodal_flag = IntVect(1);       // NODE along z
+ *     jy_nodal_flag = IntVect(1);       // NODE along z
+ *     jz_nodal_flag = IntVect(0);       // CELL along z
+ *   #elif WARPX_DIM_XZ
+ *     jx_nodal_flag = IntVect(0,1);     // CELL,x  NODE,z
+ *     jy_nodal_flag = IntVect(1,1);     // NODE,x  NODE,z
+ *     jz_nodal_flag = IntVect(1,0);     // NODE,x  CELL,z
+ *   #elif WARPX_DIM_3D
+ *     jx_nodal_flag = IntVect(0,1,1);   // CELL,x  NODE,y  NODE,z
+ *     jy_nodal_flag = IntVect(1,0,1);   // NODE,x  CELL,y  NODE,z
+ *     jz_nodal_flag = IntVect(1,1,0);   // NODE,x  NODE,y  CELL,z
+ *   #endif
+ *
+ * Convention: nodal flag 1 => half-offset 0 (sample on node);
+ *             nodal flag 0 => half-offset 0.5 (sample on face center).
+ * Physical position along axis a:
+ *   x_a = lo_a + (i_a + half_offset_a) * dx_a
+ *
+ * Callers pass the physical component index (0=Jx, 1=Jy, 2=Jz). The oracle
+ * never reads live MultiFab::ixType() — a shared live-nodal bug cannot move
+ * injection and reference together.
+ */
+#ifndef WARPX_JEXT_STAGGER_ORACLE_H_
+#define WARPX_JEXT_STAGGER_ORACLE_H_
+
+#include <AMReX_Array.H>
+#include <AMReX_GpuQualifiers.H>
+#include <AMReX_REAL.H>
+#include <AMReX_Extension.H>
+#include <AMReX_GpuControl.H>
+#include <AMReX_Print.H>
+
+#include <array>
+#include <cmath>
+
+namespace warpx {
+namespace jext_oracle {
+
+// ---------------------------------------------------------------------------
+// Literal half-offset tables (0.0 = NODE, 0.5 = CELL).
+// Indexed [component 0..2][spatial axis 0..AMREX_SPACEDIM-1].
+// Transcribed from WarpX.cpp AllocLevelMFs (see file header citation).
+// ---------------------------------------------------------------------------
+#if defined(WARPX_DIM_1D_Z)
+// Axis 0 = physical z. Jx NODE, Jy NODE, Jz CELL.
+static constexpr amrex::Real kHalfOff[3][1] = {
+    { amrex::Real(0.0) },  // Jx
+    { amrex::Real(0.0) },  // Jy
+    { amrex::Real(0.5) }   // Jz
+};
+#elif defined(WARPX_DIM_XZ) || defined(WARPX_DIM_RZ)
+// Axis 0 = x, axis 1 = z. Jx(0,1), Jy(1,1), Jz(1,0).
+static constexpr amrex::Real kHalfOff[3][2] = {
+    { amrex::Real(0.5), amrex::Real(0.0) },  // Jx: CELL x, NODE z
+    { amrex::Real(0.0), amrex::Real(0.0) },  // Jy: NODE x, NODE z
+    { amrex::Real(0.0), amrex::Real(0.5) }   // Jz: NODE x, CELL z
+};
+#else
+// 3D. Jx(0,1,1), Jy(1,0,1), Jz(1,1,0).
+static constexpr amrex::Real kHalfOff[3][3] = {
+    { amrex::Real(0.5), amrex::Real(0.0), amrex::Real(0.0) },  // Jx
+    { amrex::Real(0.0), amrex::Real(0.5), amrex::Real(0.0) },  // Jy
+    { amrex::Real(0.0), amrex::Real(0.0), amrex::Real(0.5) }   // Jz
+};
+#endif
+
+/**
+ * Position of current component `comp` (0=Jx,1=Jy,2=Jz) at index (i,j,k).
+ * Uses only the hardcoded half-offset table above — never live nodal flags.
+ */
+AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+std::array<amrex::Real,3>
+position (
+    int comp,
+    amrex::GpuArray<amrex::Real,AMREX_SPACEDIM> const& dx,
+    amrex::GpuArray<amrex::Real,AMREX_SPACEDIM> const& lo,
+    int i, int j, int k) noexcept
+{
+    constexpr amrex::Real zero = amrex::Real(0.0);
+#if defined(WARPX_DIM_1D_Z)
+    amrex::ignore_unused(j, k);
+    const amrex::Real x = zero;
+    const amrex::Real y = zero;
+    const amrex::Real z = lo[0]
+        + (static_cast<amrex::Real>(i) + kHalfOff[comp][0]) * dx[0];
+    return {x, y, z};
+#elif defined(WARPX_DIM_XZ) || defined(WARPX_DIM_RZ)
+    amrex::ignore_unused(k);
+    const amrex::Real x = lo[0]
+        + (static_cast<amrex::Real>(i) + kHalfOff[comp][0]) * dx[0];
+    const amrex::Real y = zero;
+    const amrex::Real z = lo[1]
+        + (static_cast<amrex::Real>(j) + kHalfOff[comp][1]) * dx[1];
+    return {x, y, z};
+#else
+    const amrex::Real x = lo[0]
+        + (static_cast<amrex::Real>(i) + kHalfOff[comp][0]) * dx[0];
+    const amrex::Real y = lo[1]
+        + (static_cast<amrex::Real>(j) + kHalfOff[comp][1]) * dx[1];
+    const amrex::Real z = lo[2]
+        + (static_cast<amrex::Real>(k) + kHalfOff[comp][2]) * dx[2];
+    return {x, y, z};
+#endif
+}
+
+// Baked amplitude for the analytic_multifab_* family (constant Jy = 1.25).
+// Hard-asserted when the deck's max |J_ref| is within 1e-3 of this value.
+static constexpr amrex::Real kAnalyticJy = amrex::Real(1.25);
+
+/**
+ * Host-side hard assert of the stagger table + a position-dependent spot.
+ * Call once from the analytic self-check path (rank 0).
+ *
+ * Spot geometry (matches analytic_multifab / solenoidal decks on [-1,1]^d
+ * with n_cell = 32 in 1d/2d and 16 in 3d is NOT assumed here — we use the
+ * live lo/dx and only assert table identity + one algebraic identity).
+ *
+ * Table identity: kHalfOff matches the WarpX.cpp citation above.
+ * Algebraic identity: for any cell-centered component, position(i) - position(i-1)
+ * equals dx on that axis (half-offsets cancel).
+ */
+AMREX_FORCE_INLINE
+void assert_stagger_table_and_spot (
+    amrex::GpuArray<amrex::Real,AMREX_SPACEDIM> const& dx,
+    amrex::GpuArray<amrex::Real,AMREX_SPACEDIM> const& lo)
+{
+    amrex::ignore_unused(lo);
+#if defined(WARPX_DIM_1D_Z)
+    // NODE=0, CELL=0.5  — WarpX.cpp L2442-2444
+    AMREX_ALWAYS_ASSERT(kHalfOff[0][0] == amrex::Real(0.0)); // Jx NODE
+    AMREX_ALWAYS_ASSERT(kHalfOff[1][0] == amrex::Real(0.0)); // Jy NODE
+    AMREX_ALWAYS_ASSERT(kHalfOff[2][0] == amrex::Real(0.5)); // Jz CELL
+#elif defined(WARPX_DIM_XZ) || defined(WARPX_DIM_RZ)
+    // WarpX.cpp L2465-2467 (XZ block)
+    AMREX_ALWAYS_ASSERT(kHalfOff[0][0] == amrex::Real(0.5) && kHalfOff[0][1] == amrex::Real(0.0));
+    AMREX_ALWAYS_ASSERT(kHalfOff[1][0] == amrex::Real(0.0) && kHalfOff[1][1] == amrex::Real(0.0));
+    AMREX_ALWAYS_ASSERT(kHalfOff[2][0] == amrex::Real(0.0) && kHalfOff[2][1] == amrex::Real(0.5));
+#else
+    // WarpX.cpp L2475-2477
+    AMREX_ALWAYS_ASSERT(kHalfOff[0][0] == amrex::Real(0.5) && kHalfOff[0][1] == amrex::Real(0.0) && kHalfOff[0][2] == amrex::Real(0.0));
+    AMREX_ALWAYS_ASSERT(kHalfOff[1][0] == amrex::Real(0.0) && kHalfOff[1][1] == amrex::Real(0.5) && kHalfOff[1][2] == amrex::Real(0.0));
+    AMREX_ALWAYS_ASSERT(kHalfOff[2][0] == amrex::Real(0.0) && kHalfOff[2][1] == amrex::Real(0.0) && kHalfOff[2][2] == amrex::Real(0.5));
+#endif
+    // Algebraic identity: neighbor difference along each axis equals dx
+    // independent of half-offset (cancels).
+    for (int c = 0; c < 3; ++c) {
+        const auto p0 = position(c, dx, lo, 0, 0, 0);
+        const auto p1 = position(c, dx, lo, 1, 0, 0);
+#if defined(WARPX_DIM_1D_Z)
+        AMREX_ALWAYS_ASSERT(std::abs(static_cast<double>(p1[2] - p0[2] - dx[0])) < 1e-12);
+#elif defined(WARPX_DIM_XZ) || defined(WARPX_DIM_RZ)
+        AMREX_ALWAYS_ASSERT(std::abs(static_cast<double>(p1[0] - p0[0] - dx[0])) < 1e-12);
+        const auto q0 = position(c, dx, lo, 0, 0, 0);
+        const auto q1 = position(c, dx, lo, 0, 1, 0);
+        AMREX_ALWAYS_ASSERT(std::abs(static_cast<double>(q1[2] - q0[2] - dx[1])) < 1e-12);
+#else
+        AMREX_ALWAYS_ASSERT(std::abs(static_cast<double>(p1[0] - p0[0] - dx[0])) < 1e-12);
+        const auto q0 = position(c, dx, lo, 0, 0, 0);
+        const auto q1 = position(c, dx, lo, 0, 1, 0);
+        const auto r0 = position(c, dx, lo, 0, 0, 0);
+        const auto r1 = position(c, dx, lo, 0, 0, 1);
+        AMREX_ALWAYS_ASSERT(std::abs(static_cast<double>(q1[1] - q0[1] - dx[1])) < 1e-12);
+        AMREX_ALWAYS_ASSERT(std::abs(static_cast<double>(r1[2] - r0[2] - dx[2])) < 1e-12);
+#endif
+    }
+    // Hard assert baked constant is the documented analytic multifab Jy.
+    AMREX_ALWAYS_ASSERT(kAnalyticJy == amrex::Real(1.25));
+    amrex::ignore_unused(dx);
+}
+
+} // namespace jext_oracle
+} // namespace warpx
+
+#endif
diff --git a/Source/Evolve/WarpXEvolve.cpp b/Source/Evolve/WarpXEvolve.cpp
index 384fa349f..a7375f1cb 100644
--- a/Source/Evolve/WarpXEvolve.cpp
+++ b/Source/Evolve/WarpXEvolve.cpp
@@ -10,6 +10,9 @@
  */
 #include "WarpX.H"
 
+#include "Initialization/ExternalField.H"
+#include "Evolve/JextStaggerOracle.H"
+
 #include "BoundaryConditions/PML.H"
 #include "Diagnostics/MultiDiagnostics.H"
 #include "Diagnostics/ReducedDiags/MultiReducedDiags.H"
@@ -49,6 +52,7 @@
 #include <AMReX_ParmParse.H>
 #include <AMReX_Print.H>
 #include <AMReX_REAL.H>
+#include <AMReX_Reduce.H>
 #include <AMReX_Utility.H>
 #include <AMReX_Vector.H>
 
@@ -743,6 +747,511 @@ void WarpX::OneStep (
  * i.e. all levels/patches use the same timestep (that of the finest level)
  * for the field advance and particle pusher.
  */
+
+void
+WarpX::AddExternalCurrent (amrex::Real time)
+{
+    if (!m_p_ext_field_params->J_ext_grid_enabled) { return; }
+
+#if defined(WARPX_DIM_RZ) || defined(WARPX_DIM_RCYLINDER) || defined(WARPX_DIM_RSPHERE)
+    amrex::ignore_unused(time);
+    WARPX_ABORT_WITH_MESSAGE(
+        "J_ext_grid_init_style is not supported in RZ "
+        "geometry; azimuthal-mode decomposition of an impressed current is not implemented");
+#else
+    using ablastr::fields::Direction;
+    using warpx::fields::FieldType;
+
+    // Ampere's law advances E with the total current:
+    // dE/dt = c^2 curl(B) - (J_plasma + J_ext)/epsilon_0.  Adding the
+    // impressed antenna current here lets Maxwell's equations generate the
+    // inductive E that performs work; a prescribed B-only particle field cannot.
+    // Evaluate J_ext at n+1/2 to match the leapfrog deposited-current time
+    // level. A discrete source-work ledger W_src = -integral(J_ext · E) dV dt
+    // is time-centered only if the grader supplies E at the matching midpoint
+    // (E-midpoint is grader-side, not assembled here); FieldEnergy at integer
+    // steps remains an O(dt) smoke proxy.
+    // Called from SyncCurrentAndRho AFTER filter+SumBoundary and BEFORE the
+    // single ApplyJfieldBoundary on the total current. Let S denote the
+    // particle-current filter plus SumBoundary and A the analytic source.
+    // We require S(Jp)+A, not S(Jp+A). Boundary treatment of Jp+J_ext is
+    // applied exactly once by the caller (double-apply is NOT idempotent).
+    //
+    // Coordinate convention mirrors ComputeExternalFieldOnGridUsingParser
+    // (WarpXInitData.cpp): parsers are always 4-arg (x,y,z,t);
+    //   WARPX_DIM_3D:     physical (x,y,z)
+    //   WARPX_DIM_XZ:     physical (x,z) with y = 0
+    //   WARPX_DIM_1D_Z:   physical z with x = y = 0
+    auto const dx = Geom(0).CellSizeArray();
+    const amrex::RealBox& real_box = Geom(0).ProbDomain();
+
+    for (int idim = 0; idim < 3; ++idim) {
+        amrex::MultiFab* current = m_fields.get(FieldType::current_fp, Direction{idim}, 0);
+        const amrex::IntVect nodal = current->ixType().toIntVect();
+        const auto component_parser = m_p_ext_field_params->Jfield_parser_executor[idim];
+
+        for (amrex::MFIter mfi(*current, amrex::TilingIfNotGPU()); mfi.isValid(); ++mfi) {
+            const amrex::Box box = mfi.tilebox(nodal);
+            auto const current_arr = current->array(mfi);
+            amrex::ParallelFor(box, [=] AMREX_GPU_DEVICE (int i, int j, int k) noexcept {
+#if defined(WARPX_DIM_1D_Z)
+                const amrex::Real x = 0._rt;
+                const amrex::Real y = 0._rt;
+                const amrex::Real fac_z = (1._rt - nodal[0]) * dx[0] * 0.5_rt;
+                const amrex::Real z = i * dx[0] + real_box.lo(0) + fac_z;
+#elif defined(WARPX_DIM_XZ)
+                const amrex::Real fac_x = (1._rt - nodal[0]) * dx[0] * 0.5_rt;
+                const amrex::Real x = i * dx[0] + real_box.lo(0) + fac_x;
+                const amrex::Real y = 0._rt;
+                const amrex::Real fac_z = (1._rt - nodal[1]) * dx[1] * 0.5_rt;
+                const amrex::Real z = j * dx[1] + real_box.lo(1) + fac_z;
+#else
+                const amrex::Real fac_x = (1._rt - nodal[0]) * dx[0] * 0.5_rt;
+                const amrex::Real x = i * dx[0] + real_box.lo(0) + fac_x;
+                const amrex::Real fac_y = (1._rt - nodal[1]) * dx[1] * 0.5_rt;
+                const amrex::Real y = j * dx[1] + real_box.lo(1) + fac_y;
+                const amrex::Real fac_z = (1._rt - nodal[2]) * dx[2] * 0.5_rt;
+                const amrex::Real z = k * dx[2] + real_box.lo(2) + fac_z;
+#endif
+                current_arr(i,j,k) += component_parser(x, y, z, time);
+            });
+        }
+        // AMReX nodal MultiFabs require OverrideSync on shared valid nodes
+        // (periodic endpoints can evaluate different coordinates).
+        current->FillBoundaryAndSync(Geom(0).periodicity());
+    }
+
+    // Optional analytic self-check (regression tests): with zero particles,
+    // current_fp must equal J_ext at every valid staggered cell to SP tolerance.
+    // SP float eps ~1e-7; use 50*eps * max(1,|J|) absolute tolerance for safe
+    // parser+arithmetic noise on unit-scale fields.
+    // Scope: enable only on periodic zero-Jp decks. This check runs before
+    // ApplyJfieldBoundary (caller applies BC once after we return).
+    //
+    // Reference positions: warpx::jext_oracle::position(comp, ...) uses
+    // hardcoded per-component half-offset tables transcribed from WarpX.cpp
+    // AllocLevelMFs (see JextStaggerOracle.H header). NOT live MultiFab
+    // ixType(), NOT an algebraic re-expression of the injection fac formula.
+    // Host assert_stagger_table_and_spot hard-checks the table; analytic
+    // multifab Jy=1.25 family also hard-asserts the baked amplitude.
+    if (m_p_ext_field_params->J_ext_self_check_analytic) {
+        constexpr amrex::Real sp_eps = 1.0e-7_rt;
+        constexpr amrex::Real tol_factor = 50.0_rt;
+        amrex::Real max_abs_err = 0._rt;
+        amrex::Real max_abs_ref = 0._rt;
+        amrex::GpuArray<amrex::Real, AMREX_SPACEDIM> lo_arr;
+        for (int idim = 0; idim < AMREX_SPACEDIM; ++idim) {
+            lo_arr[idim] = real_box.lo(idim);
+        }
+        // Hard assert independent stagger table (host, once).
+        warpx::jext_oracle::assert_stagger_table_and_spot(dx, lo_arr);
+
+        for (int idim = 0; idim < 3; ++idim) {
+            amrex::MultiFab* current = m_fields.get(FieldType::current_fp, Direction{idim}, 0);
+            const amrex::IntVect nodal = current->ixType().toIntVect();
+            const auto component_parser = m_p_ext_field_params->Jfield_parser_executor[idim];
+            const int comp = idim;
+            // Parser self-check uses an interior box that excludes the high
+            // nodal face on each periodic axis. Those faces are period-identified
+            // with the low face; OverrideSync forces them equal, so comparing
+            // each to its own (possibly disagreeing) parser coordinate is not
+            // a valid residual. The periodic-seam block below asserts lo/hi
+            // equality directly — that is the OverrideSync regression net.
+            const amrex::Box domain_comp = amrex::convert(Geom(0).Domain(), nodal);
+            const amrex::Periodicity& period_sc = Geom(0).periodicity();
+            for (amrex::MFIter mfi(*current, false); mfi.isValid(); ++mfi) {
+                const amrex::Box nbox = amrex::convert(mfi.validbox(), nodal);
+                amrex::Box check_box = nbox;
+                for (int d = 0; d < AMREX_SPACEDIM; ++d) {
+                    if (period_sc.isPeriodic(d) && nodal[d] == 1 &&
+                        check_box.bigEnd(d) == domain_comp.bigEnd(d)) {
+                        check_box.setBig(d, domain_comp.bigEnd(d) - 1);
+                    }
+                }
+                if (check_box.isEmpty()) { continue; }
+                auto const current_arr = current->const_array(mfi);
+
+                amrex::ReduceOps<amrex::ReduceOpMax> reduce_op_err;
+                amrex::ReduceData<amrex::Real> reduce_data_err(reduce_op_err);
+                using ReduceTuple = typename decltype(reduce_data_err)::Type;
+                reduce_op_err.eval(check_box, reduce_data_err,
+                    [=] AMREX_GPU_DEVICE (int i, int j, int k) -> ReduceTuple {
+                        const auto pos = warpx::jext_oracle::position(comp, dx, lo_arr, i, j, k);
+                        const amrex::Real ref = component_parser(pos[0], pos[1], pos[2], time);
+                        return {amrex::Math::abs(current_arr(i,j,k) - ref)};
+                    });
+                const amrex::Real fab_err = amrex::get<0>(reduce_data_err.value());
+
+                amrex::ReduceOps<amrex::ReduceOpMax> reduce_op_ref;
+                amrex::ReduceData<amrex::Real> reduce_data_ref(reduce_op_ref);
+                reduce_op_ref.eval(check_box, reduce_data_ref,
+                    [=] AMREX_GPU_DEVICE (int i, int j, int k) -> ReduceTuple {
+                        const auto pos = warpx::jext_oracle::position(comp, dx, lo_arr, i, j, k);
+                        return {amrex::Math::abs(component_parser(pos[0], pos[1], pos[2], time))};
+                    });
+                const amrex::Real fab_ref = amrex::get<0>(reduce_data_ref.value());
+                max_abs_err = amrex::max(max_abs_err, fab_err);
+                max_abs_ref = amrex::max(max_abs_ref, fab_ref);
+            }
+
+            // Direct periodic-seam value assertion.
+            // After FillBoundaryAndSync, opposite nodal endpoints of a
+            // periodic domain are the same physical node and must match.
+            // Parser-vs-stored at each endpoint is NOT enough: without
+            // OverrideSync both ends can still match their own parser value.
+            // Implementation uses ReduceOps so the comparison is GPU-safe.
+            // Requires a box that spans both domain endpoints (single-box
+            // decks such as periodic_seam_3d with max_grid_size >= n_cell).
+            {
+                const amrex::Periodicity& period = Geom(0).periodicity();
+                amrex::Real max_seam = 0._rt;
+                const amrex::Box domain = amrex::convert(Geom(0).Domain(), nodal);
+                for (int dir = 0; dir < AMREX_SPACEDIM; ++dir) {
+                    if (!period.isPeriodic(dir)) { continue; }
+                    if (nodal[dir] == 0) { continue; } // cell-centered: no shared node
+                    const int dlo = domain.smallEnd(dir);
+                    const int dhi = domain.bigEnd(dir);
+                    amrex::ReduceOps<amrex::ReduceOpMax> reduce_op_seam;
+                    amrex::ReduceData<amrex::Real> reduce_data_seam(reduce_op_seam);
+                    using SeamTuple = typename decltype(reduce_data_seam)::Type;
+                    bool any_span = false;
+                    for (amrex::MFIter mfi(*current, false); mfi.isValid(); ++mfi) {
+                        const amrex::Box nbox = amrex::convert(mfi.validbox(), nodal);
+                        if (nbox.smallEnd(dir) > dlo || nbox.bigEnd(dir) < dhi) {
+                            continue; // this box does not span both endpoints
+                        }
+                        any_span = true;
+                        amrex::Box face = nbox;
+                        face.setRange(dir, dlo, dlo);
+                        auto const arr = current->const_array(mfi);
+                        reduce_op_seam.eval(face, reduce_data_seam,
+                            [=] AMREX_GPU_DEVICE (int i, int j, int k) -> SeamTuple {
+#if (AMREX_SPACEDIM == 1)
+                                amrex::ignore_unused(j, k);
+#elif (AMREX_SPACEDIM == 2)
+                                amrex::ignore_unused(k);
+#endif
+                                amrex::IntVect iv(AMREX_D_DECL(i, j, k));
+                                amrex::IntVect iv_hi = iv;
+                                iv_hi[dir] = dhi;
+                                return {amrex::Math::abs(arr(iv) - arr(iv_hi))};
+                            });
+                    }
+                    if (any_span) {
+                        max_seam = amrex::max(
+                            max_seam, amrex::get<0>(reduce_data_seam.value()));
+                    }
+                }
+                amrex::ParallelDescriptor::ReduceRealMax(max_seam);
+                amrex::Print() << "J_ext periodic-seam: comp=" << idim
+                               << " max_lo_hi_diff=" << max_seam << "\n";
+                // SP float headroom. Broken OverrideSync leaves O(1) mismatch
+                // for a non-even function of the periodic coordinate.
+                constexpr amrex::Real seam_tol = 1.0e-5_rt;
+                if (max_seam > seam_tol) {
+                    std::stringstream ss;
+                    ss << "J_ext periodic-seam assert failed: comp=" << idim
+                       << " max_lo_hi_diff=" << max_seam << " > " << seam_tol
+                       << " (FillBoundaryAndSync / OverrideSync regression?)";
+                    WARPX_ABORT_WITH_MESSAGE(ss.str());
+                }
+            }
+        } // for idim components
+        amrex::ParallelDescriptor::ReduceRealMax(max_abs_err);
+        amrex::ParallelDescriptor::ReduceRealMax(max_abs_ref);
+        const amrex::Real tol = tol_factor * sp_eps * amrex::max(1.0_rt, max_abs_ref);
+        amrex::Print() << "J_ext analytic self-check: max_abs_err=" << max_abs_err
+                       << " max_abs_ref=" << max_abs_ref
+                       << " tol=" << tol
+                       << " oracle=JextStaggerOracle\n";
+        if (max_abs_err > tol) {
+            std::stringstream ss;
+            ss << "J_ext analytic self-check failed: max_abs_err=" << max_abs_err
+               << " > tol=" << tol;
+            WARPX_ABORT_WITH_MESSAGE(ss.str());
+        }
+        // Hard assert baked amplitude for the constant-Jy=1.25 analytic family.
+        // (Solenoidal decks have max|J|~1 or 1.5 and must not false-trip.)
+        if (amrex::Math::abs(max_abs_ref - warpx::jext_oracle::kAnalyticJy) < 1.0e-3_rt) {
+            WARPX_ALWAYS_ASSERT_WITH_MESSAGE(
+                amrex::Math::abs(max_abs_ref - warpx::jext_oracle::kAnalyticJy)
+                    < 1.0e-3_rt,
+                "J_ext oracle baked-Jy hard assert failed");
+            amrex::Print() << "J_ext oracle spot-check ASSERT: max_abs_ref="
+                           << max_abs_ref
+                           << " matches baked_Jy="
+                           << warpx::jext_oracle::kAnalyticJy << "\n";
+        }
+    }
+
+    // Boundary treatment is applied ONCE by SyncCurrentAndRho after this
+    // returns -- do NOT re-ApplyJfieldBoundary here (operator is not idempotent).
+
+    // Runtime discrete-divergence gate (default every 100 steps; 0 disables).
+    const int interval = m_p_ext_field_params->J_ext_div_check_interval;
+    const int step = istep[0];
+    if (interval > 0 && (step == 0 || (step % interval) == 0)) {
+        CheckExternalCurrentDivergence(time);
+    }
+#endif
+}
+
+void
+WarpX::CheckExternalCurrentDivergence (amrex::Real time)
+{
+    if (!m_p_ext_field_params->J_ext_grid_enabled) { return; }
+
+#if defined(WARPX_DIM_RZ) || defined(WARPX_DIM_RCYLINDER) || defined(WARPX_DIM_RSPHERE)
+    amrex::ignore_unused(time);
+    return;
+#else
+    using ablastr::fields::Direction;
+    using warpx::fields::FieldType;
+
+    // Discrete Yee-adjoint divergence of the impressed current, collocated
+    // with WarpX nodal rho (charge-continuity points).
+    //
+    // =====================================================================
+    // Premise
+    //   Continuous Maxwell continuity with no rho_ext requires div J_ext = 0.
+    //   On WarpX's staggered Yee mesh, current_fp lives on the same edges as E
+    //   (J matches E nodal flags), and rho is fully nodal. The discrete
+    //   adjoint of the Yee curl that appears in the continuity residual is
+    //   therefore the nodal finite-volume divergence of those edge currents:
+    //     (div_h J)_node = sum_a ( J_a |_{face right of node} - J_a |_{face left} ) / da
+    //   with each J_a sampled at the SAME staggered positions the injection
+    //   path writes into current_fp (live MultiFab ixType -- never hardcoded).
+    //
+    //   WarpX staggered current_fp ixType (WarpX.cpp AllocLevelMFs), for reference:
+    //     1D_Z:  Jx NODE, Jy NODE, Jz CELL          -- reduced div uses only Jz
+    //     XZ:    Jx (0,1), Jy (1,1), Jz (1,0)      -- reduced div uses Jx,Jz
+    //     3D:    Jx (0,1,1), Jy (1,0,1), Jz (1,1,0) -- full div
+    //   (Earlier gate code inverted these flags; that dual-lattice sampling is gone.)
+    //
+    // Algebra
+    //   AMReX cell-centered index i on axis a places the face value at
+    //   lo_a + (i + 1/2) da, which is the face BETWEEN nodal indices i and i+1.
+    //   At nodal index i:
+    //     D_a J_a = ( J_a(i) - J_a(i-1) ) / da
+    //   with transverse indices taken on the component's own nodal/cell flags.
+    //   Dimensionless residual:
+    //     r = |div_h J| * h_min / max(J_max, J_floor)
+    //
+    // Units
+    //   [div_h J] = A/m^3 = [J]/[length]; r is dimensionless.
+    //
+    // Case split / limiting cases (binds rel_tol)
+    //   (a) Discrete-solenoidal sources: J obtained from a matching discrete
+    //       curl_h(M) on the same Yee edges, OR any linear field whose
+    //       continuum div is 0 and whose staggered samples make the FD exact
+    //       (e.g. J=(-y,x,0) in 3D). Then each D_a J_a cancels in exact
+    //       arithmetic and the residual is pure SP roundoff:
+    //         r ≲ C * eps_SP * growth,  eps_SP ~ 1e-7, C·growth ≲ 1e2
+    //       => r ≲ ~1e-5.  rel_tol_discrete = 1e-4 leaves ~10x headroom.
+    //   (b) Continuum-curl sources sampled onto Yee edges (parser emits the
+    //       continuous curl at edge centers, not a discrete curl_h).
+    //       Half-offset centred difference:
+    //         [f(x+h/2)-f(x-h/2)]/h = f'(x) + (h^2/24)*f_xxx(x) + O(h^4).
+    //       For continuum-solenoidal J, div_h J = (h^2/24) sum_a d3_a J_a
+    //         = O(h^2 k^3 |J|). With r = |div_h J|*h/|J| this is
+    //         r ~ O((k h)^3), NOT O((kh)^2).
+    //       Setting (kh)^3/24 <= 1e-4 gives k h <= 0.13, i.e. about 47 cells
+    //       per wavelength (not 600). Decks with coarser continuum curl must
+    //       either emit discrete curl_h components or refine the mesh.
+    //       Lowering J_ext_div_check_interval is NOT a fix for (b).
+    //       Do not loosen rel_tol for (a).
+    //       Anisotropic grids: h_min under-weights the coarse-axis terms and
+    //       loosens the gate by ~h_min/h_max; prefer near-isotropic cells.
+    //
+    // Sampling guarantee (not fail-closed over all of space-time)
+    //   - First enabled step (step == 0): dense stride-1 over every nodal
+    //     residual index of the level-0 domain, including the top boundary
+    //     node (loop to hi_node = hi+1).
+    //   - Later interval checks: coarse stride S=8 with INDEPENDENT per-axis
+    //     phases phase_a = ((step/interval) / S^a) % S so the walk covers the
+    //     full S^d Cartesian product of sublattices over S^d firings (not just
+    //     the 8 diagonal sublattices of a shared scalar phase).
+    //   - Dense pass is host-side and currently replicated per rank; fine for
+    //     test grids, costly at production resolution (see OPEN-ISSUES).
+    //   - Restart from a checkpoint with step>0 skips the dense pass.
+    // =====================================================================
+    constexpr amrex::Real rel_tol = 1.0e-4_rt; // case (a) discrete-solenoidal
+    // Absolute floor on the div-entering |J| denominator. Prefer
+    // max(J_div, 1e-12*J_all) when only a subset of components enter the
+    // reduced div (e.g. 2D Jy-only analytic decks).
+    constexpr amrex::Real J_floor = 1.0e-30_rt;
+    // Inversion sensitivity band (r_inverted ~ (kh)^2 vs fixed rel_tol=1e-4):
+    // discriminating for ~47 ≲ N_cells/λ ≲ ~628; above ~628 a pure dual-
+    // lattice inversion slips under the gate. Case (b) continuum-curl needs
+    // N ≳ 47 (kh ≲ 0.13).
+    constexpr int coarse_stride = 8;
+
+    auto const dx = Geom(0).CellSizeArray();
+    const amrex::RealBox& real_box = Geom(0).ProbDomain();
+    const auto jx_parser = m_p_ext_field_params->Jfield_parser_executor[0];
+    const auto jy_parser = m_p_ext_field_params->Jfield_parser_executor[1];
+    const auto jz_parser = m_p_ext_field_params->Jfield_parser_executor[2];
+
+    // Live nodal flags from the MultiFabs that receive the injection (same as
+    // AddExternalCurrent). Do not hardcode -- staggered Yee flags differ by dim.
+    const amrex::IntVect n_jx = m_fields.get(FieldType::current_fp, Direction{0}, 0)->ixType().toIntVect();
+    const amrex::IntVect n_jy = m_fields.get(FieldType::current_fp, Direction{1}, 0)->ixType().toIntVect();
+    const amrex::IntVect n_jz = m_fields.get(FieldType::current_fp, Direction{2}, 0)->ixType().toIntVect();
+
+#if defined(WARPX_DIM_1D_Z)
+    const amrex::Real h_min = dx[0];
+#elif defined(WARPX_DIM_XZ)
+    const amrex::Real h_min = amrex::min(dx[0], dx[1]);
+#else
+    const amrex::Real h_min = amrex::min(dx[0], amrex::min(dx[1], dx[2]));
+#endif
+
+    // Physical position of MultiFab index (i,j,k) for a component with the
+    // given nodal IntVect -- byte-matches the injection fac convention.
+    auto pos_of = [&](const amrex::IntVect& nodal, int i, int j, int k) {
+#if defined(WARPX_DIM_1D_Z)
+        amrex::ignore_unused(j, k);
+        const amrex::Real x = 0._rt;
+        const amrex::Real y = 0._rt;
+        const amrex::Real z = static_cast<amrex::Real>(i) * dx[0] + real_box.lo(0)
+            + (1._rt - nodal[0]) * dx[0] * 0.5_rt;
+        return std::array<amrex::Real,3>{x, y, z};
+#elif defined(WARPX_DIM_XZ)
+        amrex::ignore_unused(k);
+        const amrex::Real x = static_cast<amrex::Real>(i) * dx[0] + real_box.lo(0)
+            + (1._rt - nodal[0]) * dx[0] * 0.5_rt;
+        const amrex::Real y = 0._rt;
+        const amrex::Real z = static_cast<amrex::Real>(j) * dx[1] + real_box.lo(1)
+            + (1._rt - nodal[1]) * dx[1] * 0.5_rt;
+        return std::array<amrex::Real,3>{x, y, z};
+#else
+        const amrex::Real x = static_cast<amrex::Real>(i) * dx[0] + real_box.lo(0)
+            + (1._rt - nodal[0]) * dx[0] * 0.5_rt;
+        const amrex::Real y = static_cast<amrex::Real>(j) * dx[1] + real_box.lo(1)
+            + (1._rt - nodal[1]) * dx[1] * 0.5_rt;
+        const amrex::Real z = static_cast<amrex::Real>(k) * dx[2] + real_box.lo(2)
+            + (1._rt - nodal[2]) * dx[2] * 0.5_rt;
+        return std::array<amrex::Real,3>{x, y, z};
+#endif
+    };
+
+    const int step = istep[0];
+    const int interval = m_p_ext_field_params->J_ext_div_check_interval;
+    // Dense on first enabled step; coarse + independent per-axis phases after.
+    const int stride = (step == 0) ? 1 : coarse_stride;
+    const int tick = (step == 0 || interval <= 0) ? 0 : (step / interval);
+    // phase_a = (tick / S^a) % S  -- covers S^d sublattices over S^d firings.
+    const int phase0 = tick % coarse_stride;
+    const int phase1 = (tick / coarse_stride) % coarse_stride;
+    const int phase2 = (tick / (coarse_stride * coarse_stride)) % coarse_stride;
+
+    const amrex::Box domain = Geom(0).Domain();
+    const auto lo = domain.smallEnd();
+    const auto hi = domain.bigEnd();
+    // Include the top nodal boundary node (hi+1). Under periodicity this is
+    // the image of lo; still evaluate so the dense-pass claim is literal.
+    const amrex::IntVect hi_node = hi + amrex::IntVect::TheUnitVector();
+
+    amrex::Real max_abs_div = 0._rt;
+    amrex::Real max_abs_J = 0._rt; // only components that enter reduced div
+
+    // Host-side sample over nodal residuals. Parser eval at MultiFab indices
+    // (including i-1 when i==lo) is continuum-well-defined even outside the
+    // valid index box; periodic antennas must be parser-periodic themselves.
+#if defined(WARPX_DIM_1D_Z)
+    // Reduced div: only Jz (CELL on axis 0). Denom uses only Jz.
+    amrex::ignore_unused(jx_parser, jy_parser, n_jx, n_jy, phase1, phase2);
+    for (int i = lo[0] + phase0; i <= hi_node[0]; i += stride) {
+        auto p_r = pos_of(n_jz, i,     0, 0);
+        auto p_l = pos_of(n_jz, i - 1, 0, 0);
+        const amrex::Real Jz_r = jz_parser(p_r[0], p_r[1], p_r[2], time);
+        const amrex::Real Jz_l = jz_parser(p_l[0], p_l[1], p_l[2], time);
+        const amrex::Real divh = (Jz_r - Jz_l) / dx[0];
+        max_abs_div = amrex::max(max_abs_div, std::abs(divh));
+        max_abs_J = amrex::max(max_abs_J, std::abs(Jz_r));
+        max_abs_J = amrex::max(max_abs_J, std::abs(Jz_l));
+    }
+#elif defined(WARPX_DIM_XZ)
+    // Reduced planar div: Jx + Jz. Jy does not enter -- exclude from denom.
+    amrex::ignore_unused(jy_parser, n_jy, phase2);
+    for (int j = lo[1] + phase1; j <= hi_node[1]; j += stride) {
+        for (int i = lo[0] + phase0; i <= hi_node[0]; i += stride) {
+            auto px_r = pos_of(n_jx, i,     j, 0);
+            auto px_l = pos_of(n_jx, i - 1, j, 0);
+            auto pz_r = pos_of(n_jz, i, j,     0);
+            auto pz_l = pos_of(n_jz, i, j - 1, 0);
+            const amrex::Real Jx_r = jx_parser(px_r[0], px_r[1], px_r[2], time);
+            const amrex::Real Jx_l = jx_parser(px_l[0], px_l[1], px_l[2], time);
+            const amrex::Real Jz_r = jz_parser(pz_r[0], pz_r[1], pz_r[2], time);
+            const amrex::Real Jz_l = jz_parser(pz_l[0], pz_l[1], pz_l[2], time);
+            const amrex::Real divh = (Jx_r - Jx_l) / dx[0] + (Jz_r - Jz_l) / dx[1];
+            max_abs_div = amrex::max(max_abs_div, std::abs(divh));
+            max_abs_J = amrex::max(max_abs_J, std::abs(Jx_r));
+            max_abs_J = amrex::max(max_abs_J, std::abs(Jx_l));
+            max_abs_J = amrex::max(max_abs_J, std::abs(Jz_r));
+            max_abs_J = amrex::max(max_abs_J, std::abs(Jz_l));
+        }
+    }
+#else
+    // Full 3D nodal div of edge currents. All three components enter denom.
+    for (int k = lo[2] + phase2; k <= hi_node[2]; k += stride) {
+        for (int j = lo[1] + phase1; j <= hi_node[1]; j += stride) {
+            for (int i = lo[0] + phase0; i <= hi_node[0]; i += stride) {
+                auto px_r = pos_of(n_jx, i,     j, k);
+                auto px_l = pos_of(n_jx, i - 1, j, k);
+                auto py_r = pos_of(n_jy, i, j,     k);
+                auto py_l = pos_of(n_jy, i, j - 1, k);
+                auto pz_r = pos_of(n_jz, i, j, k    );
+                auto pz_l = pos_of(n_jz, i, j, k - 1);
+                const amrex::Real Jx_r = jx_parser(px_r[0], px_r[1], px_r[2], time);
+                const amrex::Real Jx_l = jx_parser(px_l[0], px_l[1], px_l[2], time);
+                const amrex::Real Jy_r = jy_parser(py_r[0], py_r[1], py_r[2], time);
+                const amrex::Real Jy_l = jy_parser(py_l[0], py_l[1], py_l[2], time);
+                const amrex::Real Jz_r = jz_parser(pz_r[0], pz_r[1], pz_r[2], time);
+                const amrex::Real Jz_l = jz_parser(pz_l[0], pz_l[1], pz_l[2], time);
+                const amrex::Real divh =
+                    (Jx_r - Jx_l) / dx[0] + (Jy_r - Jy_l) / dx[1] + (Jz_r - Jz_l) / dx[2];
+                max_abs_div = amrex::max(max_abs_div, std::abs(divh));
+                max_abs_J = amrex::max(max_abs_J, std::abs(Jx_r));
+                max_abs_J = amrex::max(max_abs_J, std::abs(Jx_l));
+                max_abs_J = amrex::max(max_abs_J, std::abs(Jy_r));
+                max_abs_J = amrex::max(max_abs_J, std::abs(Jy_l));
+                max_abs_J = amrex::max(max_abs_J, std::abs(Jz_r));
+                max_abs_J = amrex::max(max_abs_J, std::abs(Jz_l));
+            }
+        }
+    }
+#endif
+
+    amrex::ParallelDescriptor::ReduceRealMax(max_abs_div);
+    amrex::ParallelDescriptor::ReduceRealMax(max_abs_J);
+
+    const amrex::Real denom = amrex::max(max_abs_J, J_floor);
+    const amrex::Real rel = max_abs_div * h_min / denom;
+    amrex::Print() << "J_ext div-gate: max|div_h J_ext|=" << max_abs_div
+                   << " max|J_ext|=" << max_abs_J
+                   << " h_min=" << h_min
+                   << " r=|div|*h/|J|=" << rel
+                   << " rel_tol=" << rel_tol
+                   << " stride=" << stride
+                   << " phase=(" << phase0 << "," << phase1 << "," << phase2 << ")"
+                   << "\n";
+    if (rel > rel_tol) {
+        std::stringstream ss;
+        ss << "warpx.J_ext_grid_init_style discrete div(J_ext) check failed: "
+           << "max|div_h J_ext|=" << max_abs_div
+           << " max|J_ext|=" << max_abs_J
+           << " h_min=" << h_min
+           << " relative residual r=|div|*h/|J|=" << rel
+           << " exceeds rel_tol=" << rel_tol
+           << " (deck contract: J_ext must be discrete-solenoidal on the Yee "
+           << "edge stencil, case (a); continuum-curl sources need k_max*h <= 0.13 "
+           << "(~47 cells/wavelength, r~O((kh)^3)) or must emit discrete curl_h)";
+        WARPX_ABORT_WITH_MESSAGE(ss.str());
+    }
+#endif
+}
